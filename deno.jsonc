{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "fmt": {
    "options": {
      "lineWidth": 1000 // I hate line wrapping
    }
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@binary-parser": "npm:binary-parser@2.3.0"
  },
  "tasks": {
    "asset": "mkdir -p /tmp/bokmagic && deno run --allow-read --allow-write https://akatsuki105.github.io/bokmagic-web/bokmagic.js baserom.gba"
  }
}
