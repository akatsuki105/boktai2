String_1055:: @ 0x08CFCA4D, ID: 4181
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「そうこのカギは、\nぜんぶで3つなんだって。$"
String_1056:: @ 0x08CFCA95, ID: 4182
