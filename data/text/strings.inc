String_1058:: @ 0x08CFCAD4, ID: 4184
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「そうこのカギは、\nぜんぶで3つなんだって。$"
String_1059:: @ 0x08CFCB1C, ID: 4185
