String_1038:: @ 0x08CFC62A, ID: 4152
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「チョコレ―トおいしかった?$"
String_1039:: @ 0x08CFC663, ID: 4153
  .string "クロちゃんはあんまりすきじゃ\nないんだって。$"
String_103A:: @ 0x08CFC68F, ID: 4154
  .string "スミレはクロちゃんのおかあさ\nんなのよ。クロちゃんはとって\nもくろくてかわいいの」$"
String_103B:: @ 0x08CFC6E0, ID: 4155
  .string "<PROC=0>\n<END>$"
String_103C:: @ 0x08CFC6EF, ID: 4156
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「クロちゃんったらねてばっか\nりなのよ。ぷ―だっ!!」$"
String_103D:: @ 0x08CFC740, ID: 4157
  .string "<PROC=0>\n<END>$"
String_103E:: @ 0x08CFC74F, ID: 4158
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「アイテムはいっぱいもったら\nダメなの。$"
String_103F:: @ 0x08CFC794, ID: 4159
  .string "バッグにあきがないと、あたら\nしいアイテムがもてないのよ」$"
String_1040:: @ 0x08CFC7CE, ID: 4160
  .string "<PROC=0>\n<END>$"
String_1041:: @ 0x08CFC7DD, ID: 4161
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「クロちゃんったらまたどっか\nいっちゃった。ぷ―だっ!!」$"
String_1042:: @ 0x08CFC832, ID: 4162
  .string "<PROC=0>\n<END>$"
String_1043:: @ 0x08CFC841, ID: 4163
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「そうこにあずけたアイテムは\nくさらないの。$"
String_1044:: @ 0x08CFC88A, ID: 4164
