String_010B:: @ 0x08CD3BFC, ID: 267
  .string "<PROC=0>\n<END>$"
String_010C:: @ 0x08CD3C0B, ID: 268
  .string "暗黒ロ―ンの暗子ちゃん\n「はい、けっこうです!$"
String_010D:: @ 0x08CD3C38, ID: 269
