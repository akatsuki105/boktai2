String_102F:: @ 0x08CFC4E7, ID: 4143
  .string "<MOJISE=MOJISE_SYSTEM>「倉庫のカギ」を渡した!$"
String_1030:: @ 0x08CFC515, ID: 4144
  .string "<PROC=0>\n<END>$"
String_1031:: @ 0x08CFC524, ID: 4145
