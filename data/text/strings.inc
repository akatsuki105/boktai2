String_10E4:: @ 0x08CFE364, ID: 4324
  .string "<PROC=0>\n<END>$"
String_10E5:: @ 0x08CFE373, ID: 4325
  .string "「吊るされた男のカ―ド」\nを手に入れた!!$"
String_10E6:: @ 0x08CFE39B, ID: 4326
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10E7:: @ 0x08CFE3C8, ID: 4327
  .string "<PROC=0>\n<END>$"
String_10E8:: @ 0x08CFE3D7, ID: 4328
  .string "「死神のカ―ド」\nを手に入れた!!$"
String_10E9:: @ 0x08CFE3F7, ID: 4329
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10EA:: @ 0x08CFE424, ID: 4330
  .string "<PROC=0>\n<END>$"
String_10EB:: @ 0x08CFE433, ID: 4331
  .string "「節制のカ―ド」\nを手に入れた!!$"
String_10EC:: @ 0x08CFE453, ID: 4332
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10ED:: @ 0x08CFE480, ID: 4333
  .string "<PROC=0>\n<END>$"
String_10EE:: @ 0x08CFE48F, ID: 4334
  .string "「悪魔のカ―ド」\nを手に入れた!!$"
String_10EF:: @ 0x08CFE4AF, ID: 4335
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10F0:: @ 0x08CFE4DC, ID: 4336
  .string "<PROC=0>\n<END>$"
String_10F1:: @ 0x08CFE4EB, ID: 4337
  .string "「塔のカ―ド」\nを手に入れた!!$"
String_10F2:: @ 0x08CFE509, ID: 4338
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10F3:: @ 0x08CFE536, ID: 4339
  .string "<PROC=0>\n<END>$"
String_10F4:: @ 0x08CFE545, ID: 4340
  .string "「星のカ―ド」\nを手に入れた!!$"
String_10F5:: @ 0x08CFE563, ID: 4341
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10F6:: @ 0x08CFE590, ID: 4342
  .string "<PROC=0>\n<END>$"
String_10F7:: @ 0x08CFE59F, ID: 4343
  .string "「月のカ―ド」\nを手に入れた!!$"
String_10F8:: @ 0x08CFE5BD, ID: 4344
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10F9:: @ 0x08CFE5EA, ID: 4345
  .string "<PROC=0>\n<END>$"
String_10FA:: @ 0x08CFE5F9, ID: 4346
  .string "「太陽のカ―ド」\nを手に入れた!!$"
String_10FB:: @ 0x08CFE619, ID: 4347
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10FC:: @ 0x08CFE646, ID: 4348
  .string "<PROC=0>\n<END>$"
String_10FD:: @ 0x08CFE655, ID: 4349
  .string "「審判のカ―ド」\nを手に入れた!!$"
String_10FE:: @ 0x08CFE675, ID: 4350
  .string "残りの対戦ポイントは、\n<VAR=3>ポイントです。$"
String_10FF:: @ 0x08CFE6A2, ID: 4351
  .string "<PROC=0>\n<END>$"
String_1100:: @ 0x08CFE6B1, ID: 4352
  .string "<MOJISE=MOJISE_SYSTEM>魔法カ―ドと交換(こうかん)す\nるには、あと<VAR=4>ポイント必要\nです。$"
String_1101:: @ 0x08CFE70B, ID: 4353
  .string "<PROC=0>\n<END>$"
String_1102:: @ 0x08CFE71A, ID: 4354
  .string "<MOJISE=MOJISE_SYSTEM>バッグがいっぱいです。\nアイテムを減らしてください。$"
String_1103:: @ 0x08CFE764, ID: 4355
  .string "<PROC=0>\n<END>$"
String_1104:: @ 0x08CFE773, ID: 4356
  .string "<END>$"
String_1105:: @ 0x08CFE779, ID: 4357
  .string "<LABEL=SMITH>スミス</LABEL>\n「パネルの説明は読んだか?」$"
String_1106:: @ 0x08CFE7B1, ID: 4358
  .string "<PROC=0>\n<END>$"
String_1107:: @ 0x08CFE7C0, ID: 4359
  .string "<LABEL=SMITH>スミス</LABEL>\n「鍛冶(かじ)をするか?」\n <ALTER>鍛冶をする</ALTER>　<ALTER>話をする</ALTER>$"
String_1108:: @ 0x08CFE828, ID: 4360
  .string "<END>$"
String_1109:: @ 0x08CFE82E, ID: 4361
  .string "<LABEL=SMITH>スミス</LABEL>\n「むう・・・\nいまいちな出来じゃな。$"
String_110A:: @ 0x08CFE86E, ID: 4362
  .string "グレ―トが<VAR=1>回、\nグッドが<VAR=2>回、\nバッドが<VAR=3>回か。$"
String_110B:: @ 0x08CFE8AE, ID: 4363
  .string "鍛冶に大切なのは、温度のコン\nトロ―ルと打ち鍛(きた)えるタ\nイミングじゃ。$"
String_110C:: @ 0x08CFE8F7, ID: 4364
  .string "なに、数をこなせば自然と上達\nするわい」$"
String_110D:: @ 0x08CFE91F, ID: 4365
  .string "<PROC=0>\n<END>$"
String_110E:: @ 0x08CFE92E, ID: 4366
  .string "<LABEL=SMITH>スミス</LABEL>\n「ふう・・・\nまずまずじゃな。$"
String_110F:: @ 0x08CFE968, ID: 4367
  .string "グレ―トが<VAR=1>回、\nグッドが<VAR=2>回、\nバッドが<VAR=3>回か。$"
String_1110:: @ 0x08CFE9A8, ID: 4368
  .string "鍛冶の才能もあるんじゃないか\n<NAME>?」$"
String_1111:: @ 0x08CFE9CF, ID: 4369
  .string "<PROC=0>\n<END>$"
String_1112:: @ 0x08CFE9DE, ID: 4370
  .string "<LABEL=SMITH>スミス</LABEL>\n「ほう・・・\nいい出来じゃな!!$"
String_1113:: @ 0x08CFEA18, ID: 4371
  .string "グレ―トが<VAR=1>回、\nグッドが<VAR=2>回、\nバッドが<VAR=3>回か。$"
String_1114:: @ 0x08CFEA58, ID: 4372
  .string "その武器、役立ててくれよ?」$"
String_1115:: @ 0x08CFEA74, ID: 4373
  .string "<PROC=0>\n<END>$"
String_1116:: @ 0x08CFEA83, ID: 4374
  .string "<LABEL=SMITH>スミス</LABEL>\n「おお・・・\nすばらしい出来映えじゃな!$"
String_1117:: @ 0x08CFEAC6, ID: 4375
  .string "グレ―トが<VAR=1>回、\nグッドが<VAR=2>回、\nバッドが<VAR=3>回か。$"
String_1118:: @ 0x08CFEB06, ID: 4376
  .string "さすがは<NAME>!!」$"
String_1119:: @ 0x08CFEB19, ID: 4377
  .string "<PROC=0>\n<END>$"
String_111A:: @ 0x08CFEB28, ID: 4378
  .string "<LABEL=SMITH>スミス</LABEL>\n「なんと・・・\nめずらしい武器じゃな!?$"
String_111B:: @ 0x08CFEB6A, ID: 4379
  .string "グレ―トが<VAR=1>回、\nグッドが<VAR=2>回、\nバッドが<VAR=3>回か。$"
String_111C:: @ 0x08CFEBAA, ID: 4380
  .string "その武器はRランク、レアじゃ\nレベル以上の能力を秘めておる\nぞ」$"
String_111D:: @ 0x08CFEBE8, ID: 4381
  .string "<PROC=0>\n<END>$"
String_111E:: @ 0x08CFEBF7, ID: 4382
  .string "<LABEL=SMITH>スミス</LABEL>\n「おお・・・\nすばらしい出来映えじゃな!$"
String_111F:: @ 0x08CFEC3A, ID: 4383
  .string "武器を叩(たた)くタイミングも\nばっちりじゃったぞ。$"
String_1120:: @ 0x08CFEC6C, ID: 4384
  .string "グレ―トを<VAR=1>回も出すとは!?$"
String_1121:: @ 0x08CFEC8C, ID: 4385
  .string "記念だ、これを持って行け!!」$"
String_1122:: @ 0x08CFECA9, ID: 4386
  .string "<PROC=0>\n<END>$"
String_1123:: @ 0x08CFECB8, ID: 4387
  .string "<LABEL=SMITH>スミス</LABEL>\n「わしはすでに戦いを退いた身\n・・・$"
String_1124:: @ 0x08CFECF8, ID: 4388
  .string "右目をやられては銃(じゅう)も\nあつかえん。今はおまえだけが\n頼(たよ)りじゃ。$"
String_1125:: @ 0x08CFED43, ID: 4389
  .string "頼(たの)んだぞ、\n太陽少年<NAME>!!」$"
String_1126:: @ 0x08CFED67, ID: 4390
  .string "<PROC=0>\n<END>$"
String_1127:: @ 0x08CFED76, ID: 4391
  .string "<LABEL=SMITH>スミス</LABEL>\n「<NAME>、$"
String_1128:: @ 0x08CFED9D, ID: 4392
  .string "早くイモ―タルを浄化(じょう\nか)するんじゃ!!」$"
String_1129:: @ 0x08CFEDCB, ID: 4393
  .string "<PROC=0>\n<END>$"
String_112A:: @ 0x08CFEDDA, ID: 4394
  .string "<LABEL=SMITH>スミス</LABEL>\n「来たな。$"
String_112B:: @ 0x08CFEE01, ID: 4395
  .string "太陽鍛冶(たいようかじ)につい\nての説明は、そこのパネルに書\nいてある。$"
String_112C:: @ 0x08CFEE46, ID: 4396
  .string "鍛冶を始める前に1度は読んで\nおいてくれ」$"
String_112D:: @ 0x08CFEE6F, ID: 4397
  .string "<PROC=0>\n<END>$"
String_112E:: @ 0x08CFEE7E, ID: 4398
  .string "<LABEL=SMITH>スミス</LABEL>\n「東に探索(たんさく)に出たシ\nャイアンが、まだ戻(もど)らん$"
String_112F:: @ 0x08CFEED4, ID: 4399
  .string "あいつの身に何か・・・?$"
String_1130:: @ 0x08CFEEEC, ID: 4400
  .string "いや、それはあるまい・・・\nシャイアンは守人、風の戦士。$"
String_1131:: @ 0x08CFEF24, ID: 4401
  .string "きっと何かを見つけたに違(ち\nが)いない」$"
String_1132:: @ 0x08CFEF4C, ID: 4402
  .string "<PROC=0>\n<END>$"
String_1133:: @ 0x08CFEF5B, ID: 4403
  .string "<LABEL=SMITH>スミス</LABEL>\n「鍛冶が必要になったらいつで\nも声をかけてくれ。$"
String_1134:: @ 0x08CFEFA7, ID: 4404
  .string "えんりょはいらん。\n戦いを退いたとはいえ、\nまだまだ若逢には負けんぞ」$"
String_1135:: @ 0x08CFEFEC, ID: 4405
  .string "<PROC=0>\n<END>$"
String_1136:: @ 0x08CFEFFB, ID: 4406
  .string "<END>$"
String_1137:: @ 0x08CFF001, ID: 4407
  .string "<LABEL=SABATA>サバタ</LABEL>\n「アンタがスミスか?」$"
String_1138:: @ 0x08CFF034, ID: 4408
  .string "<LABEL=SMITH>スミス</LABEL>\n「おまえは・・・サバタか!?$"
String_1139:: @ 0x08CFF06B, ID: 4409
  .string "おまえがリンゴが探し続けてい\nた<NAME>の兄・・・」$"
String_113A:: @ 0x08CFF09D, ID: 4410
  .string "<LABEL=SABATA>サバタ</LABEL>\n「あんたに1つ聞きたいことが\nある。$"
String_113B:: @ 0x08CFF0DD, ID: 4411
  .string "俺(おれ)たちの親父は・・・\n本当に死んだのか?$"
String_113C:: @ 0x08CFF10A, ID: 4412
  .string "あんたはその目で見たのか?\n親父の最後を・・・」$"
String_113D:: @ 0x08CFF139, ID: 4413
  .string "<LABEL=SMITH>スミス</LABEL>\n「・・・あいつの最後を見た者\nはおらん・・・$"
String_113E:: @ 0x08CFF181, ID: 4414
  .string "あいつは街の住人を逃(のが)す\nため、$"
String_113F:: @ 0x08CFF1A5, ID: 4415
  .string "伯爵(はくしゃく)を引きつける\nための囮(おとり)となったんじ\nゃ。$"
String_1140:: @ 0x08CFF1E4, ID: 4416
  .string "遺体もついには見つからなんだ\n・・・」$"
String_1141:: @ 0x08CFF20A, ID: 4417
  .string "<LABEL=SABATA>サバタ</LABEL>\n「そうか。だとすればやはりあ\nのヴァンパイアは・・・」$"
String_1142:: @ 0x08CFF25D, ID: 4418
  .string "<LABEL=SMITH>スミス</LABEL>\n「・・・まさか!!\nそんなことがあるはずない!$"
String_1143:: @ 0x08CFF2A4, ID: 4419
  .string "老いたとはいえ・・・あいつは\n太陽の血を引く最強のヴァンパ\nイアハンタ―じゃ」$"
String_1144:: @ 0x08CFF2F1, ID: 4420
  .string "<LABEL=SABATA>サバタ</LABEL>\n「だが現に、$"
String_1145:: @ 0x08CFF31B, ID: 4421
  .string "ヤツの手にかかり、<NAME>\nは危険な状態にある・・・$"
String_1146:: @ 0x08CFF34D, ID: 4422
  .string "あの男がイモ―タルに、\n銀河意思ダ―クに従うのならば$"
String_1147:: @ 0x08CFF381, ID: 4423
  .string "俺は倒(たお)す。\nあのヴァンパイアを・・・$"
String_1148:: @ 0x08CFF3AB, ID: 4424
  .string "たとえそれが、俺たちの親父で\nあったとしても!$"
String_1149:: @ 0x08CFF3D8, ID: 4425
  .string "暗黒仔(あんこくし)として育て\nられたこの俺には・・・$"
String_114A:: @ 0x08CFF40C, ID: 4426
  .string "しょせん血塗(ちぬ)られた生き\n方しかできんのだ。\n<PROC=1><LOCK=63>フッハッハッハッハッ!!」$"
String_114B:: @ 0x08CFF466, ID: 4427
  .string "<LABEL=SMITH>スミス</LABEL>\n「サバタ・・・」$"
String_114C:: @ 0x08CFF493, ID: 4428
  .string "<PROC=0>\n<END>$"
String_114D:: @ 0x08CFF4A2, ID: 4429
  .string "<LABEL=SMITH>スミス</LABEL>\n「リンゴ・・・」$"
String_114E:: @ 0x08CFF4CF, ID: 4430
  .string "<PROC=0>\n<END>$"
String_114F:: @ 0x08CFF4DE, ID: 4431
  .string "<END>$"
String_1150:: @ 0x08CFF4E4, ID: 4432
  .string "<LABEL=SMITH>スミス</LABEL>\n「<NAME>・・・$"
String_1151:: @ 0x08CFF50F, ID: 4433
  .string "太陽少年であるおまえがヴァン\nパイアになってしまうとは。$"
String_1152:: @ 0x08CFF547, ID: 4434
  .string "それにリンゴ・・・$"
String_1153:: @ 0x08CFF55A, ID: 4435
  .string "おまえたちの追っていたヴァン\nパイアは、本当にリンゴだった\nのか・・・?」$"
String_1154:: @ 0x08CFF5A2, ID: 4436
  .string "<PROC=0>\n<END>$"
String_1155:: @ 0x08CFF5B1, ID: 4437
  .string "<LABEL=SMITH>スミス</LABEL>\n「そういえば、シャイアンから\nの連絡が入ったぞ。$"
String_1156:: @ 0x08CFF5FD, ID: 4438
  .string "北東にある暗黒街で何かを見つ\nけたらしい。さらにくわしく調\nべてみるそうじゃ。$"
String_1157:: @ 0x08CFF64A, ID: 4439
  .string "暗黒街は、この街が吸血変異に\n襲(おそ)われる以前からの廃墟\n(はいきょ)・・・$"
String_1158:: @ 0x08CFF695, ID: 4440
  .string "人の作りし闇(やみ)の領域。$"
String_1159:: @ 0x08CFF6B0, ID: 4441
  .string "わしらは自らの手で、闇の一族\nをよみがえらせてしまったのか\nもしれん・・・」$"
String_115A:: @ 0x08CFF6FB, ID: 4442
  .string "<PROC=0>\n<END>$"
String_115B:: @ 0x08CFF70A, ID: 4443
  .string "<LABEL=SMITH>スミス</LABEL>\n「シャイアンとやりあったよう\nじゃな・・・$"
String_115C:: @ 0x08CFF750, ID: 4444
  .string "あいつは純粋(じゅんすい)なだ\nけに思い込(こ)みが激しい。$"
String_115D:: @ 0x08CFF788, ID: 4445
  .string "大方おまえの姿を見て、問答無\n用で戦いを仕掛(しか)けたんじ\nゃろう?$"
String_115E:: @ 0x08CFF7CA, ID: 4446
  .string "じゃがそれも無理はない。$"
String_115F:: @ 0x08CFF7E3, ID: 4447
  .string "あいつはヴァンパイアの手によ\nって、3人の兄弟を失っておる\nんじゃ・・・$"
String_1160:: @ 0x08CFF829, ID: 4448
  .string "ともかく、\n今は2人が無事で何よりじゃ」$"
String_1161:: @ 0x08CFF850, ID: 4449
  .string "<PROC=0>\n<END>$"
String_1162:: @ 0x08CFF85F, ID: 4450
  .string "<LABEL=SMITH>スミス</LABEL>\n「武器は果物や肉のように太陽\nの光でくさったりはしない。$"
String_1163:: @ 0x08CFF8B3, ID: 4451
  .string "だが使えば使うほど、少しずつ\nではあるがダメ―ジを受ける。$"
String_1164:: @ 0x08CFF8ED, ID: 4452
  .string "ダメ―ジがたまれば、いずれは\nその武器のクオリティも下がっ\nてしまうんじゃ。$"
String_1165:: @ 0x08CFF938, ID: 4453
  .string "クオリティが下がる前に鍛冶の\n材料にして、よりレベルの高い\n武器を作ったほうがいいぞ」$"
String_1166:: @ 0x08CFF98D, ID: 4454
  .string "<PROC=0>\n<END>$"
String_1167:: @ 0x08CFF99C, ID: 4455
  .string "<END>$"
String_1168:: @ 0x08CFF9A2, ID: 4456
  .string "<LABEL=SMITH>スミス</LABEL>\n「一時はどうなるかと思ったが\n・・・$"
String_1169:: @ 0x08CFF9E2, ID: 4457
  .string "おまえが太陽少年として無事帰\nって来てくれて、本当に良かっ\nたわい。$"
String_116A:: @ 0x08CFFA25, ID: 4458
  .string "問題はリンゴじゃ。$"
String_116B:: @ 0x08CFFA38, ID: 4459
  .string "ヴァンパイアとなり記憶を失っ\nておったとは・・・$"
String_116C:: @ 0x08CFFA68, ID: 4460
  .string "だが伯爵(はくしゃく)はなぜ、\n最大の好敵手(ライバル)にそん\nなことを・・・?$"
String_116D:: @ 0x08CFFAB2, ID: 4461
  .string "それがヤツの愛憎(あいぞう)の\n発露(はつろ)なのか、それとも\n・・・$"
String_116E:: @ 0x08CFFAF3, ID: 4462
  .string "おてんこのことも心配じゃ。\n暗黒樹を倒(たお)したとはいえ\nまだまだ油断はできん・・・」$"
String_116F:: @ 0x08CFFB48, ID: 4463
  .string "<PROC=0>\n<END>$"
String_1170:: @ 0x08CFFB57, ID: 4464
  .string "<LABEL=SMITH>スミス</LABEL>\n「リンゴの記憶(きおく)を取り\n戻したのは、$"
String_1171:: @ 0x08CFFB9D, ID: 4465
  .string "おまえが受け継(つ)いだ月光仔\n(げっこうし)の血の力。$"
String_1172:: @ 0x08CFFBD1, ID: 4466
  .string "その力をイモ―タルに利用され\n月光仔は世界から姿を消した。$"
String_1173:: @ 0x08CFFC0B, ID: 4467
  .string "その最後の生き残り、\nマ―ニとヘル・・・$"
String_1174:: @ 0x08CFFC33, ID: 4468
  .string "月の2面性、慈愛(じあい)と狂\n気(きょうき)を別々に受け継(\nつ)いだがゆえに、$"
String_1175:: @ 0x08CFFC7D, ID: 4469
  .string "敵味方に別れてしまった悲しき\n姉妹・・・$"
String_1176:: @ 0x08CFFCA5, ID: 4470
  .string "・・・マ―ニ、\nリンゴを導いてやってくれ」$"
String_1177:: @ 0x08CFFCCF, ID: 4471
  .string "<PROC=0>\n<END>$"
String_1178:: @ 0x08CFFCDE, ID: 4472
  .string "<LABEL=SMITH>スミス</LABEL>\n「武器には、レベルに応じたラ\nンクというものがある。$"
String_1179:: @ 0x08CFFD2E, ID: 4473
  .string "レベル13までの武器はCランク\n初心者向けであつかいやすいが\n威力(いりょく)はいまいちじゃ$"
String_117A:: @ 0x08CFFD84, ID: 4474
  .string "レベル29までの武器はBランク\n特殊効果(とくしゅこうか)を持\nつのはこのランクからじゃ。$"
String_117B:: @ 0x08CFFDD8, ID: 4475
  .string "ただし、特殊効果が付くかどう\nかは太陽鍛冶(たいようかじ)の\n出来しだいじゃな」$"
String_117C:: @ 0x08CFFE25, ID: 4476
  .string "<PROC=0>\n<END>$"
String_117D:: @ 0x08CFFE34, ID: 4477
  .string "<END>$"
String_117E:: @ 0x08CFFE3A, ID: 4478
  .string "<LABEL=SMITH>スミス</LABEL>\n「リンゴ・・・$"
String_117F:: @ 0x08CFFE65, ID: 4479
  .string "ヴァンパイアと成り果て、つい\nには身体を奪(うば)われるとは\n・・・$"
String_1180:: @ 0x08CFFEA6, ID: 4480
  .string "あいつの魂(たましい)は、すで\nに闇(やみ)に沈(しず)んでしま\nったのか・・・?$"
String_1181:: @ 0x08CFFEF0, ID: 4481
  .string "いや、あいつのしぶとさはわし\nが一番知っておる!$"
String_1182:: @ 0x08CFFF1F, ID: 4482
  .string "これしきのことであいつの心が\n折(お)れるものか!$"
String_1183:: @ 0x08CFFF4E, ID: 4483
  .string "<NAME>・・・\nリンゴを、あいつの魂を救って\nやってくれ!!」$"
String_1184:: @ 0x08CFFF87, ID: 4484
  .string "<PROC=0>\n<END>$"
String_1185:: @ 0x08CFFF96, ID: 4485
  .string "<LABEL=SMITH>スミス</LABEL>\n「明日もまた日は昇(のぼ)る!$"
String_1186:: @ 0x08CFFFCE, ID: 4486
  .string "リンゴの口ぐせじゃったな\n・・・$"
String_1187:: @ 0x08CFFFEE, ID: 4487
  .string "<NAME>、\n親父を信じるんじゃ!!」$"
String_1188:: @ 0x08D0000E, ID: 4488
  .string "<PROC=0>\n<END>$"
String_1189:: @ 0x08D0001D, ID: 4489
  .string "<LABEL=SMITH>スミス</LABEL>\n「武器には、レベルに応じたラ\nンクというものがある。$"
String_118A:: @ 0x08D0006D, ID: 4490
  .string "レベル45までの武器はAランク\n武器屋でも売っていない上級者\n向けの一点ものじゃ。$"
String_118B:: @ 0x08D000BB, ID: 4491
  .string "確実に手に入れるには太陽鍛冶\n(たいようかじ)で作るしかない\nぞ」$"
String_118C:: @ 0x08D000FA, ID: 4492
  .string "<PROC=0>\n<END>$"
String_118D:: @ 0x08D00109, ID: 4493
  .string "<END>$"
String_118E:: @ 0x08D0010F, ID: 4494
  .string "<LABEL=SMITH>スミス</LABEL>\n「封印(ふういん)のことは、わ\nしら街の者に任せておけ。$"
String_118F:: @ 0x08D00161, ID: 4495
  .string "リンゴにばかり、いい格好をさ\nせるわけにはいかん!$"
String_1190:: @ 0x08D00192, ID: 4496
  .string "久々の大仕事じゃ。\n腕(うで)が鳴るわい!$"
String_1191:: @ 0x08D001B9, ID: 4497
  .string "おまえは心置きなく、そのヨル\nムンガンドとやらの頭をぶんな\nぐって来い!!」$"
String_1192:: @ 0x08D00202, ID: 4498
  .string "<PROC=0>\n<END>$"
String_1193:: @ 0x08D00211, ID: 4499
  .string "<LABEL=SMITH>スミス</LABEL>\n「ん?\nおまえの持っているそれは、$"
String_1194:: @ 0x08D0024E, ID: 4500
  .string "太陽銃(たいようじゅう)、\nガン・デル・ソル!!$"
String_1195:: @ 0x08D0027A, ID: 4501
  .string "そうか、ついに取り戻(もど)し\nたんじゃったな。$"
String_1196:: @ 0x08D002A8, ID: 4502
  .string "それにしても・・・\nこっぴどく壊(こわ)れたもんじ\nゃな。それでは使い物にならん$"
String_1197:: @ 0x08D002F5, ID: 4503
  .string "よし、わしが修理してみよう。\nわしもかつてはガンマスタ―と\n呼ばれた男、$"
String_1198:: @ 0x08D0033C, ID: 4504
  .string "元通りとまではいかんじゃろう\nが、必ずよみがえらせてみせる\n!!」$"
String_1199:: @ 0x08D0037B, ID: 4505
  .string "<FACEOFF><MOJISE=MOJISE_SYSTEM>「壊れた太陽銃」を渡した!$"
String_119A:: @ 0x08D003B4, ID: 4506
  .string "<PROC=0>\n<END>$"
String_119B:: @ 0x08D003C3, ID: 4507
  .string "<LABEL=SMITH>スミス</LABEL>\n「できたぞ!!」$"
String_119C:: @ 0x08D003EE, ID: 4508
  .string "<PROC=0>\n<END>$"
String_119D:: @ 0x08D003FD, ID: 4509
  .string "<FACEOFF><PROC=1>太陽銃「ガン・デル・ソル」\nを手に入れた!!$"
String_119E:: @ 0x08D00438, ID: 4510
  .string "<PROC=0>\n<END>$"
String_119F:: @ 0x08D00447, ID: 4511
  .string "<LABEL=SMITH>スミス</LABEL>\n「とりあえず使える状態にはな\nったが、$"
String_11A0:: @ 0x08D00489, ID: 4512
  .string "レンズの交換(こうかん)はでき\nんな。エネルギ―効率も落ちて\nおる。$"
String_11A1:: @ 0x08D004CA, ID: 4513
  .string "その代わりと言っては何じゃが$"
String_11A2:: @ 0x08D004E7, ID: 4514
  .string "Ｂボタンを押(お)しっぱなしに\nしてエナジ―を増幅(ぞうふく)\nすることで、$"
String_11A3:: @ 0x08D0052E, ID: 4515
  .string "攻撃力(こうげきりょく)の高い\nチャ―ジショットを撃(う)つこ\nとができる。試してみてくれ」$"
String_11A4:: @ 0x08D00585, ID: 4516
  .string "<PROC=0>\n<END>$"
String_11A5:: @ 0x08D00594, ID: 4517
  .string "<LABEL=SMITH>スミス</LABEL>\n「リンゴ・・・$"
String_11A6:: @ 0x08D005BF, ID: 4518
  .string "またしてもこの年寄りを置いて\n先に逝(い)っちまうとは・・・$"
String_11A7:: @ 0x08D005F9, ID: 4519
  .string "あのバカ弟子が!!」$"
String_11A8:: @ 0x08D0060C, ID: 4520
  .string "<PROC=0>\n<END>$"
String_11A9:: @ 0x08D0061B, ID: 4521
  .string "<LABEL=SMITH>スミス</LABEL>\n「太陽鍛冶(たいようかじ)にお\nいては、$"
String_11AA:: @ 0x08D0065D, ID: 4522
