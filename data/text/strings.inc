  .string "<LABEL=RITA>リタ</LABEL>\n「<NAME>さま、$"
String_122C:: @ 0x08D01BBC, ID: 4652
  .string "お身体は大丈夫(だいじょうぶ)\nですか?$"
String_122D:: @ 0x08D01BE1, ID: 4653
