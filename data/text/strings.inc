String_012D:: @ 0x08CD4168, ID: 301
  .string "<PROC=0>\n<END>$"
String_012E:: @ 0x08CD4177, ID: 302
  .string "それでは今後とも暗黒ロ―ンを\nよろしくお願いします。\n<PROC=1>ありがとうございました!!」<PROC=2>$"
String_012F:: @ 0x08CD41D6, ID: 303
  .string "<PROC=0>\n<END>$"
String_0130:: @ 0x08CD41E5, ID: 304
