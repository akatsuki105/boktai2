String_12E8:: @ 0x08D03BD7, ID: 4840
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「<NAME>!!$"
String_12E9:: @ 0x08D03C05, ID: 4841
  .string "準備が整いしだい、白きドゥネ\nイルを浄化(じょうか)するんだ\n!」$"
String_12EA:: @ 0x08D03C43, ID: 4842
  .string "<PROC=0>\n<END>$"
String_12EB:: @ 0x08D03C52, ID: 4843
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「どうやら・・・$"
String_12EC:: @ 0x08D03C86, ID: 4844
  .string "スミスやスミレ以外にも、この\n街に残った者がいるようだな。$"
String_12ED:: @ 0x08D03CC0, ID: 4845
  .string "彼(かれ)らは生きることをあき\nらめたのか、それとも・・・」$"
String_12EE:: @ 0x08D03CFA, ID: 4846
  .string "<PROC=0>\n<END>$"
String_12EF:: @ 0x08D03D09, ID: 4847
  .string "<END>$"
String_12F0:: @ 0x08D03D0F, ID: 4848
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「とりあえずは何とかなったが\n・・・$"
String_12F1:: @ 0x08D03D56, ID: 4849
  .string "太陽銃をいつまでもヴァンパイ\nアの好きにさせておくわけには\nいかん。$"
String_12F2:: @ 0x08D03D99, ID: 4850
  .string "一刻も早く取り戻(もど)すんだ\n!!」$"
String_12F3:: @ 0x08D03DBB, ID: 4851
  .string "<PROC=0>\n<END>$"
String_12F4:: @ 0x08D03DCA, ID: 4852
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「結界は無事なようだな。$"
String_12F5:: @ 0x08D03E06, ID: 4853
  .string "さすがは伝説の魔女、ひまわり\n娘(むすめ)の弟子だ」$"
String_12F6:: @ 0x08D03E38, ID: 4854
  .string "<PROC=0>\n<END>$"
String_12F7:: @ 0x08D03E47, ID: 4855
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「ようやくヴァンパイアの足取\nりがつかめたな・・・$"
String_12F8:: @ 0x08D03E9C, ID: 4856
  .string "<NAME>、$"
String_12F9:: @ 0x08D03EA5, ID: 4857
  .string "南東にあるという砂漠(さばく)\nの遺跡(いせき)に向かうんだ!!\n」$"
String_12FA:: @ 0x08D03EE2, ID: 4858
  .string "<PROC=0>\n<END>$"
String_12FB:: @ 0x08D03EF1, ID: 4859
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「<NAME>、$"
String_12FC:: @ 0x08D03F1F, ID: 4860
  .string "南東にある砂漠(さばく)の遺跡\n(いせき)に向かおう!$"
String_12FD:: @ 0x08D03F50, ID: 4861
  .string "一刻も早く太陽銃(たいようじ\nゅう)を取り戻(もど)すんだ!!\n」$"
String_12FE:: @ 0x08D03F8B, ID: 4862
  .string "<PROC=0>\n<END>$"
String_12FF:: @ 0x08D03F9A, ID: 4863
  .string "<LABEL=OTENKO>おてんこさま</LABEL>\n「今思うに・・・$"
String_1300:: @ 0x08D03FCE, ID: 4864
  .string "あのヴァンパイア、以前にもど\nこかで見たことが・・・\n・・・だがいったいどこで?」$"
String_1301:: @ 0x08D0401E, ID: 4865
  .string "<PROC=0>\n<END>$"
String_1302:: @ 0x08D0402D, ID: 4866
  .string "<END>$"
String_1303:: @ 0x08D04033, ID: 4867
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「おぬしは・・・」$"
String_1304:: @ 0x08D04064, ID: 4868
  .string "<PROC=0>\n<END>$"
String_1305:: @ 0x08D04073, ID: 4869
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「おお、おぬしか!!$"
String_1306:: @ 0x08D040A4, ID: 4870
  .string "ここにはモンスタ―どもも入っ\nて来られぬようだの。$"
String_1307:: @ 0x08D040D6, ID: 4871
  .string "おかげで今しばらく、命を長ら\nえることができそうじゃ。$"
String_1308:: @ 0x08D0410C, ID: 4872
  .string "おぬしには礼を言うぞ!」$"
String_1309:: @ 0x08D04124, ID: 4873
  .string "<PROC=0>\n<END>$"
String_130A:: @ 0x08D04133, ID: 4874
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「知っとるかの?$"
String_130B:: @ 0x08D04161, ID: 4875
  .string "メニュ―画面でSTARTボタンを\n押(お)すと、メニュ―の一覧が\n表示されるんじゃ。$"
String_130C:: @ 0x08D041AD, ID: 4876
  .string "✚ボタンで選択(せんたく)し、\nＡボタンで決定すれば、選んだ\nメニュ―を開くことができる。$"
String_130D:: @ 0x08D04204, ID: 4877
  .string "Ｌ・Ｒボタンでもメニュ―の切\nり換(か)えは可能じゃが、$"
String_130E:: @ 0x08D0423A, ID: 4878
  .string "目的のメニュ―を探したいとき\nには便利じゃぞ」$"
String_130F:: @ 0x08D04268, ID: 4879
  .string "<PROC=0>\n<END>$"
String_1310:: @ 0x08D04277, ID: 4880
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「この年じゃ、$"
String_1311:: @ 0x08D042A4, ID: 4881
  .string "これ以上生き長らえても、意味\nはないと思っておったが・・・$"
String_1312:: @ 0x08D042DE, ID: 4882
  .string "アンデッドを目の前にして、\n初めて気がついたんじゃ。$"
String_1313:: @ 0x08D04312, ID: 4883
  .string "生きるということの、意味をな\n・・・」$"
String_1314:: @ 0x08D04338, ID: 4884
  .string "<PROC=0>\n<END>$"
String_1315:: @ 0x08D04347, ID: 4885
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「知っとるかの?$"
String_1316:: @ 0x08D04375, ID: 4886
  .string "メニュ―画面でアイテムや武器\n防具の説明が流れているときに\nSELECTボタンを押(お)すと、$"
String_1317:: @ 0x08D043CA, ID: 4887
  .string "説明を早送りすることができる\nんじゃ。読みたい情報を探すの\nに便利じゃぞ」$"
String_1318:: @ 0x08D04413, ID: 4888
  .string "<PROC=0>\n<END>$"
String_1319:: @ 0x08D04422, ID: 4889
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「わしが何に気がついたのか、\nそれを知りたいのか?$"
String_131A:: @ 0x08D04471, ID: 4890
  .string "残念じゃが教えることはできん\n・・・$"
String_131B:: @ 0x08D04495, ID: 4891
  .string "自分自身で感じなければ、\nその意味は分からんのじゃ。$"
String_131C:: @ 0x08D044C9, ID: 4892
  .string "おぬしにもそのうち分かる。\nおぬしならきっとな・・・」$"
String_131D:: @ 0x08D044FF, ID: 4893
  .string "<PROC=0>\n<END>$"
String_131E:: @ 0x08D0450E, ID: 4894
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「この地震(じしん)は何なんじ\nゃ?$"
String_131F:: @ 0x08D0454D, ID: 4895
  .string "おぬしのおかげで長らえたこの\n命も・・・$"
String_1320:: @ 0x08D04575, ID: 4896
  .string "・・・ここまでかの?」$"
String_1321:: @ 0x08D0458B, ID: 4897
  .string "<PROC=0>\n<END>$"
String_1322:: @ 0x08D0459A, ID: 4898
  .string "<LABEL=PEOPLE3>ルイス</LABEL>\n「たとえこれで終わりじゃとし\nても、$"
String_1323:: @ 0x08D045DC, ID: 4899
  .string "わしは十分に満足しとるよ。$"
String_1324:: @ 0x08D045F7, ID: 4900
  .string "生きるということは、結果では\nないからの・・・」$"
String_1325:: @ 0x08D04627, ID: 4901
  .string "<PROC=0>\n<END>$"
String_1326:: @ 0x08D04636, ID: 4902
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「きみは・・・」$"
String_1327:: @ 0x08D04669, ID: 4903
  .string "<PROC=0>\n<END>$"
String_1328:: @ 0x08D04678, ID: 4904
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「<NAME>くん!!$"
String_1329:: @ 0x08D046A9, ID: 4905
  .string "おかげで無事ダンジョンを脱出\n(だっしゅつ)できたよ。$"
String_132A:: @ 0x08D046DD, ID: 4906
  .string "聞けば、この街を救うために戦\nっているそうじゃないか。$"
String_132B:: @ 0x08D04713, ID: 4907
  .string "きみのような少年がすごいな。\nぼくにはとてもできないよ。$"
String_132C:: @ 0x08D0474B, ID: 4908
  .string "怖(こわ)くはないのかい?」$"
String_132D:: @ 0x08D04765, ID: 4909
  .string "<PROC=0>\n<END>$"
String_132E:: @ 0x08D04774, ID: 4910
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「いいかい?$"
String_132F:: @ 0x08D047A2, ID: 4911
  .string "メニュ―画面でアイテムを使っ\nたり、武器や防具を装備すると\nきに、$"
String_1330:: @ 0x08D047E3, ID: 4912
  .string "Ａボタンでアイコンを選んだ後\nカ―ソルを動かさずに、もう1\n度Ａボタンを押(お)せば、$"
String_1331:: @ 0x08D04835, ID: 4913
  .string "ツカウやソウビを選ばなくても\nアイテムを使ったり、装備をし\nたりできるんだ。$"
String_1332:: @ 0x08D04880, ID: 4914
  .string "メニュ―画面での基本操作だか\nら、覚えておいてね」$"
String_1333:: @ 0x08D048B2, ID: 4915
  .string "<PROC=0>\n<END>$"
String_1334:: @ 0x08D048C1, ID: 4916
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「ぼくは争いが嫌(きら)いなん\nだ・・・$"
String_1335:: @ 0x08D04909, ID: 4917
  .string "たとえモンスタ―だとしても、\n相手を傷つけたくはないんだよ$"
String_1336:: @ 0x08D04943, ID: 4918
  .string "こんなこと言うの・・・\n・・・おかしいかな?」$"
String_1337:: @ 0x08D04970, ID: 4919
  .string "<PROC=0>\n<END>$"
String_1338:: @ 0x08D0497F, ID: 4920
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「いいかい?$"
String_1339:: @ 0x08D049AD, ID: 4921
  .string "メニュ―画面でアイテムや武器\n防具を捨てたいときは、$"
String_133A:: @ 0x08D049E1, ID: 4922
  .string "Ａボタンでアイコンを選んだ後\nSELECTボタンを押(お)すんだ。$"
String_133B:: @ 0x08D04A1B, ID: 4923
  .string "でも1度捨ててしまったものを\n取り戻(もど)すことはできない\n注意して。$"
String_133C:: @ 0x08D04A5F, ID: 4924
  .string "それから、装備している武器や\n貴重品などの大事なものは、捨\nてることができないからね」$"
String_133D:: @ 0x08D04AB4, ID: 4925
  .string "<PROC=0>\n<END>$"
String_133E:: @ 0x08D04AC3, ID: 4926
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「身体が大きいからね・・・\nよく誤解されるんだけど、$"
String_133F:: @ 0x08D04B19, ID: 4927
  .string "ぼくが好きなのは、鳥や魚や、\n小さな生き物たちをながめるこ\nとなんだ。$"
String_1340:: @ 0x08D04B5E, ID: 4928
  .string "彼らの世界にも残酷(ざんこく)\nな生と死はあるけれど、$"
String_1341:: @ 0x08D04B92, ID: 4929
  .string "人のそれとは、どこか違(ちが)\nう気がするんだ・・・」$"
String_1342:: @ 0x08D04BC6, ID: 4930
  .string "<PROC=0>\n<END>$"
String_1343:: @ 0x08D04BD5, ID: 4931
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「新しい太陽樹が根づき、$"
String_1344:: @ 0x08D04C10, ID: 4932
  .string "この街にもようやく、動物たち\nが戻って来てくれたのに・・・$"
String_1345:: @ 0x08D04C4A, ID: 4933
  .string "今度こそ・・・\n・・・終わりなのかい?」$"
String_1346:: @ 0x08D04C71, ID: 4934
  .string "<PROC=0>\n<END>$"
String_1347:: @ 0x08D04C80, ID: 4935
  .string "<LABEL=PEOPLE1>マルチェロ</LABEL>\n「終末の獣(けもの)、ヨルムン\nガンド・・・$"
String_1348:: @ 0x08D04CCC, ID: 4936
  .string "アンデッドやイモ―タルは、生\nと死の輪廻(りんね)を脅(おび\nや)かす存在だけれども、$"
String_1349:: @ 0x08D04D1D, ID: 4937
  .string "ヨルムンガンドは星の命をも左\n右する存在。$"
String_134A:: @ 0x08D04D47, ID: 4938
  .string "そんなものがこの街に眠(ねむ)\nっていたなんて・・・$"
String_134B:: @ 0x08D04D79, ID: 4939
  .string "星の命もまた、生と死の輪廻か\nらは逃(のが)れられないのだろ\nうか・・・?」$"
String_134C:: @ 0x08D04DC1, ID: 4940
  .string "<PROC=0>\n<END>$"

