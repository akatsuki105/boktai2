String_102C:: @ 0x08CFC475, ID: 4140
  .string "<PROC=0>\n<END>$"
String_102D:: @ 0x08CFC484, ID: 4141
  .string "<LABEL=SUMIRE>スミレ</LABEL>\n「あっ・・・カギ!$"
