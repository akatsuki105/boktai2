block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 墓の製似・その3
    ; 墓倒(むげんがい)では、その 中でセーブすることはできない
    ; 暴怖展から還(せいかん)し て神めて、そこでの粋騎を家 のものとすることができる。
    ; コンティニューしても、入再に 層されてしまうので納意せよ。
    ; <PROC=0> <END>
    string-ref 0x740
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

