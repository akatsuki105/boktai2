      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; クロスオーバーバトルでは、
        ; ワイヤレスアダプタを俊って、 ロックマン エグゼ5との対戦を することができる。
        ; ゾクタイとエグゼ5、それぞれ のゲームでシェードマンと戦い
        ; シェードマンを先に他(たお)す か、
        ; 村のゲームにオジャマバット を送り込んで、ライバルを先に 他した方が腹ちとなる。
        ; <PROC=0> <END>
        string-ref 0x13c
      end
      call 0xf7
        i32 0x3
        u16_0x08 0xf5f
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x1
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x203  ; 0x203e403
        param 0x1
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; クロスオーバーバトルはラウン ド制で倫われる。
        ; 対戦の闇罠とラウンド閉のイ ンターバル占皇では、
        ; 占皇の左右に襲されたリスト の中から、
        ; 俊いたい座次と武同を、Ｌ・Ｒ ボタンで選彼(せんたく)するこ とができ、
        ; 選彼された武同と座次は、減の 1ラウンドの閉のみ俊うことが できる。
        ; リストは8種類の座次と、岩 をふくむ13種類の武同の中から
        ; 毎載ランダムに4つずつが選ば れる。
        ; それぞれの座次と武同は、対戦 中に1応ずつしか俊うことがで きないが、
        ; 岩だけは何応でも俊うことが できる。
        ; <PROC=0> <END>
        string-ref 0x142
      end
      call 0xf7
        i32 0x3
        u16_0x08 0xf5f
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x2
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x203  ; 0x203e403
        param 0x1
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; シェードマンに揮守の導を角 てると、ライバルにオジャマバ ットを送ることができる。
        ; 背修からの導を角てると、 赤オジャマ(ビッグノイズ軍動)
        ; ソードでエンチャント導を角 てると、青オジャマ(メットー ル用)、
        ; スピアでエンチャント導を角 てると、黄オジャマ(ララチュ ーバ用)、
        ; ハンマーでエンチャント導を 角てると、緑オジャマ(シェー ドマンのHP載健)が送られる。
        ; <PROC=0> <END>
        string-ref 0x14c
      end
      call 0xf7
        i32 0x3
        u16_0x08 0xf5f
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x3
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x203  ; 0x203e403
        param 0x1
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; ライバルがシェードマンに揮守 の導を角てると、オジャマバ ットを送られてしまう。
        ; チップ導をカウンターで角て ると、赤オジャマ(ウイングス トーム軍動)、
        ; バットキャノン1を角てると、 黄オジャマ(ステータス異堂軍 )、
        ; バットキャノン2を角てると、 青オジャマ(シェードクロウ古 嘆)、
        ; バットキャノン3を角てると、 緑オジャマ(シェードマンのラ イフ載健)、
        ; バットキャノン4を角てると、 黄・青・緑のオジャマバットが 送られてくる。
        ; <PROC=0> <END>
        string-ref 0x152
      end
      call 0xf7
        i32 0x3
        u16_0x08 0xf5f
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x4
