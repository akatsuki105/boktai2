Script_0F0C: @ 0x08D93064, ScriptID: 3852
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 墓の製似・その1
    ; 墓倒(むげんがい)とは、 甲怪求象がみ用した、墓と (まぼろし)の倒である。
    ; そこに孫むのは、家甲界での 限界を究硝(とっぱ)した、ナイ トメア・モンスター・・・
    ; その力は、家をはるかに越( こ)える。
    ; <PROC=0> <END>
    string-ref 0x734
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_0F0D: @ 0x08D93081, ScriptID: 3853
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 墓の製似・その2
    ; 上の展への青い戻のカギは、 重量スイッチにより階(かく)さ れている。
    ; ただしここでの重量スイッチは 超動するまで何が超こるかわか らない、トラップパネルだ。
    ; 周降凶(ぼうけんしゃ)を助ける パネルもあれば、芳しめるパネ ルもある。
    ; 算降を載避(かいひ)したければ 敬モンスターにパネルを距(ふ) ませ、その効果を砲許せよ。
    ; カギを見つけ用し、暴怖展を 画街せ。
    ; <PROC=0> <END>
    string-ref 0x739
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

