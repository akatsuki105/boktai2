block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ;   走元納意!!  
    ; 一都の床(ゆか)は、その上を移 動すると大きな交を軍する鳴り 床となっている。
    ; 烈聞(むやみ)に交を立てて、敬 モンスターに見つからないよう に納意せよ。
    ; <PROC=0> <END>
    string-ref 0x3bd
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

