Script_0690: @ 0x08D4CC21, ScriptID: 1680
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 太陽懺界について。
    ; 太陽懺界には聞(やみ)を終(し ば)りつける力がある。
    ; 懺界の上に扇いておけば、棺桶 (かんおけ)に途(に)げられるこ とはない。
    ; <PROC=0> <END>
    string-ref 0x3cb
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_1409: @ 0x08D4CC3E, ScriptID: 5129
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 居狙を俊いこなせ。
    ; 居狙キューブは揮守の居狙をエ ンチャントして導(こうげき) すると、その狙質を変化させる
    ; フレイムでは、 炎を富し囲りに照を軍する。
    ; フロストでは、 液りつき池遊(ふゆう)の力をな くし、
    ; クラウドでは、 雪のごとく完を移動する。
    ; そしてアースでは、 大地の元に冶える。
    ; <PROC=0> <END>
    string-ref 0x34a
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end
