  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ;  映聞(くらやみ)納意!! 
    ; ファントム(彰)タイプのモン スター、ゴーストは、
    ; 福賞でも聴賞(ちょうかく)でも なく、大気の動き、すなわち村 の動きを恋噴して倫動する。
    ; また、映聞では姿を見ることが できるが、
    ; 史想や爆町(しょくだい)の明か りのもとでは姿を冶してしまう その狙質をよく靖預せよ。
    ; <PROC=0> <END>
    string-ref 0x3c1
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

