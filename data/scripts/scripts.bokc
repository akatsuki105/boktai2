// 0x08D1B98E, 太陽ゲージが範囲に入ったとき, 音を鳴らして太陽床を出し, 床のタイルの上書きを切り替える
Scr_OnSolarFloorAppear() {
	if (S_UNK_04E_2 == 0 && S_UNK_04E_3 == 0 && { Command(Cmd_IsPlayerDead); } == 0) {
		Command(Cmd_PlayTrackedSound, .i = (s16)681);
		S_UNK_04E_2 = 1;
	} else {}
	Command(Cmd_SetTileOverrideParams, .n = (u16)0x7E0E, .e = 32);
	Scr_ShowSolarFloor();
	if (S_UNK_04E_4 == 0) {} else {
		Scr_ShowSolarFloor();
	}
}

// 0x08D1B9FD, 太陽ゲージが範囲から出たとき, 太陽床を消し, 床のタイルの上書きを戻す
Scr_OnSolarFloorVanish() {
	S_UNK_04E_2 = 0;
	Command(Cmd_SetTileOverrideParams, .n = (u16)0x7E0E, .e = (u8)64);
	Chara(Cmd_Delay, (u16)0x4709, .t = 2, .e = {
		Mesg(0x4709, (u16)0xFFFF);
		Command(Cmd_1E97);
	});
	if (S_UNK_04E_4 == 0) {
		Scr_HideSolarFloor();
	} else {
		Scr_HideSolarFloor();
	}
}

// 0x08D1BA5E, 太陽床の監視 (SunRangeWatcher, インスタンスは HashName("太陽床")) を作る, 太陽ゲージ 1〜8 の間だけ床が出る
Scr_CreateSolarFloorWatcher() {
	if (!(({ Command(Cmd_GetSolarGauge); } > 0 && { Command(Cmd_GetSolarGauge); } < 9))) {
		S_UNK_04E_2 = 0;
	} else {
		S_UNK_04E_2 = 1;
	}
	S_UNK_04E_4 = 0;
	S_UNK_04E_3 = 0;
	S_UNK_04F = 0;
	Chara(SunRangeWatcher_Create, (u16)0x94DD, .p = [(u24)Scr_OnSolarFloorAppear, (u24)Scr_OnSolarFloorVanish], .f = 0, .u = [1, 8]);
}

