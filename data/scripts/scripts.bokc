	} else if (W_STORY_PROGRESS >= (u8)63) {
		S_NPC_POS_X = (s16)384;
		S_NPC_POS_Y = (s16)512;
		S_NPC_POS_Z = (s16)384;
		S_NPC_ANGLE = (u8)64;
		S_NPC_INIT_MODE = 3;
		v1 = 1;
	}
	if (v1 >= 1) {
		S_KURO_HOUSE_TALK_TOGGLE = 0;
		if ({ Scr_0x01C1(0); } == 0 || v1 == 2) {
			if (W_STORY_PROGRESS < 48) {
				Command(Cmd_D774, .n = (u16)0x51E2, .p = [S_NPC_POS_X, S_NPC_POS_Y, S_NPC_POS_Z], .d = S_NPC_ANGLE, .w = [(s16)256, (s16)256, (s16)512], .H = [4, 4], .i = S_NPC_INIT_MODE);
				Scr_AddInteractPoint((u16)0x51E2, 0, 1, (u24)Scr_TalkKuroHouse, (s16)256, (s16)512);
			} else {
				Command(Cmd_82C8, .n = (u16)0x29A0, .p = [S_NPC_POS_X, S_NPC_POS_Y, S_NPC_POS_Z], .d = S_NPC_ANGLE, .w = [(s16)256, (s16)256, (s16)512], .H = [S_UNK_176, S_UNK_178], .i = S_NPC_INIT_MODE, .t = (u24)Scr_TalkKuroBandagedHouse);
				Scr_AddInteractPoint((u16)0x51E2, 0, 1, (u24)Scr_TalkKuroBandagedHouse, (s16)256, (s16)512);
			}
		}
	}
}

