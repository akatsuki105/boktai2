// 0x08D6FF16, 依頼を受けるかの結果, 前回の報酬を受け取っていなければ断る, p0: 0 受ける, 1 受けない, 2 もう一度読む
Scr_QuestAcceptAnswer() {
	if (p0 < 0) {
		Chara(Cmd_Delay, (u16)0xAD92, .t = 5, .e = {
			Scr_0x0B13();
		});
	} else if (p0 == 0) {
		if (BIT(world + 0x75, 3) == 1) {
			if (W_STORY_PROGRESS >= 53) {
				BIT(scratch + 0x14, 4) = 1;
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_0E67));
				Scr_OpenMsgWindow(3, (u24)Scr_0x0B24, 0);
			} else {
				BIT(scratch + 0x14, 4) = 0;
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0E65));
				Scr_OpenMsgWindow(3, (u24)Scr_0x0B24, 0);
			}
		} else {
			if (W_STORY_PROGRESS >= 53) {
				BIT(scratch + 0x14, 4) = 1;
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_0E69));
				Scr_OpenMsgWindow(3, (u24)Scr_0x0B22, 0);
			} else {
				Scr_0x0B22();
			}
		}
	} else if (p0 == 1) {
		Chara(Cmd_Delay, (u16)0xAD92, .t = 5, .e = {
			Scr_0x0B13();
		});
	} else if (p0 == 2) {
		Scr_ShowTreasureRequest();
	}
}

// 0x08D7001A
Scr_0x0B22() {
	switch (S_TREASURE_REQUEST_PLACE) {
		case 0: {
			W_CURRENT_QUEST = 0 + S_TREASURE_REQUEST_NO;
			W_QUEST_ACCEPTED((0 + S_TREASURE_REQUEST_NO)) = 1;
		}
		case 1: {
			W_CURRENT_QUEST = 3 + S_TREASURE_REQUEST_NO;
			W_QUEST_ACCEPTED((3 + S_TREASURE_REQUEST_NO)) = 1;
		}
		case 2: {
			W_CURRENT_QUEST = 6 + S_TREASURE_REQUEST_NO;
			W_QUEST_ACCEPTED((6 + S_TREASURE_REQUEST_NO)) = 1;
		}
		case 3: {
			W_CURRENT_QUEST = 9 + S_TREASURE_REQUEST_NO;
			W_QUEST_ACCEPTED((9 + S_TREASURE_REQUEST_NO)) = 1;
		}
	}
	Scr_CloseMsgWindow();
	Command(Cmd_SetHUDMode, .m = 7);
	Scr_0x0B23();
}

