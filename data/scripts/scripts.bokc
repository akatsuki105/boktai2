// 0x08D67B77, 会話中のクロのアニメに切り替える, 通常と包帯の両方
Scr_KuroTalkAnimStart() {
	if (BIT(scratch + 0x16B, 7) == 1) {
		return;
	}
	if (W_STORY_PROGRESS < 48) {
		DebugPrint("くろ　のーまる");
		Command(Cmd_DDD0, .n = (u16)20962, .k = 5, .a = 24);
	} else {
		DebugPrint("くろ　ほうたい");
		Command(Cmd_DDD0, .n = (u16)10656, .k = 5, .a = 24);
	}
	BIT(scratch + 0x16B, 7) = 1;
}

// 0x08D67C04, クロのアニメを通常に戻す
Scr_KuroTalkAnimEnd() {
	if (BIT(scratch + 0x16B, 7) != 1) {
		return;
	}
	if (W_STORY_PROGRESS < 48) {
		DebugPrint("くろ　のーまる");
		Command(Cmd_DDD0, .n = (u16)20962, .k = 5, .a = 23);
	} else {
		DebugPrint("くろ　ほうたい");
		Command(Cmd_DDD0, .n = (u16)10656, .k = 5, .a = 23);
	}
	BIT(scratch + 0x16B, 7) = 0;
}

