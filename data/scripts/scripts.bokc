				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0673));
				Scr_OpenMsgWindow(3, (u24)Scr_0x1727, 0);
				Command(Cmd_SetMessageWindowScriptIds, .p = [(u24)Scr_0x1727, (u24)Scr_Nop, (u24)Scr_Nop, (u24)Scr_Nop]);
			} else {
				Scr_KuroTalkAnimStart();
				if (S_KURO_HOUSE_TALK_TOGGLE == 0) {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_066F));
				} else {
