// 0x08D9B4A9, ゲームクリア, 周回数++して、 偶数周ならブラックパンサーを挟んでから Scr_StaffRoll
Scr_GameClear() {
	Scr_CreateMapSystems(1);
	Command(Cmd_SetHUDMode, .m = 7);
	Scr_PlayBgm(1, (u8)88);
	if (LAP < (s16)9999) {
		LAP = LAP + 1;
	}
	if (LAP & 1) {
		Chara(EndRollChara_Create, (u16)0x79C0, .t = StringRef(Bin_18F6), .c = StringRef(Bin_1BE1), .e = (u24)Scr_Nop);
		Command(Cmd_SetMessageWindowScriptIds, .p = [(u24)Scr_Nop, (u24)Scr_Nop]);
	} else {
		Command(Cmd_LoadMap, .n = (u16)0xCC6F, .p = (u16)0x78F6);
		Command(Cmd_SetCameraTilemapOffset, .v = 0);
		Chara(Camera_Create, (u16)0x6E90);
		Command(Cmd_SetMessageWindowScriptIds, .p = [(u24)Scr_0x1041, (u24)Scr_0x1042]);
		Chara(BlackPanther_Create, (u16)0x7256, .k = [(s16)1920, (s16)256, (s16)4000], .c = [(s16)1881, (s16)406, (s16)3393], .C = [0, 7, 2, 5, 1]);
	}
	Scr_StaffRoll((u24)Scr_0x102A);
}

