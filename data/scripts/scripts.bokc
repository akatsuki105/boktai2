		case 2: {
			*((u8 *)(scratch + 0x2F)) = *((u8 *)(scratch + 0x2F)) + 1;
			ScriptCall(0x0081);
			ScriptCall(0x00FE);
			ScriptCall(0x02F2);
		}
		default: {}
	}
}

