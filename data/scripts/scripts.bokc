	Command(Sandworm_Create, .N = p0, .p = [p2, p3, p4], .e = S_ENEMY_RANGE0, .a = [S_ENEMY_ATK1_POWER, 10, S_ENEMY_ATK1_ATTRS, S_ENEMY_ATK1_IFRAMES, S_ENEMY_ATK2_POWER, (u8)120, S_ENEMY_ATK2_ATTRS, S_ENEMY_ATK2_IFRAMES, S_ENEMY_ATK3_POWER, 60, S_ENEMY_ATK3_ATTRS, S_ENEMY_ATK3_IFRAMES, S_ENEMY_ATK4_POWER, 30, S_ENEMY_ATK4_ATTRS, S_ENEMY_ATK4_IFRAMES], .P = S_UNK_0F0, .A = [S_ENEMY_MAX_HP, S_ENEMY_POWER, 50, S_UNK_0E0, S_ENEMY_ATTRS, S_ENEMY_WEAKNESS], .l = [S_UNK_0C6, S_ENEMY_SLEEP_TIME, S_ENEMY_CHASE_TIME_MAX], .n = [S_ENEMY_RANGE2, S_UNK_0CC], .C = 0, .I = (u24)Scr_Nop, .D = p1, .G = [S_ENEMY_DROP_A, S_ENEMY_DROP_B, p8], .M = S_ENEMY_FLAGS5, .X = [S_ENEMY_EXP, S_ENEMY_WEAPON_EXP], .K = S_UNK_0EE, .d = (u24)Scr_OnSandwormAppear, .H = S_UNK_0B9_1);
}

// 0x08D296BF, BGM を消し, Cmd_C15E を p0 に向けて呼び (カメラ?), プレイヤーを止める, Scr_SpawnSandworm が登場時スクリプト ('.d') として渡す
Scr_OnSandwormAppear() {
	Command(Cmd_FadeOutBGM, .f = 8);
	Command(Cmd_C15E, .n = p0, .o = [0, 0, 0], .f = 30);
	Command(Cmd_LockPlayer);
}

// 0x08D296E9, Cmd_C15E をプレイヤー (0xF5EB) に戻し, プレイヤーを動かせるようにする, サンドウォーム戦の後に呼ばれる
Scr_OnSandwormDefeated() {
	Command(Cmd_C15E, .n = (u16)0xF5EB, .o = [0, 0, 0], .f = 30);
	Command(Cmd_UnlockPlayer);
}

// 0x08D2970A, サーペントの能力値を scratch に用意する, p0: 種類
