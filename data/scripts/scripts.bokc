			Command(Cmd_GetItem, .i = 40);
		}
		case 5: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkDeath));
			Command(Cmd_GetItem, .i = 41);
		}
		case 6: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTemperance));
			Command(Cmd_GetItem, .i = 42);
		}
		case 7: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTheDevil));
			Command(Cmd_GetItem, .i = 43);
		}
		case 8: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTheTower));
			Command(Cmd_GetItem, .i = 44);
		}
		case 9: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTheStar));
			Command(Cmd_GetItem, .i = 45);
		}
		case 10: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTheMoon));
			Command(Cmd_GetItem, .i = 46);
		}
		case 11: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkTheSun));
			Command(Cmd_GetItem, .i = 47);
		}
		case 12: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LinkJudgement));
			Command(Cmd_GetItem, .i = 48);
		}
	}
	LINK_BATTLE_POINT = LINK_BATTLE_POINT - (u8)100;
	Command(Cmd_SetMessageWindowVar, 3, LINK_BATTLE_POINT);
	Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
