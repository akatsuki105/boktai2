}

// 0x08D8A00B, 設定するかの選択の結果, p0: 選択
Scr_TimeHousePinSetAnswer() {
	if (p0 < 0) {
		Scr_EndInteractMsg();
	} else {
		if (p0 == 0) {
			Command(Cmd_CloseMessageWindow);
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_0722));
			Scr_OpenMsgWindow(3, (u24)Scr_TimeHousePinSetInput, 0);
		} else {
			Scr_EndInteractMsg();
		}
	}
}

// 0x08D8A059, 設定する暗証番号を1桁ずつ選ぶ選択肢
Scr_TimeHousePinSetInput() {
	Command(Cmd_CloseMessageWindow);
	if (S_PIN_DIGIT_IDX == 0) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_OpenChoiceCancelable((u16)12401, (u24)Scr_0x0DD7, 0, 0);
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_070F));
		});
	} else if (S_PIN_DIGIT_IDX == 1) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)12402, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0710));
		});
	} else if (S_PIN_DIGIT_IDX == 2) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)12403, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F4)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0711));
		});
	} else if (S_PIN_DIGIT_IDX == 3) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)12404, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F5)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
			Scr_SetPinDigitExtend(2, *((u8 *)(scratch + 0x1F5)));
