			Command(Cmd_5D74, .n = (u16)0x7A2B, .r = [3, 0]);
			Command(Cmd_MovePlayerTo, .p = [(s16)960, (s16)256, (s16)1408], .d = 3, .e = (u24)Scr_Nop);
			Chara(Cmd_Delay, (u16)0x9206, .t = 20, .e = {
				Command(Cmd_7843, .d = 3, .e = (u24)Scr_Nop);
			});
			Command(Cmd_MoveGenericObjUnit, .n = (u16)0x40FD, .p = [0, (s16)-15, 0], .f = 1);
			Command(Cmd_ShowGenericObjUnit, .n = (u16)0x40FD);
