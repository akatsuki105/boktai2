// 0x08D66AFF, クロスオーバーポイントと交換で渡す防具を進行度別の候補から1つ選んで返す, 未入手のものを優先する
Scr_PickCrossoverArmor() {
	S_ARMOR_CANDIDATE_COUNT = 0;
	if ({ Scr_0x024E(33); } == 0 && S_ARMOR_CANDIDATE_COUNT < 6) {
		W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = 33;
