		Command(Cmd_BackupState, *((s16 *)(stat + 0x256)));
		if (PLAYER_ACTION == 6 || W_UNK_051_2 == 1 || S_UNK_017_1 == 1) {
			Command(Cmd_SetCoffinMapSpot, .f = p6);
			Command(Cmd_SetCoffinStage, .s = STAGE_ID);
			Command(Cmd_BackupState, *((s16 *)(stat + 0x258)));
			Command(Cmd_BackupState, *((s16 *)(stat + 0x25A)));
		}
	});
}

// 0x08D1B3D9, マップ入場時の特別な場面 (ダンジョンタイトルなど) を出しているかを返す
Scr_IsMapEntryScene() {
	if (S_UNK_014_0 == 0) {
		return 0;
	} else {
		return 1;
	}
}

// 0x08D1B3FC, マップフラグ (stat + 0x934, MPF_*) に p0 を立てる
Scr_SetMapFlags() {
	if ((MAP_FLAGS & 2) == 0) {
		S_UNK_017_7 = 1;
	}
	MAP_FLAGS = MAP_FLAGS | p0;
}

// 0x08D1B426, マップフラグから p0 を落とす
Scr_ClearMapFlags() {
	S_UNK_017_7 = 0;
	MAP_FLAGS = MAP_FLAGS & ~(p0);
}

// 0x08D1B441, マップのパレット管理を作る, p0: 基本の BG パレット, p1/p2: 時間帯で混ぜるパレット (0 なら p0 のみ)
Scr_CreateBgPlttController() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	v4 = 2;
	v5 = 2;
	if (S_SPAN_OF_TIME == 0) {
		v4 = 2;
		v5 = 2;
	} else if (S_SPAN_OF_TIME == 1) {
		v4 = 2;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 2) {
		v4 = 0;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 3) {
		v4 = 0;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 4) {
		v4 = 0;
		v5 = 1;
	} else if (S_SPAN_OF_TIME == 5) {
		v4 = 1;
		v5 = 2;
	}
	v6 = 1;
	if (p0 == 0) {
		v1 = (u16)0x805D;
	} else {
		v1 = p0;
	}
	if (p1 == 0) {
		v2 = p0;
		v6 = 0;
	} else {
		v2 = p1;
	}
	if (p2 == 0) {
		v3 = p0;
		v6 = 0;
	} else {
		v3 = p2;
	}
	Chara(BgPlttController_Create, (u16)0xE231, .f = v6, .c = v4, .m = v5, .p = [v1, v2, v3]);
}

// 0x08D1B564, p0 のゾーンにいる間, 太陽が当たっているかどうかで BG パレットを差し替える仕掛けを作る (BgPlttController 0x317B)
Scr_CreateSunlitBgPltt() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME <= 2) {
		v1 = 0;
		v2 = p1;
		v3 = p2;
	} else if (S_SPAN_OF_TIME == 3) {
		v1 = 1;
		v2 = p3;
		v3 = p4;
	} else {
		v1 = 2;
		v2 = p5;
		v3 = p6;
	}
	Chara(BgPlttController_Create, (u16)0x317B, .f = 2, .c = v1, .m = v1, .p = [p2, p4, p6], .a = [0, 0, 8, 0, 0, 0]);
	S_UNK_04E_0 = 0;
	S_UNK_04E_1 = 0;
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x1517, .w = v1, .s = [p1, p2, p3, p4], .e = {
		if ({ Command(Cmd_GetSolarGauge); } < 1) {
			if (S_UNK_04E_0 == 1) {
				S_UNK_04E_0 = 0;
				Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
				if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME <= 2) {
					Command(Cmd_SetBgPlttFile, .i = 0, .n = p11, .f = 1);
				} else if (S_SPAN_OF_TIME == 3) {
					Command(Cmd_SetBgPlttFile, .i = 1, .n = p13, .f = 1);
				}
			}
		} else {
			if (S_UNK_04E_0 == 0) {
				S_UNK_04E_0 = 1;
				Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
				if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME <= 2) {
					Command(Cmd_SetBgPlttFile, .i = 0, .n = p10, .f = 1);
				} else if (S_SPAN_OF_TIME == 3) {
					Command(Cmd_SetBgPlttFile, .i = 1, .n = p12, .f = 1);
				}
			}
		}
	});
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x1517, .s = [p5, p6], .e = {
		if ({ Command(Cmd_GetSolarGauge); } < 1) {
			if (S_UNK_04E_1 == 1) {
				S_UNK_04E_1 = 0;
				if (S_SPAN_OF_TIME >= 4 && S_SPAN_OF_TIME <= 5 || S_SPAN_OF_TIME == 0) {
					Command(Cmd_SetBgPlttFile, .i = 2, .n = p11, .f = 1);
				}
			}
		} else {
			if (S_UNK_04E_1 == 0) {
				S_UNK_04E_1 = 1;
				if (S_SPAN_OF_TIME >= 4 && S_SPAN_OF_TIME <= 5 || S_SPAN_OF_TIME == 0) {
					Command(Cmd_SetBgPlttFile, .i = 2, .n = p10, .f = 1);
				}
			}
		}
	});
}

