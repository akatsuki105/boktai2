	}
	if (W_TITLE_EARNED(3) == 1) {
		Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_LibraryTitleFistMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(4) == 1) {
		Command(Cmd_SetMessageWindowExtend, 4, StringRef(Str_LibraryTitleGunMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 4, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(5) == 1) {
		Command(Cmd_SetMessageWindowExtend, 5, StringRef(Str_LibraryTitleAdept));
	} else {
		Command(Cmd_SetMessageWindowExtend, 5, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(6) == 1) {
		Command(Cmd_SetMessageWindowExtend, 6, StringRef(Str_LibraryTitleDayWalker));
	} else {
		Command(Cmd_SetMessageWindowExtend, 6, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(7) == 1) {
		Command(Cmd_SetMessageWindowExtend, 7, StringRef(Str_LibraryTitleAdventurer));
	} else {
		Command(Cmd_SetMessageWindowExtend, 7, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(8) == 1) {
		Command(Cmd_SetMessageWindowExtend, 8, StringRef(Str_LibraryTitleAgent));
	} else {
		Command(Cmd_SetMessageWindowExtend, 8, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(9) == 1) {
		Command(Cmd_SetMessageWindowExtend, 9, StringRef(Str_LibraryTitleCollector));
