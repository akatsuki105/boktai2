// 0x08D670A4
Scr_0x0A0E() {
	S_ARMOR_DEX_IDX = 0;
	S_OWNED_ARMOR_IDX = 0;
	S_PICKED_OWNED_ARMOR = 0;
	Command(Cmd_ForEach, .a = 0, .r = 36, .d = 0, .e = {
		if ({ Scr_IsArmorObtained(S_ARMOR_DEX_IDX); } == 1) {
			if (S_OWNED_ARMOR_PICK == S_OWNED_ARMOR_IDX) {
				S_PICKED_OWNED_ARMOR = S_ARMOR_DEX_IDX;
			}
			S_OWNED_ARMOR_IDX = S_OWNED_ARMOR_IDX + 1;
		}
		S_ARMOR_DEX_IDX = S_ARMOR_DEX_IDX + 1;
	});
	return S_PICKED_OWNED_ARMOR;
}

