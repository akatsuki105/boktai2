// 0x08D1C004
Scr_0x00DA() {
	if (BIT(scratch + 0x17, 7) && { Scr_0x00DB(); } == 0 && { Command(Cmd_GetSolarGauge); } >= 2 && BIT(scratch + 0x14, 3) == 0) {
		if ({ Command(Cmd_GetSolarGauge); } < 4) {
			Scr_FadeScreen(4, 1, 16);
		} else if ({ Command(Cmd_GetSolarGauge); } < 6) {
			Scr_FadeScreen(4, 1, 32);
		} else if ({ Command(Cmd_GetSolarGauge); } < 8) {
			Scr_FadeScreen(4, 1, (u8)64);
		} else {
			Scr_FadeScreen(4, 1, (u8)128);
		}
	} else {
		Scr_FadeScreen(4, S_MAP_FADE_COLOR, S_MAP_FADE_FRAMES);
	}
	BIT(scratch + 0x17, 7) = 0;
}

