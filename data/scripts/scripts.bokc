	} else if (S_SMITH_LICENSE_TYPE == 2 || S_SMITH_LICENSE_TYPE == 5) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_GetClubCrest));
		Command(Cmd_GetItem, .i = 54);
	}
	Scr_OpenMsgWindow(3, (u24)Scr_0x0ACC, 0);
	Scr_SetMsgWindowScripts((u24)Scr_0x0ACC, (u24)Scr_0x0ACB);
}

