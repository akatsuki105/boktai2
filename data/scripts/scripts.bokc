// 0x08D69B26
Scr_0x172A() {
	if ({ Scr_IsNight(); } == 1 && FRIENDSHIP(1) > 0) {
		if (PLAYER_KIND == 0) {
			return 3;
		} else if (PLAYER_KIND == 1 && FRIENDSHIP(1) >= 2) {
			return 3;
