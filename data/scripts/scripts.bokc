// 0x08D761E1, "ハテナ"の選択肢を出して Scr_HatenaChat に渡す
Scr_HatenaChatPrompt() {
	DebugPrint("はてな　選択肢");
	Chara(Cmd_Delay, (u16)0x5F25, .t = 10, .e = {
