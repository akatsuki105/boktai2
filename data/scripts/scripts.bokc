Scr_SensorGuide() {
	switch (W_SENSOR_GUIDE_STATE) {
		case 0: {
			W_SENSOR_GUIDE_STATE = 1;
			S_UNK_014_6 = 0;
			S_UNK_014_7 = 0;
			W_CURRENT_BGM = 0;
			S_UNK_202 = 0;
			Scr_0x0F51();
		}
		case 1: {
			W_SENSOR_GUIDE_STATE = 2;
			Chara(MoverList_Create, (u16)0xB8B9);
			if (W_SENSOR_GUIDE_MODE == 2 && W_SENSOR_GUIDE_STEP % 5 == 0) {} else {
				Chara(Cmd_Delay, (u16)0x4775, .t = 1, .e = {
					if (S_UNK_202 == 0 && { Command(Cmd_GetInputKeys); } & 9) {
						S_UNK_202 = 1;
						Scr_0x0F53();
						return 1;
					}
				});
			}
			if (W_SENSOR_GUIDE_MODE > 0 && W_SENSOR_GUIDE_STEP % 5 == 0) {
				if (W_SENSOR_GUIDE_MODE == 2) {
					v1 = 30;
				} else {
					v1 = (u8)90;
				}
			} else {
				v1 = 60;
			}
			Chara(Cmd_Delay, (u16)0xF8DF, .t = v1, .e = {
				if (S_UNK_202 == 0) {
					Scr_0x0F51();
				}
			});
		}
		case 2: {
			W_SENSOR_GUIDE_STATE = 1;
			if (W_SENSOR_GUIDE_MODE > 0 && W_SENSOR_GUIDE_STEP % 5 == 0) {
				Scr_PlayBgm(4, (u8)167);
			}
			Mesg(0x4775, (u16)0xFFFF);
			Mesg(0xF8DF, (u16)0xFFFF);
			Chara(ObjPlttController_Create, (u16)0x48F7);
			Chara(BgPlttController_Create, (u16)0x317B, .f = 0, .c = 0, .m = 0, .p = (u16)0xC486);
			Chara(MenuMessageManager_Create, (u16)0x6273);
			Chara(MessageWindow_Create, (u16)0x0E37, .r = [1, 3, 28, 6]);
			Chara(MainMenu_Create, (u16)0xCC28, .i = StringRef(Str_StartMenuItems), .w = StringRef(Str_StartMenuWeapons), .a = StringRef(Str_StartMenuArmors), .m = StringRef(Str_StartMenuMagics), .A = StringRef(Str_AreaName), .l = StringRef(Str_053B), .E = StringRef(Str_StartMenuMisc), .e = StringRef(gExpTable));
			Scr_BeginEvent(0);
			if (W_SENSOR_GUIDE_MODE > 0) {
				if (W_SENSOR_GUIDE_PAGE == 1 || W_SENSOR_GUIDE_PAGE == 2 || W_SENSOR_GUIDE_PAGE == 3 || W_SENSOR_GUIDE_PAGE == 4 || W_SENSOR_GUIDE_PAGE == 9 || W_SENSOR_GUIDE_PAGE == 12) {
					Command(Cmd_ConfigureMessageWindow, .r = [1, 3, 28, 6]);
				} else {
					Command(Cmd_ConfigureMessageWindow, .r = [1, 4, 28, 6]);
					Scr_0x0F57();
				}
				Command(Cmd_SetMessageWindowInstant, 0);
				Chara(SensorGuide_Create, (u16)0xB87B, .i = W_SENSOR_GUIDE_PAGE, .m = [(W_SENSOR_GUIDE_PAGE * 2), 2], .c = (s16)360, .r = StringRef(Str_0002), .p = (u24)Scr_SensorGuideNext);
			} else {
				Command(Cmd_ConfigureMessageWindow, .r = [1, 3, 28, 6]);
				Command(Cmd_SetMessageWindowInstant, 0);
				Chara(SensorGuide_Create, (u16)0xC5C5, .i = 0, .m = [0, 2], .c = (s16)450, .r = StringRef(Str_0002), .p = (u24)Scr_SensorGuideNext);
