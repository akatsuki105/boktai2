// 0x08D696A0, 時間帯で変わるリタのお礼
Scr_RitaAfterShopByTime() {
	Command(Cmd_GetDateTime, S_YEAR, S_MONTH, S_DAY, S_HOUR, S_MINUTE, S_SECOND);
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME2);
	if (S_SPAN_OF_TIME2 == 4 || S_SPAN_OF_TIME2 == 5 || S_SPAN_OF_TIME2 == 0) {
		if (W_STORY_PROGRESS >= 46) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_RitaShopThanksD));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
			Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x0219);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_RitaShopThanksC));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
			Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x0219);
		}
	} else {
		if (S_HOUR < 12) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_RitaShopThanksA));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
			Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x024A);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_RitaShopThanksB));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		}
	}
}

