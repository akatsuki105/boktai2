			PLAYER_Z = (s16)1152;
			Chara(Player_Create, (u16)0xF5EB);
			Command(Cmd_LockPlayer, .d = 7);
			Command(Cmd_ClearAllBadConds);
			Command(Cmd_RemoveGoodCond);
			Scr_0x0369();
			switch (TORTURE_COUNT % 5) {
				case 1: {
					Scr_0x0362(1);
					S_TORTURE_PATTERN = 0;
				}
				case 2: {
					Scr_0x0362(2);
					S_TORTURE_PATTERN = 1;
				}
				case 3: {
					Scr_0x0362(3);
					S_TORTURE_PATTERN = 2;
				}
				case 4: {
					Scr_0x0362(4);
					S_TORTURE_PATTERN = 3;
				}
				default: {
					Scr_0x0362(1);
					S_TORTURE_PATTERN = 0;
				}
			}
			switch (TORTURE_COUNT % 5) {
				case 1: {
					v1 = 4;
					v2 = 0;
				}
				case 2: {
					v1 = 1;
					v2 = 0;
				}
				case 3: {
					v1 = 3;
					v2 = 0;
				}
				case 4: {
					v1 = 0;
					v2 = 0;
				}
				default: {
					v1 = 10;
					v2 = 0;
				}
			}
			if (W_UNK_1C5 < (u8)250) {
				W_UNK_1C5 = W_UNK_1C5 + 1;
			} else {
				W_UNK_1C5 = 0;
			}
			Chara(Torture_Create, (u16)0x963D, .r = (u8)100, .a = [(s16)10800, (s16)1000, (u24)Scr_DarkLoanPunishTimeUp], .N = 4, .p = S_TORTURE_PATTERN, .e = (u24)Scr_DarkLoanPunishEnd);
			Command(Cmd_AddEntity3117Entry, .n = (u16)13510, .t = (u16)3550, .i = 0, .p = [(s16)1664, (s16)256, (s16)896], .f = 1, .R = 2, .m = [(u16)34799, 1, 0], .P = 32, .o = 1, .s = 1);
