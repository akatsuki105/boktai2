// 0x08D64660, 太陽街 (0x09C4) のスミレの会話の入口
Scr_TalkSumire() {
	if (W_STORY_PROGRESS >= 48 && W_STORY_PROGRESS < 51 && W_KURO_EVENT_STEP == 0) {
		W_KURO_EVENT_STEP = 2;
		Scr_0x10C0();
	} else {
		if (PLAYER_KIND == 5 && BIT(world + 0x5A, 0) == 0) {
			Scr_BeginEventLockPlayer();
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Sumire_1062));
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
			BIT(world + 0x5A, 0) = 1;
		} else if (W_STORY_PROGRESS >= 35 && W_STORY_PROGRESS < 46 && BIT(world + 0x5A, 2) == 0) {
			Scr_BeginEventLockPlayer();
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Sumire_0FF5));
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
			BIT(world + 0x5A, 2) = 1;
			Scr_AddFriendship(2, 1);
		} else if (BIT(world + 0x51, 7) == 0 && W_STORY_PROGRESS < 28) {
			Scr_BeginEventLockPlayer();
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Sumire_0FF8));
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
			BIT(world + 0x51, 7) = 1;
		} else if (W_WAREHOUSE_LEVEL == 0 && { Command(Cmd_HasItem, .i = (u8)64); } == 1) {
			S_CUTSCENE_STEP = 0;
			Scr_AddFriendship(2, 1);
			if (W_STORY_PROGRESS < 32) {
				Scr_0x10B9();
			} else {
				Scr_0x10BA();
			}
		} else {
			Scr_0x09E3();
		}
	}
}

