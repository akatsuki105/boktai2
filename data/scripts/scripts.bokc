}

// 0x08D63EDA
Scr_0x09CE() {
	S_EVENT_STEP = 0;
	Chara(Cmd_Delay, (u16)0x5F25, .a = 0, .t = 2, .e = {
		switch (S_EVENT_STEP) {
			case 0: {
				S_EVENT_STEP = S_EVENT_STEP + 1;
				return 60;
			}
			case 1: {
				S_EVENT_STEP = S_EVENT_STEP + 1;
				Command(Cmd_PlaySound, .i = (u8)154);
				return 30;
			}
			case 2: {
				S_EVENT_STEP = S_EVENT_STEP + 1;
				Command(Cmd_PlaySound, .i = (s16)729);
				return 38;
			}
			case 3: {
				S_EVENT_STEP = 0;
				Scr_PlayBgm(4, (u8)156);
				Scr_FadeScreenEx(2, 0, (u8)64, 65535, 0, (u24)Scr_ZajiReadBirthplace);
			}
		}
	});
}

// 0x08D63F98, 星読みで出身地を当てる, 前作との連動があればランクの星読みへ
Scr_ZajiReadBirthplace() {
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Zaji_13EE));
	if (*((s16 *)(stat + 0x8)) != 0) {
		Scr_OpenMsgWindow(3, (u24)Scr_ZajiReadBoktai1Rank, 0);
	} else {
		Scr_OpenMsgWindow(3, (u24)Scr_ZajiStarReadingBoast, 0);
	}
}

// 0x08D63FCE, 星読みで前作 (イストラカン) のランクを当てる
Scr_ZajiReadBoktai1Rank() {
	switch (*((s16 *)(stat + 0xC))) {
		case 0: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1S));
		}
		case 1: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1APlus));
		}
		case 2: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1A));
		}
		case 3: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1AMinus));
		}
		case 4: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1BPlus));
		}
		case 5: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1B));
		}
		case 6: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1BMinus));
		}
		case 7: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1CPlus));
		}
		case 8: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1C));
		}
		case 9: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_ZajiBok1CMinus));
		}
	}
	Scr_OpenMsgWindow(3, (u24)Scr_ZajiStarReadingBoast, 0);
}

// 0x08D640AE, 「図星やろ?」
Scr_ZajiStarReadingBoast() {
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Zaji_1405));
	Scr_OpenMsgWindow(3, (u24)Scr_ZajiStarReadingPrompt, 0);
}

// 0x08D640C7, 星読みの感想の選択肢 (恐ろしい/すごい)
Scr_ZajiStarReadingPrompt() {
	Chara(Cmd_Delay, (u16)0x5F25, .t = 10, .e = {
		Scr_OpenChoiceNoCancel((u16)15388, (u24)Scr_ZajiStarReadingAnswer, 0, 0);
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Zaji_1407));
	});
}

// 0x08D640F8, 感想の選択で好感度が上下する, p0: 選択
Scr_ZajiStarReadingAnswer() {
	if (p0 < 0) {
		Scr_0x09D4();
	} else if (p0 == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Zaji_1409));
		Scr_OpenMsgWindow(3, (u24)Scr_0x09D5, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x09D5, (u24)Scr_0x0241);
		Scr_AddFriendship(0, -1);
	} else if (p0 == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Zaji_140C));
		Scr_OpenMsgWindow(3, (u24)Scr_0x09D4, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x09D4, (u24)Scr_0x021A);
		Scr_AddFriendship(0, 1);
	}
}

