			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Sumire_1007));
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		}
	} else {
		Scr_EndEventCloseMsg();
	}
	S_SUMIRE_TOWN_TALK_COUNT = S_SUMIRE_TOWN_TALK_COUNT + 1;
}

