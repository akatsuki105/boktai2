	Chara(MsgBus_Create, (u16)0x4E69);
	Chara(Entity730A_Create, (u16)0x730A);
	Chara(EntityD3A9_Create, (u16)0x74E2);
	if (STAGE_ID == 8) {
		Chara(GameOverManager_Create, (u16)0xFB8C, .p = (u24)Scr_0x016F, .c = [0, 0], .r = StringRef(Str_1603));
	} else {
		Chara(GameOverManager_Create, (u16)0xFB8C, .p = (u24)Scr_0x016F, .c = [(u8)200, (u8)100], .r = StringRef(Str_1605));
	}
	Chara(Taiyo_Create, (u16)0x2D36);
	Chara(MoverList_Create, (u16)0xB8B9);
	Chara(CWolfTargetManager_Create, (u16)0x5941);
	Chara(Entity6978_Create, (u16)0x48F7);
	Chara(EnemyManager_Create, (u16)0x3C77);
	Chara(EnemyTargetManager_Create, (u16)0xD751);
	Chara(Cmd_5CCC, (u16)0x5CCC);
	Chara(Entity794C_Create, (u16)0x794C);
	Chara(LevelUpper_Create, (u16)0xB164, .e = StringRef(gExpTable));
	Chara(Marquee_Create, (u16)0xDFC6);
	Chara(TextPanelManager_Create, (u16)0x6273);
	Chara(ArrowManager_Create, (u16)0xD852);
