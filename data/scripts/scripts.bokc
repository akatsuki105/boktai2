// 0x08D88876, 入力した暗証番号を照合し, 解錠するか不一致を表示する
Scr_TimeHousePinCheck() {
	v1 = 0;
	if (W_CURRENT_STAGE_EVENT_FLAGS(1) == 0) {
		v1 = 0;
	} else {
		if (*((u8 *)(world + 0x1F6)) == *((u8 *)(scratch + 0x1F3)) && *((u8 *)(world + 0x1F7)) == *((u8 *)(scratch + 0x1F4)) && *((u8 *)(world + 0x1F8)) == *((u8 *)(scratch + 0x1F5)) && *((u8 *)(world + 0x1F9)) == *((u8 *)(scratch + 0x1F6))) {
			v1 = 1;
		}
	}
	S_PIN_MATCHED = v1;
	Command(Cmd_CloseMessageWindow);
	Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
	Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
	Scr_SetPinDigitExtend(2, *((u8 *)(scratch + 0x1F5)));
	Scr_SetPinDigitExtend(3, *((u8 *)(scratch + 0x1F6)));
	if (v1 == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_070B));
		Scr_0x0194();
	} else {
		S_PIN_DIGIT_IDX = 0;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_070D));
		Scr_0x0195();
	}
	S_UNK_014_4 = 0;
	Scr_OpenMsgWindow(3, (u24)Scr_EndInteractMsg, 0);
}

