// 0x08D1FF8A, BGM を切り替える, 今と違う曲ならフェードアウトしてから鳴らす, p0: フェード時間 (0 なら即座), p1: 曲
Scr_PlayBgm() {
	if (BIT(scratch + 0x14, 7) == 1) {} else if (BIT(scratch + 0x14, 6) == 1) {
		Command(Cmd_E6F2, .f = 0);
	} else if (p0 == 0) {
		S_CURRENT_BGM = p1;
		if (W_PREV_BGM != W_CURRENT_BGM) {
			W_PREV_BGM = W_CURRENT_BGM;
		}
		W_CURRENT_BGM = p1;
		Command(Cmd_PlayBGM, .i = p1);
	} else {
		if (p1 != W_CURRENT_BGM && W_CURRENT_BGM) {
			Mesg(0xE431, (u16)65535);
			Chara(Cmd_Delay, (u16)0x5F25, .a = [p0, p1], .t = 2, .e = {
				if (p1) {
					Command(Cmd_FadeOutBGMTemporarily, .f = p0);
					Command(Cmd_4CBB, .f = p0);
				} else {
					Command(Cmd_FadeOutBGM, .f = p0);
					Command(Cmd_E6F2, .f = p0);
				}
				Chara(Cmd_Delay, (u16)0xE431, .a = p1, .t = (p0 * 16 + 2), .e = {
					S_CURRENT_BGM = p0;
					if (W_PREV_BGM != W_CURRENT_BGM) {
						W_PREV_BGM = W_CURRENT_BGM;
					}
					W_CURRENT_BGM = p0;
					Command(Cmd_PlayBGM, .i = p0);
				});
			});
		} else {
			S_CURRENT_BGM = p1;
			if (W_PREV_BGM != W_CURRENT_BGM) {
				W_PREV_BGM = W_CURRENT_BGM;
			}
			W_CURRENT_BGM = p1;
			Command(Cmd_PlayBGM, .i = p1);
		}
	}
}

