}

// 0x08D76229, "ハテナ"との会話
Scr_HatenaChat() {
	if (p0 < 0) {
		Scr_EndEventCloseMsg();
	} else if (p0 == 0) {
		if ({ Command(Cmd_GetBankBalance); } >= (u8)200) {
			BIT(world + 0x7A, 6) = 1;
			if (W_BLIND_BOX_AREA == 0) {
				W_BLIND_BOX_SPOT = { Scr_0x1A4D(); };
			} else {
				W_BLIND_BOX_SPOT = { Scr_0x1A4E(); };
			}
			Command(Cmd_SetBankBalance, .a = ({ Command(Cmd_GetBankBalance); } - (u8)200));
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaBBOpen));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0BE7, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaBBNoMoney));
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		}
	} else if (p0 == 1) {
		if (LAP >= 1) {
			if (BIT(world + 0x7A, 4) == 0) {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Hatena_13B7));
				Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
				BIT(world + 0x7A, 4) = 1;
			} else {
				Scr_HatenaSmallTalkNewGamePlus();
			}
		} else {
			if (W_STORY_PROGRESS >= 62 && LAP == 0) {
				Scr_HatenaSmallTalkEndgame();
			} else {
				Scr_HatenaSmallTalk();
			}
		}
	}
}

