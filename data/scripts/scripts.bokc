Scr_TimeHousePinSetTerminal() {
	if (W_DUNGEON_EVENT_FLAGS(0) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_071D));
		BIT(scratch + 0x14, 4) = 0;
