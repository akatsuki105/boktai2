// 0x08D63700, プレイヤーの向きの1マス先におてんこを置く
Scr_SpawnOtenko() {
	if (W_STORY_PROGRESS < 32) {
		S_UNK_175;
		if (W_UNK_186 == (u8)170) {
			S_ACTOR_POS_X = (s16)4928;
			S_ACTOR_POS_Y = PLAYER_Y;
			S_ACTOR_POS_Z = (s16)1664;
			S_ACTOR_ANGLE = (u8)192;
		} else {
			if (SUN_ANGLE == (u8)192) {
				DebugPrint("おてんこ設定　方向 北");
				S_ACTOR_POS_X = PLAYER_X;
				S_ACTOR_POS_Z = PLAYER_Z + (u8)128;
			} else if (SUN_ANGLE == 0) {
				DebugPrint("おてんこ設定　方向 東");
				S_ACTOR_POS_X = PLAYER_X - (u8)128;
				S_ACTOR_POS_Z = PLAYER_Z;
			} else if (SUN_ANGLE == (u8)64) {
				DebugPrint("おてんこ設定　方向 南");
				S_ACTOR_POS_X = PLAYER_X;
				S_ACTOR_POS_Z = PLAYER_Z - (u8)128;
			} else if (SUN_ANGLE == (u8)128) {
				DebugPrint("おてんこ設定　方向 西");
				S_ACTOR_POS_X = PLAYER_X + (u8)128;
				S_ACTOR_POS_Z = PLAYER_Z;
			} else {
				S_ACTOR_POS_X = PLAYER_X + (u8)128;
				S_ACTOR_POS_Z = PLAYER_Z;
			}
			S_ACTOR_POS_Y = PLAYER_Y;
			S_ACTOR_ANGLE = SUN_ANGLE;
		}
		Command(Cmd_BB34, .n = (u16)40190, .p = [S_ACTOR_POS_X, S_ACTOR_POS_Y, S_ACTOR_POS_Z], .d = S_ACTOR_ANGLE, .w = [(s16)256, (s16)256, (s16)512], .t = (u24)Scr_0x09C6, .H = [4, 4], .i = 2);
	}
}

