// 0x08D71D12, 太陽樹の朝露
Scr_MorningDew() {
	DebugPrint("カウンタ", S_EVENT_STEP);
	switch (S_EVENT_STEP) {
		case 0: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			Command(Cmd_LockPlayer);
			Scr_BeginEvent(0);
			Command(Cmd_SetHUDMode, .m = 7);
			Scr_MorningDew();
		}
		case 1: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			DebugPrint("プレイヤーカーモス状態", ({ Command(Cmd_IsKaamos); }));
			BIT(scratch + 0x18F, 6) = { Command(Cmd_IsKaamos); };
			Scr_CloseMsgWindow();
			Chara(Entity4F5C_Create, (u16)0xC6EE, .e = (u24)Scr_MorningDew);
		}
		case 2: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			BIT(scratch + 0x14, 4) = 0;
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MorningDew));
			Scr_OpenMsgWindow(3, (u24)Scr_MorningDew, 0);
		}
		case 3: {
			DebugPrint("\x09\x09\x09\x09\x09\x09\x09●回復");
			Command(Cmd_LockPlayer);
			DebugPrint("プレイヤーカーモス状態", ({ Command(Cmd_IsKaamos); }));
			if (BIT(scratch + 0x18F, 6) != 0) {
				S_EVENT_STEP = 4;
			} else if ({ Command(Cmd_HasItem, .i = 28); } != 0) {
				S_EVENT_STEP = 5;
			} else {
				S_EVENT_STEP = 6;
			}
			Chara(MorningDew_Create, (u16)0xECA5, .l = 1, .e = 1, .p = (u24)Scr_Nop);
			Command(Cmd_PlayTrackedSound, .i = (s16)291);
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MorningDewRecover));
			Scr_OpenMsgWindow(3, (u24)Scr_MorningDew, 0);
		}
		case 4: {
			DebugPrint("\x09\x09\x09\x09\x09\x09\x09●解呪");
			if ({ Command(Cmd_HasItem, .i = 28); } != 0) {
				S_EVENT_STEP = S_EVENT_STEP + 1;
			} else {
				S_EVENT_STEP = 6;
			}
			Command(Cmd_PlayTrackedSound, .i = (s16)291);
			Command(Cmd_RemoveKaamos, .i = 0);
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MorningDewCurseRemoved));
			Scr_OpenMsgWindow(3, (u24)Scr_MorningDew, 0);
		}
		case 5: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			DebugPrint("\x09\x09\x09\x09\x09\x09\x09●浄化");
			Command(Cmd_RemoveItem, .i = 28);
			Command(Cmd_GetItem, .i = 27);
			Command(Cmd_PlayTrackedSound, .i = (s16)291);
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0136));
			Scr_OpenMsgWindow(3, (u24)Scr_MorningDew, 0);
		}
		case 6: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			Scr_CloseMsgWindow();
			Command(Cmd_PlayTrackedSound, .i = (s16)668);
			Chara(Entity99CA_Create, (u16)0xF88D, .p = [PLAYER_X, (PLAYER_Y + (s16)312), PLAYER_Z], .d = (u8)96, .t = (u8)80);
			Chara(Entity99CA_Create, (u16)0xF88E, .p = [PLAYER_X, (PLAYER_Y + (s16)256), PLAYER_Z], .d = (u8)96, .t = (u8)64);
			Chara(Entity99CA_Create, (u16)0xF88F, .p = [PLAYER_X, (PLAYER_Y + (u8)128), PLAYER_Z], .d = (u8)96, .t = 48);
			Chara(Entity99CA_Create, (u16)0xF890, .p = [PLAYER_X, (PLAYER_Y + (u8)64), PLAYER_Z], .d = (u8)96, .t = 32);
			Chara(Cmd_Delay, (u16)0x220D, .t = (u8)80, .e = {
				Scr_MorningDew();
			});
		}
		case 7: {
			S_EVENT_STEP = S_EVENT_STEP + 1;
			BIT(scratch + 0x14, 4) = 1;
			Scr_EndEventCloseMsg();
		}
		default: {}
	}
}

