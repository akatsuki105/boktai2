			Command(Cmd_7B7D, .a = S_EXCHANGE_ARMOR);
			Command(Cmd_2575, 0, StringRef(Str_StartMenuArmors), .i = S_EXCHANGE_ARMOR);
			W_CROSSOVER_ARMOR_COUNT = W_CROSSOVER_ARMOR_COUNT + 1;
			Scr_0x0256((s16)-60);
			Command(Cmd_SetMessageWindowVar, 2, ({ Command(Cmd_GetCrossoverPoint); }));
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_064A));
			Scr_0x00F7(3, (u24)Scr_CrossoverArmorExchange, 0);
		}
		case 1: {
			S_CUTSCENE_STEP = S_CUTSCENE_STEP + 1;
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_064C));
			Scr_0x00F7(3, (u24)Scr_0x0A0F, 0);
		}
		default: {}
	}
}

