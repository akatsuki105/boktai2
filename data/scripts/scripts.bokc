// 0x08D5D2FB, 変異域 B1 のサンドウォームを倒したとき, 閉じ込め戦闘を数え, 全部倒せばエレベーターを動かし W_EARTH_SANDWORM_DEFEATED を立てて宝箱を置く
Scr_OnEarthSandwormDefeated() {
	Scr_OnSandwormDefeated();
	W_UNK_00C_4 = 0;
	S_ROOM_BATTLE_KILLS = S_ROOM_BATTLE_KILLS + 1;
	if (S_ROOM_BATTLE_KILLS >= S_ROOM_BATTLE_TARGET) {
		Scr_CreateElevatorByEntrance((u16)0xD492, 0, 0, 1, 5, 5, 1, 6, 1, 10, 0, 0, 0, (u8)120, 2);
		Command(Cmd_StartElevator, .n = (u16)0xD492, .m = 1);
		Command(Cmd_AE3A, .n = (u16)0xD492, .m = 1);
		Chara(Cmd_Delay, (u16)0x5F25, .t = 60, .e = {
			Scr_EndRoomBattle();
			W_EARTH_SANDWORM_DEFEATED = 1;
			Scr_PlaceChestEx(0, (u8)65, (s16)1280, (s16)1536, 1, 1, 0, 1, 60, (u24)Scr_Nop, 0);
			Scr_PlaceRandomCardChest((s16)1280, (s16)1024, (u8)74, 1);
		});
	} else {}
}

