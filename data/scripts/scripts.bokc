		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F42));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		}
	} else if (W_STORY_PROGRESS >= 46 && W_STORY_PROGRESS < 58) {
		if (BIT(scratch + 0x18F, 3) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F4B));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F50));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		}
	} else if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62) {
		if (BIT(scratch + 0x18F, 3) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F56));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F5A));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		}
	} else if (W_STORY_PROGRESS >= 62) {
		if (BIT(scratch + 0x18F, 3) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F67));
