// 0x08D63700, プレイヤーの向きの1マス先におてんこを置く
Scr_SpawnOtenko() {
	if (W_STORY_PROGRESS < 32) {
		S_UNK_175;
		if (W_ENTRANCE == (u8)170) {
			S_NPC_POS_X = (s16)4928;
			S_NPC_POS_Y = PLAYER_Y;
			S_NPC_POS_Z = (s16)1664;
			S_NPC_ANGLE = (u8)192;
		} else {
			if (SUN_ANGLE == (u8)192) {
				DebugPrint("おてんこ設定　方向 北");
				S_NPC_POS_X = PLAYER_X;
				S_NPC_POS_Z = PLAYER_Z + (u8)128;
			} else if (SUN_ANGLE == 0) {
				DebugPrint("おてんこ設定　方向 東");
				S_NPC_POS_X = PLAYER_X - (u8)128;
				S_NPC_POS_Z = PLAYER_Z;
			} else if (SUN_ANGLE == (u8)64) {
				DebugPrint("おてんこ設定　方向 南");
				S_NPC_POS_X = PLAYER_X;
				S_NPC_POS_Z = PLAYER_Z - (u8)128;
			} else if (SUN_ANGLE == (u8)128) {
				DebugPrint("おてんこ設定　方向 西");
				S_NPC_POS_X = PLAYER_X + (u8)128;
				S_NPC_POS_Z = PLAYER_Z;
			} else {
				S_NPC_POS_X = PLAYER_X + (u8)128;
				S_NPC_POS_Z = PLAYER_Z;
			}
