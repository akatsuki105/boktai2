// 0x08D70560, レディの会話の入口 (称号の達成報告など)
Scr_TalkLady() {
	Scr_BeginEventLockPlayer();
	if ({ Scr_0x01C9(4); } == 2 && BIT(world + 0x74, 6) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_06AF));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B43, 0);
		Scr_0x01C6(4);
	} else if ({ Scr_0x01C8(4); } == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_06B2));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		Scr_0x01C6(4);
	} else if (BIT(world + 0x74, 7) == 0) {
		if ({ Scr_0x0B2B(); } == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_106D));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_1076));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		BIT(world + 0x74, 7) = 1;
	} else if (W_STORY_PROGRESS >= 62 && BIT(world + 0x75, 2) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_1086));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		BIT(world + 0x75, 2) = 1;
	} else if (BIT(world + 0x75, 1) == 0 && LAP >= 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_107E));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		BIT(world + 0x75, 1) = 1;
	} else if (BIT(world + 0x80, 1) == 0 && { Scr_0x0251(); } == 62) {
		BIT(world + 0x80, 1) = 1;
		Scr_0x0B30();
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0656));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B32, 0);
	} else if (BIT(world + 0x80, 2) == 0 && { Scr_0x0253(); } == 57) {
		BIT(world + 0x80, 2) = 1;
		W_TITLE_EARNED(10) = 1;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_065C));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B31, 0);
	} else if (BIT(world + 0x80, 3) == 0 && { Scr_0x0255(); } == 27) {
		BIT(world + 0x80, 3) = 1;
		Scr_0x0B30();
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0668));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B34, 0);
	} else if (BIT(world + 0x80, 4) == 0 && { Scr_0x01F8(); } == 12) {
		Scr_AddFriendship(4, 1);
		BIT(world + 0x80, 4) = 1;
		W_TITLE_EARNED(8) = 1;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0662));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B33, 0);
	} else {
		Scr_LadyMenuPrompt();
	}
}

