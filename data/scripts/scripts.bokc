// 0x08D6E165, 調査記録の本を開く, 全部調査済みなら★
Scr_LibraryResearchRecord() {
	S_IMMORTAL_RESEARCHED = { Scr_0x025A(); };
	S_UNDEAD_RESEARCHED = { Scr_0x025B(); };
	Scr_BeginEventLockPlayer();
	if (S_IMMORTAL_RESEARCHED == 6 && S_UNDEAD_RESEARCHED == 7) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Library_0E74));
	} else {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Library_0E72));
	}
	BIT(scratch + 0x14, 4) = 0;
	Scr_OpenMsgWindow(3, (u24)Scr_LibraryResearchPrompt, 0);
}

// 0x08D6E1D0, イモータル/アンデッドダンジョンの調査数を出して選ばせる
Scr_LibraryResearchPrompt() {
	Scr_OpenChoiceCancelable((u16)56933, (u24)Scr_LibraryResearchAnswer, 0, 0);
	S_IMMORTAL_RESEARCHED = { Scr_0x025A(); };
	S_UNDEAD_RESEARCHED = { Scr_0x025B(); };
	if (S_IMMORTAL_RESEARCHED == 6 && S_UNDEAD_RESEARCHED == 7) {
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Library_0E7A));
	} else if (S_IMMORTAL_RESEARCHED == 6) {
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Library_0E7C));
	} else if (S_UNDEAD_RESEARCHED == 7) {
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Library_0E7E));
	} else {
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Library_0E78));
	}
	Command(Cmd_SetMessageWindowVar, 0, S_IMMORTAL_RESEARCHED);
	Command(Cmd_SetMessageWindowVar, 1, S_UNDEAD_RESEARCHED);
}

// 0x08D6E282, 選んだ種類のダンジョンの一覧を表示する, p0: 選択
Scr_LibraryResearchAnswer() {
	BIT(scratch + 0x14, 4) = 0;
	if (p0 < 0) {
		Scr_0x0B0C();
	} else if (p0 == 0) {
		Scr_LibraryImmortalList();
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Library_0E80));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B0C, 0);
	} else if (p0 == 1) {
		Scr_LibraryUndeadList();
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Library_0E83));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B0C, 0);
