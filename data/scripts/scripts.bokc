// 0x08D671BC, 防具交換の「はい/いいえ」の処理, p0: 選んだ項目 (0 ならバッグに空きがあれば渡す)
Scr_CrossoverArmorChoice() {
	if (p0 < 0) {
		Scr_0x0A0A();
	} else if (p0 == 0) {
		if ({ Command(Cmd_CheckEmptySlotExist, .k = 2, .i = 0); } == 1) {
			DebugPrint("バッグに空きがあるのでアイテム渡す");
			S_CUTSCENE_STEP = 0;
			Scr_CrossoverArmorExchange();
		} else {
			DebugPrint("バッグに空きがないです");
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0650));
			Scr_0x00F7(3, (u24)Scr_0x0A0A, 0);
		}
	} else if (p0 == 1) {
		Scr_0x0A0A();
	}
}

// 0x08D6727A, クロスオーバーポイント 60 で防具を1つもらい, 残りのポイントを表示する
Scr_CrossoverArmorExchange() {
	switch (S_CUTSCENE_STEP) {
		case 0: {
			S_CUTSCENE_STEP = S_CUTSCENE_STEP + 1;
			Command(Cmd_PlayTrackedSound, .i = (s16)291);
			S_EXCHANGE_ARMOR = 0;
			S_EXCHANGE_ARMOR = { Scr_PickCrossoverArmor(); };
			Command(Cmd_7B7D, .a = S_EXCHANGE_ARMOR);
			Command(Cmd_2575, 0, StringRef(Str_StartMenuArmors), .i = S_EXCHANGE_ARMOR);
			W_CROSSOVER_ARMOR_COUNT = W_CROSSOVER_ARMOR_COUNT + 1;
			Scr_AddCrossoverPoint((s16)-60);
			Command(Cmd_SetMessageWindowVar, 2, ({ Command(Cmd_GetCrossoverPoint); }));
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_064A));
			Scr_0x00F7(3, (u24)Scr_CrossoverArmorExchange, 0);
		}
		case 1: {
			S_CUTSCENE_STEP = S_CUTSCENE_STEP + 1;
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_064C));
			Scr_0x00F7(3, (u24)Scr_0x0A0F, 0);
		}
		default: {}
	}
}

