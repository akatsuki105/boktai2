// 0x08D20242, 転移の葉によるダンジョンからの脱出
Scr_Riremito() {
	Scr_BeginEvent(1);
	Command(Cmd_SetHUDMode, .m = 7);
	Scr_FadeScreen(5, 2, (u8)64);
	Command(Cmd_E6F2, .f = 4);
	Chara(Cmd_Delay, (u16)0x5F25, .t = (u8)64, .e = {
		Command(Cmd_CA3D);
		Scr_0x0022();
		W_PREV_PREV_ROOM = W_PREV_ROOM;
		W_PREV_ROOM = ROOM;
		BIT(world + 0xC, 4) = 1;
		switch (STAGE_ID) {
			case 0: {
				Scr_0x001B();
			}
			case 1: {
				Scr_Warp((u24)Scr_f01, (u8)123, 6);
			}
			case 2: {
				Scr_Warp((u24)Scr_f02, (u8)124, 7);
			}
			case 3: {
				Scr_Warp((u24)Scr_f03, (u8)125, 8);
			}
			case 4: {
				Scr_Warp((u24)Scr_f04, (u8)126, 9);
			}
			case 5: {
				Scr_Warp((u24)Scr_f05, (u8)127, 10);
			}
			case 6: {
				Scr_Warp((u24)Scr_f05, (u8)127, 10);
			}
			case 7: {
				Scr_Warp((u24)Scr_f00, (u8)129, 5);
			}
			case 8: {
