				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_11B5));
				Scr_OpenMsgWindow(3, (u24)Scr_SmithGiveLicenseSword, 0);
			} else if ({ Scr_0x0AB9(); } == 1) {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_11B7));
				Scr_OpenMsgWindow(3, (u24)Scr_SmithGiveLicenseSpear, 0);
			} else if ({ Scr_0x0ABA(); } == 1) {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_11B9));
				Scr_OpenMsgWindow(3, (u24)Scr_SmithGiveLicenseHammer, 0);
			}
		}
		case 2: {
			if ({ Scr_0x0AB8(); } == 0) {
				Scr_0x0ABD((u24)Scr_SmithAskLicenseSpear, (u24)Scr_SmithAskLicenseHammer);
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			} else if ({ Scr_0x0AB9(); } == 0) {
				Scr_0x0ABD((u24)Scr_SmithAskLicenseSword, (u24)Scr_SmithAskLicenseHammer);
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			} else if ({ Scr_0x0ABA(); } == 0) {
				Scr_0x0ABD((u24)Scr_SmithAskLicenseSword, (u24)Scr_SmithAskLicenseSpear);
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			}
		}
		case 3: {
			if (S_LICENSE_TALK_COUNT % 3 == 0) {
				Scr_SmithAskLicenseSword();
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			} else if (S_LICENSE_TALK_COUNT % 3 == 1) {
				Scr_SmithAskLicenseSpear();
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			} else if (S_LICENSE_TALK_COUNT % 3 == 2) {
				Scr_SmithAskLicenseHammer();
				S_LICENSE_TALK_COUNT = S_LICENSE_TALK_COUNT + 1;
			}
		}
		default: {
			Scr_EndEventCloseMsg();
		}
	}
}

