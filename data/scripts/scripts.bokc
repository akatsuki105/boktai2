// 0x08D205C3
Scr_0x017D() {
	S_ROOM_BATTLE_CLEAR_STEP = 0;
	Chara(Cmd_Delay, (u16)0x5F25, .a = 0, .t = 2, .e = {
		switch (S_ROOM_BATTLE_CLEAR_STEP) {
			case 0: {
				if (S_ROOM_BATTLE_SHUTTER_COUNT < 1) {
					S_ROOM_BATTLE_CLEAR_STEP = 10;
				} else {
					S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				}
				Scr_EndEvent();
				Scr_BeginEvent(1);
				Command(Cmd_PlayTrackedSound, .i = (u8)165);
				Scr_0x0184((u16)23383, 0, 30, (u24)Scr_Nop);
				return 60;
			}
			case 1: {
				Scr_0x0173((u16)37621, 30);
				S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				return 60;
			}
			case 2: {
				Command(Cmd_D6F7, .n = (u16)37621);
				if (S_ROOM_BATTLE_SHUTTER_COUNT == 1) {
					S_ROOM_BATTLE_CLEAR_STEP = 9;
				} else {
					S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				}
				return 60;
			}
			case 3: {
				Scr_0x0173((u16)37622, 30);
				S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				return 60;
			}
			case 4: {
				Command(Cmd_D6F7, .n = (u16)37622);
				if (S_ROOM_BATTLE_SHUTTER_COUNT == 2) {
					S_ROOM_BATTLE_CLEAR_STEP = 9;
				} else {
					S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				}
				return 60;
			}
			case 5: {
				Scr_0x0173((u16)37623, 30);
				S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				return 60;
			}
			case 6: {
				Command(Cmd_D6F7, .n = (u16)37623);
				if (S_ROOM_BATTLE_SHUTTER_COUNT == 3) {
					S_ROOM_BATTLE_CLEAR_STEP = 9;
				} else {
					S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				}
				return 60;
			}
			case 7: {
				Scr_0x0173((u16)37624, 30);
				S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				return 60;
			}
			case 8: {
				Command(Cmd_D6F7, .n = (u16)37624);
				if (S_ROOM_BATTLE_SHUTTER_COUNT == 4) {
					S_ROOM_BATTLE_CLEAR_STEP = 9;
				} else {
					S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				}
				return 60;
			}
			case 9: {
				S_ROOM_BATTLE_CLEAR_STEP = S_ROOM_BATTLE_CLEAR_STEP + 1;
				Command(Cmd_ResetCamera, .f = 30);
				return 40;
			}
			case 10: {
				if (S_ROOM_MISSION_LINE == 60) {
					Scr_0x017F();
				} else {
					Scr_ShowRoomMission();
				}
				return 0;
			}
			default: {}
		}
	});
}

// 0x08D2083E, 部屋のミッション文 (敵をみな殺しにしろ等) を表示する
Scr_ShowRoomMission() {
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Missions));
