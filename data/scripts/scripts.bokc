		switch (S_PIN_DIGIT_IDX) {
			case 0: {
				*((u8 *)(scratch + 0x1F3)) = p0;
			}
			case 1: {
				*((u8 *)(scratch + 0x1F4)) = p0;
			}
			case 2: {
				*((u8 *)(scratch + 0x1F5)) = p0;
			}
			case 3: {
				*((u8 *)(scratch + 0x1F6)) = p0;
			}
		}
		S_PIN_DIGIT_IDX = S_PIN_DIGIT_IDX + 1;
		if (S_PIN_DIGIT_IDX < 4) {
			Scr_TimeHousePinInput();
		} else {
			Scr_TimeHousePinCheck();
		}
	}
}

