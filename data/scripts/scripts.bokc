}

// 0x08D769DB, "ハテナ"が獲得済みの称号について話す
Scr_HatenaTitleTalk() {
	BIT(scratch + 0x1D8, 1) = 0;
	S_UNK_1E7 = 0;
	BIT(scratch + 0x1D8, 2) = 0;
	S_UNK_1E8 = 0;
	S_EVENT_STEP = 0;
	Command(Cmd_ForEach, .a = 0, .r = 12, .d = 0, .e = {
		if (W_TITLE_EARNED((S_EVENT_STEP)) == 1 && BIT(scratch + 0x1D8, 2) == 0) {
			BIT(scratch + 0x1D8, 2) = 1;
			S_UNK_1E8 = S_EVENT_STEP;
		}
		if (S_EVENT_STEP >= W_HATENA_TITLE_TALK_COUNT) {
			if (W_TITLE_EARNED((S_EVENT_STEP)) == 1 && BIT(scratch + 0x1D8, 1) == 0) {
				BIT(scratch + 0x1D8, 1) = 1;
				S_UNK_1E7 = S_EVENT_STEP;
			}
		}
		S_EVENT_STEP = S_EVENT_STEP + 1;
	});
	if (BIT(scratch + 0x1D8, 1) == 1) {
		DebugPrint("あとはっけん");
		W_HATENA_TITLE_TALK_COUNT = S_UNK_1E7;
	} else {
		DebugPrint("あたまから");
		W_HATENA_TITLE_TALK_COUNT = S_UNK_1E8;
	}
	DebugPrint("ハテナ_称号会話カウンタ      ", W_HATENA_TITLE_TALK_COUNT);
	switch (W_HATENA_TITLE_TALK_COUNT) {
		case 0: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleSwordMaster));
		}
		case 1: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleSpearMaster));
		}
		case 2: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleHammerMaster));
		}
		case 3: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleFistMaster));
		}
		case 4: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleGunMaster));
		}
		case 5: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleAdept));
		}
		case 6: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleDayWalker));
		}
		case 7: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleAdventurer));
		}
		case 8: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleAgent));
		}
		case 9: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleCollector));
		}
		case 10: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleDarkHunter));
		}
		case 11: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_HatenaTitleGrandMaster));
		}
	}
	Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
	W_HATENA_TITLE_TALK_COUNT = W_HATENA_TITLE_TALK_COUNT + 1;
	if (W_HATENA_TITLE_TALK_COUNT >= 12) {
		W_HATENA_TITLE_TALK_COUNT = 0;
	}
}

