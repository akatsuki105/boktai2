		if ({ Scr_0x01D3(); } == 1) {
			BIT(scratch + 0x14, 0) = 1;
			Scr_0x01D4();
		} else {
			BIT(scratch + 0x14, 0) = 0;
			Scr_CreateMapSystems(p0);
		}
	} else {
		BIT(scratch + 0x14, 0) = 0;
		Scr_CreateMapSystems(p0);
	}
}

// 0x08D15062, マップ用の管理エンティティ (MsgBus, 敵管理, メニューなど) を作り, 一時フラグを初期化する
Scr_CreateMapSystems() {
	MAP_FLAGS = MAP_FLAGS | 4;
	MAP_FLAGS = MAP_FLAGS & 6;
