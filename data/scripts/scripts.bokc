	} else if (p0 == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1270));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		Scr_0x00F5((u24)Scr_0x0A68, (u24)Scr_0x0219, (u24)Scr_0x024C);
		Scr_AddFriendship(1, 1);
		BIT(world + 0x6B, 0) = 1;
	} else if (p0 == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1273));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		Command(Cmd_ConfigureMessageWindow, .p = [(u24)Scr_0x0A68, (u24)Scr_0x0219, (u24)Scr_0x0248, (u24)Scr_0x0249]);
		Scr_AddFriendship(1, -1);
		BIT(world + 0x6B, 0) = 1;
	}
}

