// 0x08D1845E, Bin_14F8 の p0 行目からボスの HP ゲージ (bossHP / bossHPMax) を設定する
Scr_SetPileDriverBossHP() {
	BOSS_HP = { Command(Cmd_ReadTable, .r = StringRef(Bin_14F8), .i = (p0 * 8 + 4), .s = 1); };
	BOSS_HP_MAX = { Command(Cmd_ReadTable, .r = StringRef(Bin_14F8), .i = (p0 * 8 + 5), .s = 1); };
}

// 0x08D184AB
Scr_0x004B() {
	if (W_COFFIN_ROOM == (u8)166 || BIT(world + 0x182, 5) == 1) {
		if (W_PILE_DRIVER_STATE == 1) {
			W_PILE_DRIVER_STATE = 2;
		} else {
			if (W_STORY_PROGRESS >= 21 && W_STORY_PROGRESS < 25) {
				Scr_SetPileDriverBossHP(0);
			} else if (W_STORY_PROGRESS >= 32 && W_STORY_PROGRESS < 34) {
				Scr_SetPileDriverBossHP(1);
				W_PILE_DRIVER_STATE = 3;
			} else if (W_STORY_PROGRESS >= 42 && W_STORY_PROGRESS < 45) {
				Scr_SetPileDriverBossHP(2);
				W_PILE_DRIVER_STATE = 2;
			} else if (W_STORY_PROGRESS >= 56 && W_STORY_PROGRESS < 57) {
				Scr_AdvanceStory(57);
				Scr_SetPileDriverBossHP(3);
				W_PILE_DRIVER_STATE = 2;
			} else if (W_STORY_PROGRESS >= 60 && W_STORY_PROGRESS < 61) {
				Scr_AdvanceStory(61);
				Scr_SetPileDriverBossHP(4);
				W_PILE_DRIVER_STATE = 2;
			} else {
				if (W_CROSSOVER_PROGRESS >= 9 && W_CROSSOVER_PROGRESS < 10) {
					Scr_0x0197(10);
					Scr_SetPileDriverBossHP(4);
					W_PILE_DRIVER_STATE = 2;
				}
			}
		}
	}
}

