// 0x08D1BDB8, 画面をフェードする, p0: 2/4 でフェードイン, 3/5 でフェードアウト, p1: 色 (0: 黒, 1: 白, 2: 緑, 3: 赤, 4: 青), p2: フレーム数
Scr_FadeScreen() {
	Scr_FadeScreenEx(p0, p1, p2, (s16)8191, 0, 0);
}

// 0x08D1BDC7, Scr_FadeScreen に終わったら呼ぶスクリプト p3 を足したもの
Scr_FadeScreenThen() {
	Scr_FadeScreenEx(p0, p1, p2, (s16)8191, 0, p3);
}

// 0x08D1BDD6, Scr_FadeScreen の全引数版, p5: 終わったら呼ぶスクリプト
Scr_FadeScreenEx() {
	Scr_SetFadeKind(p0);
	Scr_SetFadeColor(p1);
	Scr_SetFadeSpeed(p2);
	Scr_SendBgPlttCommand(p0, S_FADE_SPEED, S_FADE_R, S_FADE_G, S_FADE_B, p3);
	Scr_SendObjPlttCommand(S_FADE_KIND, S_FADE_SPEED, S_FADE_R, S_FADE_G, S_FADE_B, p4);
	if (p5 != 0) {
		Chara(Cmd_Delay, (u16)0x4C14, .t = p2, .p = p5);
	}
}

// 0x08D1BE39, BG パレットコマンドを送る, p0: コマンド番号, p1〜p5: 引数
Scr_SendBgPlttCommand() {
	Command(Cmd_SendBgPlttCommand, .r = p0, .p = [p1, p2, p3, p4, p5]);
}

// 0x08D1BE4F, OBJ パレットコマンドを送る, p0: コマンド番号, p1〜p5: 引数
Scr_SendObjPlttCommand() {
	Command(Cmd_SendObjPlttCommand, .r = p0, .p = [p1, p2, p3, p4, p5]);
}

// 0x08D1BE65, フェードの種類 p0 (BG 側の 2〜5) を OBJ 側の番号 (1〜4) に直して S_FADE_KIND に入れる
Scr_SetFadeKind() {
	if (p0 == 2) {
		S_FADE_KIND = 1;
	} else if (p0 == 4) {
		S_FADE_KIND = 3;
	} else if (p0 == 3) {
		S_FADE_KIND = 2;
	} else if (p0 == 5) {
		S_FADE_KIND = 4;
	}
}

// 0x08D1BEB3, フェードのフレーム数 p0 (1, 16〜256) を長さの log2 に直して S_FADE_SPEED に入れる
Scr_SetFadeSpeed() {
	switch (p0) {
		case 1: {
			S_FADE_SPEED = 0;
		}
		case 16: {
			S_FADE_SPEED = 4;
		}
		case 32: {
			S_FADE_SPEED = 5;
		}
		case (u8)64: {
			S_FADE_SPEED = 6;
		}
		case (u8)128: {
			S_FADE_SPEED = 7;
		}
		case (s16)256: {
			S_FADE_SPEED = 8;
		}
		default: {
			S_FADE_SPEED = 4;
		}
	}
}

// 0x08D1BF20, フェード色の番号 p0 (0: 黒, 1: 白, 2: 緑, 3: 赤, 4: 青) を S_FADE_R/G/B に入れる
Scr_SetFadeColor() {
	if (p0 == 0) {
		S_FADE_R = 4;
		S_FADE_G = 4;
		S_FADE_B = 4;
	} else if (p0 == 1) {
		S_FADE_R = 31;
		S_FADE_G = 31;
		S_FADE_B = 31;
	} else if (p0 == 2) {
		S_FADE_R = 0;
		S_FADE_G = 31;
		S_FADE_B = 0;
	} else if (p0 == 3) {
		S_FADE_R = 31;
		S_FADE_G = 0;
		S_FADE_B = 0;
	} else if (p0 == 4) {
		S_FADE_R = 0;
		S_FADE_G = 0;
		S_FADE_B = 31;
	} else {}
}

// 0x08D1BFD9
Scr_0x00D9() {
	if (W_UNK_040_1 == 1) {
		Scr_0x0208();
	} else if (S_UNK_014_5 == 1) {} else {
		Scr_0x00DA();
	}
}

// 0x08D1C004
Scr_0x00DA() {
	if (S_UNK_017_7 && { Scr_IsNight(); } == 0 && { Command(Cmd_GetSolarGauge); } >= 2 && S_UNK_014_3 == 0) {
		if ({ Command(Cmd_GetSolarGauge); } < 4) {
			Scr_FadeScreen(4, 1, 16);
		} else if ({ Command(Cmd_GetSolarGauge); } < 6) {
			Scr_FadeScreen(4, 1, 32);
		} else if ({ Command(Cmd_GetSolarGauge); } < 8) {
			Scr_FadeScreen(4, 1, (u8)64);
		} else {
			Scr_FadeScreen(4, 1, (u8)128);
		}
	} else {
		Scr_FadeScreen(4, S_MAP_FADE_COLOR, S_MAP_FADE_FRAMES);
	}
	S_UNK_017_7 = 0;
}

// 0x08D1C0B1, 夜 (時間帯が TIME_NIGHT_DAWN / TIME_NIGHT_DUSK / TIME_NIGHT_MID) なら 1 を返す
Scr_IsNight() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	if (S_SPAN_OF_TIME == 0 || S_SPAN_OF_TIME == 4 || S_SPAN_OF_TIME == 5) {
		return 1;
	} else {
		return 0;
	}
}

