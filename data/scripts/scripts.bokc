// 0x08D6EDF2
Scr_0x0B13() {
	Scr_0x0B1D();
	Scr_0x0B1C();
	if (LAP >= 1) {
		Scr_0x0B1B();
	} else if (W_STORY_PROGRESS < 26) {
		Scr_0x0B15();
	} else if (W_STORY_PROGRESS < 35) {
		Scr_0x0B16();
	} else if (W_STORY_PROGRESS < 46) {
		Scr_0x0B17();
	} else if (W_STORY_PROGRESS < 58) {
		Scr_0x0B18();
	} else if (W_STORY_PROGRESS < 62) {
		Scr_0x0B19();
	} else if (W_STORY_PROGRESS >= 62) {
		Scr_0x0B1A();
	}
}

