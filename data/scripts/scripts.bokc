// 0x08D1A571
Scr_0x00AD() {
	Scr_SpawnExitArrow(p0);
	Scr_SpawnExitArrow(p1);
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x14C9, .s = [p0, p1, p2], .e = {
		if (p2 == (u16)0x0DD2 && S_UNK_017_6 == 0) {
			Scr_0x00B4(p1);
			Scr_0x00AE(p10, p11, S_EXIT_DIR, 0, p3, p4, p5, p12);
