// 0x08D6B831, 鍛冶屋スミスの会話の入口
Scr_TalkSmith() {
	Scr_BeginEventLockPlayer();
	if (W_STORY_PROGRESS >= 26 && W_STORY_PROGRESS < 32 && BIT(world + 0x5E, 4) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_112A));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		BIT(world + 0x5E, 4) = 1;
	} else if (W_STORY_PROGRESS >= 32 && W_STORY_PROGRESS < 35) {
		if (BIT(world + 0x5E, 5) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithSabata));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
			Scr_SetMsgWindowScripts((u24)Scr_0x0AE0, (u24)Scr_0x0218);
			BIT(world + 0x5E, 5) = 1;
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_114D));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else if (W_STORY_PROGRESS >= 35 && W_STORY_PROGRESS < 46 && BIT(world + 0x5E, 6) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1150));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		BIT(world + 0x5E, 6) = 1;
	} else if (W_STORY_PROGRESS >= 46 && W_STORY_PROGRESS < 58 && BIT(world + 0x5E, 7) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1168));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		BIT(world + 0x5E, 7) = 1;
	} else if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62 && BIT(world + 0x5F, 0) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_117E));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		BIT(world + 0x5F, 0) = 1;
	} else if (W_STORY_PROGRESS >= 62) {
		if (BIT(world + 0x5F, 1) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_118E));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
			BIT(world + 0x5F, 1) = 1;
		} else if (BIT(world + 0x5F, 2) == 0 && { Command(Cmd_HasWeapon, .w = 58); } == 1) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithGun));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AA1, 0);
			BIT(world + 0x5F, 2) = 1;
		} else if ({ Scr_0x0AA9(); } == 1) {
			Scr_SmithMeteoriteTalk();
		} else if ({ Scr_0x0AB7(); } == 1) {
			Scr_SmithLicenseTalk();
		} else {
			Scr_SmithForgePrompt();
		}
	} else if ({ Scr_0x0AA9(); } == 1) {
		Scr_SmithMeteoriteTalk();
	} else if ({ Scr_0x0AB7(); } == 1) {
		Scr_SmithLicenseTalk();
	} else {
		Scr_SmithForgePrompt();
	}
}

