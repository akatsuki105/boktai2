// 0x08D1C777, オブジェ天窓を1つ置く, 天窓の光の範囲と光の柱 (汎用オブジェ) を同じ ID で登録し, パレットは時間帯で選ぶ, 最大12個
Scr_AddObjSkylight() {
	S_SKYLIGHT_COUNT = S_SKYLIGHT_COUNT + 1;
	Command(Cmd_Assert, (S_SKYLIGHT_COUNT < 12), "オブジェ天窓max over. call me,YANO!!");
	if (S_SKYLIGHT_COUNT < 10) {
		v1 = (u16)0xAE3E;
		v1 = v1 + S_SKYLIGHT_COUNT;
	} else {
		v1 = (u16)0xC825;
		v1 = v1 + (S_SKYLIGHT_COUNT - 10);
	}
	Command(Cmd_0CD4, p5, p6, S_TMP_POS_Y);
	Command(Cmd_AddSkylightArea, .n = v1, .a = [p5, p6, (p5 + (s16)256), (p6 + (s16)256)]);
	Scr_SelectBySpanOfTime(p2, p3, p4);
	v2 = result;
	Command(Cmd_AddGenericObj, .n = v1, .t = p0, .i = p1, .p = [(p5 + (u8)128), S_TMP_POS_Y, (p6 + (u8)128)], .f = 0, .R = 3);
	Command(Cmd_StartGenericObjPlttFade, .n = v1, .s = v2, .e = v2, .f = 1);
}

// 0x08D1C874, 太陽が当たっている間だけオブジェ天窓を出す仕掛けを作る (SunRangeWatcher 0x9A75)
Scr_CreateSunlitSkylights() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	if ((S_SPAN_OF_TIME >= 5 || S_SPAN_OF_TIME < 1) && { Command(Cmd_GetMoonPhase); } == 4) {
		Scr_ShowSkylights();
	} else {
		if ({ Command(Cmd_GetSolarGauge); } > 0) {
			Scr_ShowSkylights();
		} else {
			Scr_HideSkylights();
		}
		Chara(SunRangeWatcher_Create, (u16)0x9A75, .p = [(u24)Scr_ShowSkylights, (u24)Scr_HideSkylights], .f = 0, .u = [1, 10]);
	}
}

// 0x08D1C8F0, 時間帯で p0 (朝・昼), p1 (夕方), p2 (夜) のどれかを返す
Scr_SelectBySpanOfTime() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME < 3) {
		v1 = p0;
	} else if (S_SPAN_OF_TIME >= 3 && S_SPAN_OF_TIME < 5) {
		v1 = p1;
	} else {
		v1 = p2;
	}
	return v1;
}

