	if (W_TITLE_EARNED(3) == 1) {
		Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_LibTitleFistMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(4) == 1) {
		Command(Cmd_SetMessageWindowExtend, 4, StringRef(Str_LibTitleGunMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 4, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(5) == 1) {
		Command(Cmd_SetMessageWindowExtend, 5, StringRef(Str_LibTitleAdept));
	} else {
		Command(Cmd_SetMessageWindowExtend, 5, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(6) == 1) {
		Command(Cmd_SetMessageWindowExtend, 6, StringRef(Str_LibTitleDayWalker));
	} else {
		Command(Cmd_SetMessageWindowExtend, 6, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(7) == 1) {
		Command(Cmd_SetMessageWindowExtend, 7, StringRef(Str_LibTitleAdventurer));
	} else {
		Command(Cmd_SetMessageWindowExtend, 7, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(8) == 1) {
		Command(Cmd_SetMessageWindowExtend, 8, StringRef(Str_LibTitleAgent));
	} else {
		Command(Cmd_SetMessageWindowExtend, 8, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(9) == 1) {
		Command(Cmd_SetMessageWindowExtend, 9, StringRef(Str_LibTitleCollector));
	} else {
		Command(Cmd_SetMessageWindowExtend, 9, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(10) == 1) {
		Command(Cmd_SetMessageWindowExtend, 10, StringRef(Str_LibTitleDarkHunter));
	} else {
		Command(Cmd_SetMessageWindowExtend, 10, StringRef(Str_LibTitleUnknown));
	}
	if (W_TITLE_EARNED(11) == 1) {
		Command(Cmd_SetMessageWindowExtend, 11, StringRef(Str_LibTitleGrandMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 11, StringRef(Str_LibTitleUnknown));
	}
	if ({ Scr_CountTitlesEarned(); } == 12) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LibTitleCompleted));
	} else {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LibTitle));
	}
	Scr_OpenMsgWindow(3, (u24)Scr_0x0B0E, 0);
}

