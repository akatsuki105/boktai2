// 0x08D384D7, 本棚の書名を表示する, p1: 本棚番号 (1〜10)
Scr_ReadBookshelf() {
	if ({ Command(Cmd_IsInCutscene); } == 1) {} else {
		S_BOOKSHELF_NO = p1;
		if (p1 == 1) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookA));
		} else if (p1 == 2) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookB));
		} else if (p1 == 3) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookC));
		} else if (p1 == 4) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookD));
		} else if (p1 == 5) {
