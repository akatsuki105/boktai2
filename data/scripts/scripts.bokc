Scr_GetKeyData() {
	Scr_BeginEventLockPlayer();
	W_KEY_DATA_RECEIVED((p5)) = 1;
	Command(Cmd_PlayTrackedSound, .i = (s16)291);
	if (W_CROSSOVER_PROGRESS < 3) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MMBNKey1));
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		Scr_0x0197(3);
		Command(Cmd_EFD1, .i = 4);
	} else if (W_CROSSOVER_PROGRESS < 4) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MMBNKey2));
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		Scr_0x0197(4);
		Command(Cmd_EFD1, .i = 5);
	} else if (W_CROSSOVER_PROGRESS < 5) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MMBNKey3));
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		Scr_0x0197(5);
		Command(Cmd_EFD1, .i = 6);
	} else {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_MMBNKey4));
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		Scr_0x0197(6);
		Command(Cmd_EFD1, .i = 7);
	}
}

// 0x08D20F52
Scr_0x0199() {
	if (W_CROSSOVER_PROGRESS == 0) {
		if ({ Command(Cmd_GetCrossoverBattleCount); } > 0) {
			return 1;
		} else {
			return 0;
		}
	} else if (W_CROSSOVER_PROGRESS <= 1) {
		return 2;
	} else if (W_CROSSOVER_PROGRESS <= 2) {
		return 3;
	} else if (W_CROSSOVER_PROGRESS <= 3) {
		return 4;
	} else if (W_CROSSOVER_PROGRESS <= 4) {
		return 5;
	} else if (W_CROSSOVER_PROGRESS <= 5) {
		return 6;
	} else if (W_CROSSOVER_PROGRESS <= 6) {
		return 7;
	} else if (W_CROSSOVER_PROGRESS <= 7) {
		return 8;
	} else if (W_CROSSOVER_PROGRESS <= 8) {
		return 9;
	} else if (W_CROSSOVER_PROGRESS <= 10) {
		return 11;
	} else if (W_CROSSOVER_PROGRESS <= 13) {
		if ({ Command(Cmd_GetCrossoverBattleCount); } > 0) {
			return 13;
		} else {
			return 12;
		}
	} else {
		return 0;
	}
	return 0;
}

