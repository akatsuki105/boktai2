// 0x08D700EE, 依頼達成の報告, 報酬を渡す
Scr_QuestCleared() {
	Scr_BeginEventLockPlayer();
	W_QUEST_ACCEPTED((W_CURRENT_QUEST)) = 0;
	if (W_STORY_PROGRESS >= 53) {
		BIT(scratch + 0x14, 4) = 1;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_0E6F));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B26, 0);
	} else {
		Scr_0x0B26();
	}
}

