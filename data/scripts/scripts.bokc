	});
}

// 0x08D68837, メニューの選択の結果, 通信販売は初回だけ説明する, p0: 選択
Scr_ShaianMenuAnswer() {
	if (p0 < 0) {
		Scr_0x0A3D();
	} else if (p0 == 0) {
		Scr_0x0A31();
	} else if (p0 == 1) {
		Scr_ShaianHintTalk();
	} else if (p0 == 2) {
		if (BIT(world + 0x74, 4) == 0) {
			BIT(world + 0x74, 4) = 1;
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Shaian_0FB2));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0A36, 0);
		} else {
			Scr_0x0A36();
		}
	}
}

