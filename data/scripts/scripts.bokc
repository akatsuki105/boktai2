// 0x08D6DB47, 記録の閲覧の選択肢の処理, p0: 項目 (0: 総合記録, 1: 浄化記録, 2: 通信販売, ...)
Scr_RecordsChoice() {
	BIT(scratch + 0x14, 4) = 0;
	if (p0 < 0) {
		Scr_0x0B06();
	} else if (p0 == 0) {
		Command(Cmd_4CCD, S_UPTIME_DAYS, S_HOUR, S_MINUTE);
		Scr_0x0B05(0, (S_UPTIME_DAYS * 24 + S_HOUR), (s16)999);
		if (S_UPTIME_DAYS * 24 + S_HOUR >= (s16)1000) {
			S_MINUTE = 59;
		}
		S_UPTIME_MIN_TENS = S_MINUTE / 10;
		S_UPTIME_MIN_ONES = S_MINUTE % 10;
		Scr_0x0B05(1, S_UPTIME_MIN_TENS, 5);
		Scr_0x0B05(2, S_UPTIME_MIN_ONES, 9);
		S_PLAY_TIME_HOURS = PLAY_TIME / 60 / 60 / 60;
		S_PLAY_TIME_MINUTES = PLAY_TIME / 60 / 60 % 60;
		DebugPrint("プレイタイム時", S_PLAY_TIME_HOURS);
		DebugPrint("プレイタイム分", S_PLAY_TIME_MINUTES);
		if (S_PLAY_TIME_HOURS >= (u8)100) {
			S_PLAY_TIME_HOURS = (u8)99;
			S_PLAY_TIME_MINUTES = 59;
		}
		S_PLAY_TIME_HOUR_TENS = S_PLAY_TIME_HOURS / 10;
		S_PLAY_TIME_HOUR_ONES = S_PLAY_TIME_HOURS % 10;
		S_PLAY_TIME_MIN_TENS = S_PLAY_TIME_MINUTES / 10;
		S_PLAY_TIME_MIN_ONES = S_PLAY_TIME_MINUTES % 10;
		Scr_0x0B05(3, S_PLAY_TIME_HOUR_TENS, 9);
		Scr_0x0B05(4, S_PLAY_TIME_HOUR_ONES, 9);
		Scr_0x0B05(5, S_PLAY_TIME_MIN_TENS, 5);
		Scr_0x0B05(6, S_PLAY_TIME_MIN_ONES, 9);
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0D80));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B00, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x0B00, (u24)Scr_0x13F8);
	} else if (p0 == 1) {
		Scr_0x0B02();
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0D88));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B00, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x0B00, (u24)Scr_0x0B03);
	} else if (p0 == 2) {
		Scr_0x0B05(0, *((s16 *)(stat + 0x918)), (s16)9999);
		Scr_0x0B05(1, *((s16 *)(stat + 0x91A)), (s16)9999);
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0D96));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B00, 0);
	} else if (p0 == 3) {
		Scr_0x0B05(0, LINK_BATTLE_POINT, 999999);
		Scr_0x0B05(1, *((s16 *)(stat + 0x914)), (s16)9999);
		Scr_0x0B05(2, *((s16 *)(stat + 0x916)), (s16)9999);
		if (*((s16 *)(stat + 0x914)) == 0) {
			Command(Cmd_SetMessageWindowVar, 3, 0);
		} else {
			Command(Cmd_SetMessageWindowVar, 3, (*((s16 *)(stat + 0x916)) * (u8)100 / *((s16 *)(stat + 0x914))));
		}
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0D99));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B00, 0);
	} else if (p0 == 4) {
		S_CROSSOVER_POINT = { Command(Cmd_GetCrossoverPoint); };
		S_CROSSOVER_BATTLE_COUNT = { Command(Cmd_GetCrossoverBattleCount); };
		S_CROSSOVER_BATTLE_WINS = { Command(Cmd_GetCrossoverBattleWins); };
		Scr_0x0B05(0, S_CROSSOVER_POINT, 999999);
		Scr_0x0B05(1, S_CROSSOVER_BATTLE_COUNT, (s16)999);
		Scr_0x0B05(2, S_CROSSOVER_BATTLE_WINS, (s16)999);
		if (S_CROSSOVER_BATTLE_COUNT == 0) {
			Command(Cmd_SetMessageWindowVar, 3, 0);
		} else {
			Command(Cmd_SetMessageWindowVar, 3, (S_CROSSOVER_BATTLE_WINS * (u8)100 / S_CROSSOVER_BATTLE_COUNT));
		}
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_0D9D));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B00, 0);
	} else {
		Scr_0x0B06();
	}
}

