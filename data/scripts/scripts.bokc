// 0x08D68D16, キッド(道具屋)との会話, 進行度で特別な会話をしてから店の選択肢を出す
Scr_TalkKid() {
	BIT(scratch + 0x18F, 3) = BIT(scratch + 0x18F, 3) ^ 1;
	DebugPrint("キッド道具屋_会話ループフラグ_________", BIT(scratch + 0x18F, 3));
	Scr_BeginEventLockPlayer();
	if (W_STORY_PROGRESS >= 35 && W_STORY_PROGRESS < 46 && BIT(world + 0x6B, 7) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F3A));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		BIT(world + 0x6B, 7) = 1;
	} else if (W_STORY_PROGRESS >= 62 && BIT(world + 0x74, 0) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Kid_0F5F));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A49, 0);
		BIT(world + 0x74, 0) = 1;
	} else {
		Scr_KidShopPrompt();
	}
}

