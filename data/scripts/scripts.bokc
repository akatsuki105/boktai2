// 0x08D648F2, クロの状態を返す, 1: 倉庫の前で威嚇, 2: 包帯を巻いて威嚇, 0: それ以外
Scr_GetKuroState() {
	if (W_WAREHOUSE_LEVEL == 0) {
		if (W_STORY_PROGRESS >= 23 && W_STORY_PROGRESS < 36) {
			DebugPrint("倉庫の前でキシャー");
			return 1;
		} else if (W_STORY_PROGRESS >= 48 && W_STORY_PROGRESS < 50 && W_KURO_EVENT_STEP <= 1) {
			DebugPrint("包帯巻いてキシャー");
			return 2;
		} else {
			DebugPrint("家出中");
			return 0;
		}
	} else {
		DebugPrint("クロ倉庫でマルクなる");
		return 0;
	}
}

// 0x08D649C3
Scr_0x09E5() {
	v1 = 0;
