Scr_PurifyBossLastWords() {
	if (W_STORY_PROGRESS < 26) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_PurificationDuneyrr));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0055, 0);
	} else if (W_STORY_PROGRESS < 35) {
		Command(Cmd_054A);
	} else if (W_STORY_PROGRESS < 46) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_PurificationDurathror));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0055, 0);
	} else if (W_STORY_PROGRESS < 58) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_PurificationDvalin));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0055, 0);
	} else if (W_STORY_PROGRESS < 62) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_PurificationDainn));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0055, 0);
	} else {
		if (W_CROSSOVER_PROGRESS < 11) {
			Scr_0x10AC();
		} else {}
	}
}

