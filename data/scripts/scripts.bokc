// 0x08D690F3, リタの店での会話の入口
Scr_TalkRita() {
	Scr_BeginEventLockPlayer();
	if (BIT(scratch + 0x18F, 4) == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1226));
		Scr_OpenMsgWindow(3, (u24)Scr_0x1720, 0);
	} else if ({ Scr_0x01C9(1); } == 2 && BIT(world + 0x5F, 6) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_069A));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x0A63);
		Scr_0x01C6(1);
	} else if ({ Scr_0x01C8(1); } == 1) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_069E));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A64, 0);
		Scr_0x01C6(1);
	} else if (W_STORY_PROGRESS >= 32 && W_STORY_PROGRESS < 35 && BIT(world + 0x5F, 7) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1230));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		BIT(world + 0x5F, 7) = 1;
	} else if (W_STORY_PROGRESS < 46 && BIT(world + 0x6B, 3) == 0 && PLAYER_KIND == 1 && BIT(world + 0x5F, 6) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1219));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		BIT(world + 0x6B, 3) = 1;
		Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x0A5C);
	} else if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62 && BIT(world + 0x6B, 0) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1267));
		Scr_OpenMsgWindow(3, (u24)Scr_RitaBelievePrompt, 0);
	} else if (W_STORY_PROGRESS >= 62 && BIT(world + 0x6B, 1) == 0) {
		if (PLAYER_KIND == 1) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_128F));
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Rita_1288));
		}
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A68, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x0A68, (u24)Scr_0x024A);
		BIT(world + 0x6B, 1) = 1;
	} else if (WEAPON_EXP(3) >= (s16)9900 && PLAYER_KIND != 5 && { Command(Cmd_HasItem, .i = 52); } == 0) {
		Scr_AddFriendship(1, 1);
		Scr_RitaFistMaster();
	} else {
		Scr_RitaShopWelcome();
	}
}

