// 0x08D6507C, 時間帯で出入りする住人(ルイス, マルチェロ, ハテナ)を日の出・日の入り時刻と雨・棺桶の状態に応じて屋外に置く
Scr_SpawnTimedResidents() {
	S_LUIS_TALK_COUNT = 0;
	S_MARCELLO_TALK_COUNT = 0;
	S_UNK_176 = 4;
	S_UNK_178 = 4;
	Scr_0x0BD4(1);
	Command(Cmd_GetDateTime, S_YEAR, S_MONTH, S_DAY, S_HOUR, S_MINUTE, S_SECOND);
	S_UNK_16B_4 = 0;
	if (UNK_946 > (s16)29167) {
		S_UNK_16B_4 = 1;
	}
	S_UNK_16B_5 = 0;
	if (W_COFFIN_ROOM == (u8)162 && S_UNK_16B_3 == 0) {
		S_UNK_16B_5 = 1;
	}
	DebugPrint("棺桶エリア", W_COFFIN_ROOM);
	DebugPrint("棺桶ロード", S_UNK_16B_3);
	DebugPrint("棺桶フラグ", S_UNK_16B_5);
	S_NOW_MINUTES = S_HOUR * 60 + S_MINUTE;
	Command(Cmd_GetSunriseTime, S_SUNRISE_HOUR, S_SUNRISE_MINUTE, S_UNTIL_SUNRISE_HOUR, S_UNTIL_SUNRISE_MINUTE);
	Command(Cmd_GetSunsetTime, S_SUNSET_HOUR, S_SUNSET_MINUTE, S_UNTIL_SUNSET_HOUR, S_UNTIL_SUNSET_MINUTE);
	S_SUNRISE_MINUTES = S_SUNRISE_HOUR * 60 + S_SUNRISE_MINUTE;
	S_SUNSET_MINUTES = S_SUNSET_HOUR * 60 + S_SUNSET_MINUTE;
	DebugPrint("現在時刻分表記", S_NOW_MINUTES);
	DebugPrint("日の出時間_分表記", S_SUNRISE_MINUTES);
	DebugPrint("日の入時間_分表記", S_SUNSET_MINUTES);
	if (W_UNK_083_7 == 1) {
		if (S_SUNRISE_MINUTES <= S_NOW_MINUTES && S_SUNSET_MINUTES >= S_NOW_MINUTES) {
			if (S_UNK_16B_4 == 0 && S_UNK_16B_5 == 0) {
				Command(Cmd_8EA3, .n = (u16)0x7E5F, .c = (u16)0xE04E, .p = [(s16)640, (s16)768, (s16)896], .r = [2, 0, 0], .T = [S_SUNRISE_HOUR, S_SUNRISE_MINUTE, S_SUNSET_HOUR, S_SUNSET_MINUTE], .s = [8, 16], .h = [(s16)3200, (s16)768, (s16)3200], .d = (u8)64, .H = [S_UNK_176, S_UNK_178], .i = 2, .t = (u24)Scr_TalkLuis, .F = 0);
			}
		}
	}
	if (W_UNK_080_7 == 1) {
		if (S_SUNRISE_MINUTES <= S_NOW_MINUTES && S_SUNSET_MINUTES >= S_NOW_MINUTES) {
			if (S_UNK_16B_4 == 0 && S_UNK_16B_5 == 0) {
				Command(Cmd_8EA3, .n = (u16)0xCB6B, .c = (u16)0xDFCE, .p = [(s16)3968, (s16)768, (s16)896], .r = [3, 0, 0], .T = [S_SUNRISE_HOUR, S_SUNRISE_MINUTE, S_SUNSET_HOUR, S_SUNSET_MINUTE], .s = [10, 20], .h = [(s16)1664, (s16)768, (s16)384], .d = (u8)64, .H = [S_UNK_176, S_UNK_178], .i = 2, .t = (u24)Scr_TalkMarcello, .F = 0);
			}
		}
	}
	if (W_UNK_086_2 == 1) {
		if (S_SUNRISE_MINUTES > S_NOW_MINUTES || S_SUNSET_MINUTES < S_NOW_MINUTES) {
			if (S_UNK_16B_4 == 0 && S_UNK_16B_5 == 0) {
				DebugPrint("ハテナ設置");
				Command(Cmd_8EA3, .n = (u16)0x04B1, .c = (u16)0xE03E, .p = [(s16)5760, (s16)512, (s16)3456], .r = [4, 0, 0], .T = [S_SUNSET_HOUR, S_SUNSET_MINUTE, S_SUNRISE_HOUR, S_SUNRISE_MINUTE], .s = [16, 24], .h = [(s16)1152, (s16)768, (s16)384], .d = 0, .H = [S_UNK_176, S_UNK_178], .i = 2, .t = (u24)Scr_TalkHatena, .F = 0);
			}
		}
	}
}

