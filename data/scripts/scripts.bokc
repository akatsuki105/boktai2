// 0x08D919E9, 夢幻街のトラップパネルを踏んだとき, 区画の仕掛けの種類 (W_MUGEN_BLOCK_EVENT) で効果を出す, 1: 警報 (プレイヤーなら鉄格子を20秒閉じる), 2: 鉄球落下 (当たると最大HP分のダメージ), 3: 大爆発 (威力9999), 4〜6: 状態異常, 7〜9: 良い効果, 10: カギ落下 (□のカギを落とす), p9: 踏んだもの
Scr_OnMugenTrapPanelStepped() {
	Command(Cmd_PlayTrackedSound, .i = (s16)341);
	switch (W_MUGEN_BLOCK_EVENT((W_MUGEN_BLOCK))) {
		case 1: {
			if (p9 == (u16)0xF5EB) {
				Scr_GetZoneBounds((u16)0x4D9C);
				Command(Cmd_PlayTrackedSound, .i = (s16)402);
				Command(Cmd_MakeNoise, .p = [S_ZONE_CENTER_X, S_ZONE_CENTER_Z], .r = (s16)2048, .f = (u8)128);
				if (S_UNK_1F7_2 == 0) {
					Chara(CountdownTimer_Create, (u16)0xB669, .t = (s16)1200, .p = (u24)Scr_Nop);
					S_UNK_1F7_2 = 1;
					if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 0)) != 8) {
						Scr_AddShutter((u16)0x6A3F, (u16)0xCD22, 1, 1, (s16)256);
					}
					Scr_AddShutter((u16)0x6A40, (u16)0xCD23, 2, 1, (s16)256);
					Scr_AddShutter((u16)0x6A41, (u16)0xCD24, 3, 1, (s16)256);
					if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 3)) != 8) {
						Scr_AddShutter((u16)0x6A42, (u16)0xCD25, 0, 1, (s16)256);
					}
					if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 0)) != 8) {
						Command(Cmd_D6F7, .n = (u16)0x6A3F);
					}
					Command(Cmd_D6F7, .n = (u16)0x6A40);
					Command(Cmd_D6F7, .n = (u16)0x6A41);
					if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 3)) != 8) {
						Command(Cmd_D6F7, .n = (u16)0x6A42);
					}
					Chara(Cmd_Delay, (u16)0x3829, .t = (s16)1200, .e = {
						Mesg(0x3829, (u16)0xFFFF);
						S_UNK_1F7_2 = 0;
						Command(Cmd_EndCountdownTimer);
						if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 0)) != 8) {
							Command(Cmd_8B67, .n = (u16)0x6A3F);
						}
						Command(Cmd_8B67, .n = (u16)0x6A40);
						Command(Cmd_8B67, .n = (u16)0x6A41);
						if (W_MUGEN_SIDE_ROOM((W_MUGEN_BLOCK * 4 + 3)) != 8) {
							Command(Cmd_8B67, .n = (u16)0x6A42);
						}
					});
				}
			} else {
				Command(Cmd_PlayTrackedSound, .i = (s16)402);
			}
		}
		case 2: {
			Scr_GetZoneBounds((u16)0x4D9C);
			Scr_DropSpikeBall((u16)0x67EA, S_ZONE_CENTER_X, (S_ZONE_CENTER_Y + (s16)1024), S_ZONE_CENTER_Z, (SAVED_MAX_HP));
			if (p9 == (u16)0xF5EB) {}
		}
		case 3: {
			Scr_GetZoneBounds((u16)0x4D9C);
			Scr_HugeExplosion(S_ZONE_CENTER_X, (S_ZONE_CENTER_Y >> 8), S_ZONE_CENTER_Z, (s16)9999, (u8)64, 30, 32);
			if (10 == (u16)0xF5EB) {} else {}
		}
		case 4: {
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyBadCond, .s = 0, .t = (s16)1200);
			}
			Scr_0x0EED((u16)0x4D9C);
		}
		case 5: {
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyBadCond, .s = 1, .t = (s16)1800);
			}
			Scr_0x0EED((u16)0x4D9C);
		}
		case 6: {
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyBadCond, .s = 2, .t = (s16)900);
			}
			Scr_0x0EED((u16)0x4D9C);
		}
		case 7: {
			Scr_0x0EEC((u16)0x4D9C);
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyItemEffect, .E = 2, .t = (s16)1800);
			}
		}
		case 8: {
			Scr_0x0EEC((u16)0x4D9C);
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyItemEffect, .E = 6, .t = (s16)900);
			} else {}
		}
		case 9: {
			Scr_0x0EEC((u16)0x4D9C);
			if (p9 == (u16)0xF5EB) {
				Command(Cmd_ApplyItemEffect, .E = 0);
			}
		}
		case 10: {
			Scr_0x0EEC((u16)0x4D9C);
			if (W_UNK_086_7 == 0 && S_UNK_1F7_1 == 0) {
				S_UNK_1F7_1 = 1;
				Scr_GetZoneBounds((u16)0x4D9C);
				Scr_PlaceMapItem(0, (u8)67, (S_ZONE_CENTER_X), (s16)1024, (S_ZONE_CENTER_Z), 1, (u24)Scr_0x0EEE, 0, 0);
			}
		}
		default: {}
	}
}

