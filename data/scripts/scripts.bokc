// 0x08D70EC5, 時計塔管理人エンニオの会話の入口
Scr_TalkEnnio() {
	Scr_BeginEventLockPlayer();
	if (BIT(world + 0x5C, 6) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0EFA));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0B56, 0);
		BIT(world + 0x5C, 6) = 1;
	} else {
		Scr_EnnioClockTalk();
	}
}

// 0x08D70F03, エンニオとの会話, 時計合わせは1日1回だけ受け付ける
Scr_EnnioClockTalk() {
	Command(Cmd_GetDateTime, S_YEAR, S_MONTH, S_DAY, S_HOUR, S_MINUTE, S_SECOND);
	S_ENNIO_CLOCK_DAYS = { Scr_0x01CC(S_YEAR, S_MONTH, S_DAY, W_CLOCK_FIX_YEAR, W_CLOCK_FIX_MONTH, W_CLOCK_FIX_DAY); };
	DebugPrint("日数", S_ENNIO_CLOCK_DAYS);
	if (BIT(world + 0x5E, 0) == 0 || S_ENNIO_CLOCK_DAYS >= 2) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0EFF));
		Scr_OpenMsgWindow(3, (u24)Scr_EnnioClockOffPrompt, 0);
	} else {
		if (S_ENNIO_CLOCK_DAYS == 1 && W_CLOCK_FIX_HOUR <= S_HOUR && W_CLOCK_FIX_MINUTE <= S_MINUTE) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0EFF));
			Scr_OpenMsgWindow(3, (u24)Scr_EnnioClockOffPrompt, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0F25));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B56, 0);
		}
	}
}

// 0x08D70FED, 大時計がずれているかの選択肢 (狂ってる/狂ってない)
Scr_EnnioClockOffPrompt() {
	Chara(Cmd_Delay, (u16)0x5F25, .t = 10, .e = {
		Scr_0x00FB((u16)39684, (u24)Scr_EnnioClockOffAnswer, 0, 0, 0);
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_Ennio_0F02));
	});
}

// 0x08D7101F, ずれているかの選択の結果, 狂ってるなら時計直しの説明, p0: 選択
Scr_EnnioClockOffAnswer() {
	if (p0 < 0) {
		Scr_EnnioDismiss();
	} else if (p0 == 0) {
		if (BIT(world + 0x5E, 0) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0F04));
			Scr_OpenMsgWindow(3, (u24)Scr_EnnioFixClockAsk, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Ennio_0F0A));
			Scr_OpenMsgWindow(3, (u24)Scr_EnnioFixClockAsk, 0);
		}
	} else if (p0 == 1) {
		Scr_EnnioDismiss();
	}
}

