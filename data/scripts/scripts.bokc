	} else if (W_STORY_PROGRESS >= 48 && W_STORY_PROGRESS < 50 && W_KURO_EVENT_STEP == 0) {
		S_NPC_POS_X = (s16)384;
		S_NPC_POS_Y = (s16)512;
		S_NPC_POS_Z = (s16)384;
		S_NPC_ANGLE = (u8)64;
		S_NPC_INIT_MODE = 3;
