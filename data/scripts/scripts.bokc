	});
}

// 0x08D2039A, 愚者のカード, 暗黒ローンの"やり直し"
Scr_MapRetry() {
	Scr_BeginEvent(1);
	Scr_0x020B();
	Scr_0x016E();
	Command(Cmd_RemoveGoodCond);
	if (BIT(scratch + 0x71, 2) == 1) {
		BIT(scratch + 0x71, 2) = 0;
		Command(Cmd_BackupState, SOLAR_BANK);
		Command(Cmd_BackupState, DARK_DEBTS);
		Command(Cmd_BackupState, *((s32 *)(stat + 0x1D4)));
		Command(Cmd_BackupState, W_LOAN_STATE);
		Command(Cmd_BackupState, W_LOAN_YEAR);
		Command(Cmd_BackupState, W_LOAN_MONTH);
		Command(Cmd_BackupState, W_LOAN_DAY);
	}
	Command(Cmd_PlayTrackedSound, .i = (s16)384);
	Chara(Cmd_Delay, (u16)0xEA44, .t = 50, .e = {
		Scr_FadeScreen(5, 0, 16);
	});
	Chara(Cmd_Delay, (u16)0xC425, .t = (u8)64, .e = {
		BIT(world + 0x51, 3) = 1;
		Command(Cmd_BackupState, BIT(world + 0x51, 3));
		Command(Cmd_BackupState, BIT(world + 0x40, 1));
		Command(Cmd_CA3D);
		Ctrl_0xE43C(.r);
	});
}

// 0x08D2048B, 閉じ込め戦闘を初期化する, p0: 倒すべき数
Scr_InitRoomBattle() {
	S_ROOM_BATTLE_KILLS = 0;
	S_ROOM_BATTLE_TARGET = p0;
	S_ROOM_BATTLE_SHUTTER_COUNT = 0;
}

// 0x08D204A6, 閉じ込め戦闘用の扉をゾーン p0 の辺 p1 に置く (最大4枚), p2: 高さ
Scr_AddRoomBattleShutter() {
	if (S_ROOM_BATTLE_SHUTTER_COUNT == 0) {
		*((u16 *)(scratch + 0x7A)) = p0;
		v1 = (u16)37621;
	} else if (S_ROOM_BATTLE_SHUTTER_COUNT == 1) {
		*((u16 *)(scratch + 0x7C)) = p0;
		v1 = (u16)37622;
	} else if (S_ROOM_BATTLE_SHUTTER_COUNT == 2) {
		*((u16 *)(scratch + 0x7E)) = p0;
		v1 = (u16)37623;
	} else if (S_ROOM_BATTLE_SHUTTER_COUNT == 3) {
		*((u16 *)(scratch + 0x80)) = p0;
		v1 = (u16)37624;
	}
	S_ROOM_BATTLE_SHUTTER_COUNT = S_ROOM_BATTLE_SHUTTER_COUNT + 1;
	Scr_AddShutter(v1, p0, p1, 1, p2);
}

