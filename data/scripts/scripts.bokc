}

// 0x08D1A1F0
Scr_0x00A5() {
	W_UNK_040_2 = 1;
}

// 0x08D1A1FA, Scr_FadeWarp の全引数版, p3: 移る直前に呼ぶスクリプト, p4: フェード時間
Scr_FadeWarpEx() {
	Scr_BeginEvent(0);
	if (W_UNK_00C_5 == 0) {
		Command(Cmd_LockPlayer);
	}
	Scr_FadeScreen(5, 0, p4);
	W_UNK_00C_4 = 1;
	W_UNK_1FB_4 = 1;
	W_UNK_1FB_5 = 1;
	Scr_0x009F();
	W_PREV_PREV_ROOM = W_PREV_ROOM;
	W_PREV_ROOM = ROOM;
	W_ENTRANCE = p1;
	ROOM = p2;
	Chara(Cmd_Delay, (u16)0x5F25, .t = p4, .a = [p0, p3], .e = {
		Scr_EndEvent();
		if (p1 != 0) {
			ScriptCall(p1, 0);
		}
		if (W_UNK_00C_5 == 0) {
			Command(Cmd_UnlockPlayer);
		}
		Scr_0x00A0(p0);
	});
}

// 0x08D1A2B1, ゾーン p0 にプレイヤーが高さ p4 (タイル) でいる間, p1 のマップの入口 p2 (部屋 p3) へ歩かずに移る
Scr_AddExitAtHeight() {
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x1517, .w = [p4, p5, p2, p3], .s = p1, .e = {
		S_TMP_POS_Y = (p6 << 8) - PLAYER_Y;
		if (S_TMP_POS_Y < 0) {
			S_TMP_POS_Y = S_TMP_POS_Y * -1;
		}
		if (W_UNK_00C_4 == 0 && W_UNK_04C_6 == 0 && { Command(Cmd_IsPlayerDead); } == 0 && S_TMP_POS_Y < (s16)256) {
			W_PREV_PREV_ROOM = W_PREV_ROOM;
			W_PREV_ROOM = ROOM;
			W_ENTRANCE = p8;
			ROOM = p9;
			W_UNK_04C_6 = 1;
			Scr_0x009D(p1, 0, p10, 3);
		} else if (S_TMP_POS_Y >= (s16)256) {
			W_UNK_04C_6 = 0;
		}
	});
}

// 0x08D1A37C
Scr_0x00A8() {
	if (W_ENTRANCE == p2 || S_UNK_017_5 == 1) {
		S_UNK_017_5 = 1;
	} else {
		S_UNK_017_5 = 0;
	}
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x14C9, .w = [p4, p2, p3], .s = p1, .e = {
		if (W_UNK_00C_4 == 0 && S_UNK_017_5 == 0 && p2 == (u16)0x0DD2) {
			Scr_BeginEventLockPlayer();
			W_PREV_PREV_ROOM = W_PREV_ROOM;
			W_PREV_ROOM = ROOM;
			W_ENTRANCE = p7;
			ROOM = p8;
			Scr_0x009D(p1, 0, p10, 3);
		} else if (p2 == (u16)0xD5CC) {}
	});
}

// 0x08D1A424
Scr_0x00A9() {
	SetZoneCallback(p0, (u16)0xF5EB, .m = (u16)0x14C9, .w = [p1, p2, p3, p4], .s = [p5, p6, p7], .e = {
		S_UNK_03C = p10;
		if (p2 == (u16)0x0DD2) {
			if (S_UNK_017_5 == 1 && W_UNK_04C_0 == 0) {
				S_UNK_03E = p7;
				S_UNK_03F = p8;
				Scr_0x00B4(p1);
				Chara(Cmd_Delay, (u16)0xA9A3, .t = 10, .a = [S_EXIT_DIR, p12, p10], .e = {
					Mesg(0xA9A3, (u16)0xFFFF);
					Scr_0x0150(p2, S_UNK_03E, S_UNK_03F);
					Scr_0x0160(p0, (s16)256, p1);
				});
			} else if (S_UNK_017_5 == 0 && W_UNK_04C_0 == 0) {
				S_UNK_03E = p8;
				S_UNK_03F = p6;
				Scr_GetZoneBounds(p1);
				Scr_0x00B4(p1);
				Command(Cmd_MovePlayerTo, .p = [S_ZONE_CENTER_X, PLAYER_Y, S_ZONE_CENTER_Z], .d = S_EXIT_DIR, .e = p11);
			}
		} else if (p2 == (u16)0xD5CC) {
			S_UNK_017_5 = 0;
		}
	});
}

