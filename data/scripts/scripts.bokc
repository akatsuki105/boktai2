// 0x08D1E496, 宝箱を開けたときの処理, 取得フラグを立てて p3 (0: アイテム, 1: 武器, 2: 防具, 3: 魔法, 4: 地図) の p4 を渡す, p6/p7: 続けて呼ぶスクリプトと引数
Scr_OnChestOpened() {
	v1 = (p5 & 32768) >> 15;
	v2 = p5 & (s16)32767;
	if (p9 == 1) {
		if (v1 == 1) {
			if (v2 < (u8)100 && v2 >= 0) {
				W_CHEST_OPENED((v2)) = 1;
			}
		} else {
			if (v2 < 40 && v2 >= 0) {
				W_DUNGEON_CHEST_OPENED((v2)) = 1;
			}
		}
		if (p3 == 0) {
			Command(Cmd_GetItem, .i = p4);
			Scr_EndEventUnlockPlayer();
		} else if (p3 == 1) {
			Command(Cmd_GiveWeapon, .w = p4);
			Scr_EndEventUnlockPlayer();
		} else if (p3 == 2) {
			Command(Cmd_7B7D, .a = p4);
			Scr_EndEventUnlockPlayer();
		} else if (p3 == 3) {
			Command(Cmd_UnlockMagic, .m = p4);
			Scr_EndEventUnlockPlayer();
		} else if (p3 == 4) {
			Command(Cmd_UnlockMap, .i = p4);
			if (p4 <= 11) {
				if (p4 & 1) {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_GetMapB));
				} else {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_GetMapA));
				}
			} else {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_GetMap));
			}
			BIT(scratch + 0x14, 4) = 0;
			Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
			Command(Cmd_SetMessageWindowScriptIds, .p = [(u24)Scr_EndEventCloseMsg, (u24)Scr_0x0136]);
		} else {}
		if (p6 != 0) {
			ScriptCall(p6, p7);
		}
	} else {}
}

