	S_ENEMY_ATK_KNOCKBACK = (u8)96;
	if (p0 == 1) {
		S_ENEMY_ATK1_POWER = (u8)100;
		S_ENEMY_ATK1_ATTRS = 8;
		S_ENEMY_ATK1_IFRAMES = 50;
		S_ENEMY_ATK2_POWER = (u8)130;
		S_ENEMY_ATK2_ATTRS = 8;
		S_ENEMY_ATK2_IFRAMES = 60;
		S_ENEMY_ATK3_POWER = (u8)110;
		S_ENEMY_ATK3_ATTRS = 8;
		S_ENEMY_ATK3_IFRAMES = 30;
		S_ENEMY_ATK4_POWER = (u8)120;
		S_ENEMY_ATK4_ATTRS = 8;
		S_ENEMY_ATK4_IFRAMES = 40;
		S_ENEMY_MAX_HP = (s16)2000;
		S_ENEMY_POWER = (u8)70;
		S_UNK_0F0 = (s16)999;
		S_UNK_0F2 = 30;
		S_UNK_0E0 = 2;
		S_ENEMY_ATTRS = (u8)136;
		S_ENEMY_WEAKNESS = 4;
		S_ENEMY_CHASE_TIME_MAX = (s16)600;
		S_ENEMY_RANGE2 = (s16)768;
		S_ENEMY_EXP = (s16)3000;
		S_ENEMY_WEAPON_EXP = (u8)100;
		Scr_SetEnemyDrops(0, -1, 0, -1);
		S_UNK_0EE = 6;
		S_ENEMY_VARIANT = p0;
	}
	Scr_ScaleEnemyParamsForLap();
}

// 0x08D2985A, サーペントを出す, p1: 登場時スクリプト, p2: 撃破時スクリプト
Scr_SpawnSerpent() {
	Command(Serpent_Create, .N = p0, .p = [p3, p4, p5], .e = S_ENEMY_RANGE0, .a = [S_ENEMY_ATK1_POWER, 60, S_ENEMY_ATK1_ATTRS, S_ENEMY_ATK1_IFRAMES, S_ENEMY_ATK2_POWER, 30, S_ENEMY_ATK2_ATTRS, S_ENEMY_ATK2_IFRAMES, S_ENEMY_ATK3_POWER, 10, S_ENEMY_ATK3_ATTRS, S_ENEMY_ATK3_IFRAMES, S_ENEMY_ATK4_POWER, 15, S_ENEMY_ATK4_ATTRS, S_ENEMY_ATK4_IFRAMES], .P = [S_UNK_0F0, S_UNK_0F2], .A = [S_ENEMY_MAX_HP, S_ENEMY_POWER, 50, S_UNK_0E0, S_ENEMY_ATTRS, S_ENEMY_WEAKNESS], .l = [S_UNK_0C6, S_ENEMY_SLEEP_TIME, S_ENEMY_CHASE_TIME_MAX], .n = [S_ENEMY_RANGE2, S_UNK_0CC], .C = 0, .I = (u24)Scr_Nop, .D = p2, .G = [S_ENEMY_DROP_A, S_ENEMY_DROP_B, p9], .M = S_ENEMY_FLAGS5, .X = [S_ENEMY_EXP, S_ENEMY_WEAPON_EXP], .K = S_UNK_0EE, .d = p1, .H = S_UNK_0B9_1);
}

// 0x08D2991B, BGM を消し, Cmd_C15E を p0 に向けて呼び (カメラ?), プレイヤーを止める, サーペントの登場時スクリプトとして渡される
Scr_OnSerpentAppear() {
	Command(Cmd_FadeOutBGM, .f = 8);
	Command(Cmd_C15E, .n = p0, .o = [0, 0, 0], .f = 30);
	Command(Cmd_LockPlayer);
}

// 0x08D29945, Cmd_C15E をプレイヤー (0xF5EB) に戻し, プレイヤーを動かせるようにする, サーペント戦の後に呼ばれる
Scr_OnSerpentDefeated() {
	Command(Cmd_C15E, .n = (u16)0xF5EB, .o = [0, 0, 0], .f = 30);
	Command(Cmd_UnlockPlayer);
}

