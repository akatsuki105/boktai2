// 0x08D95314, 太陽センサーのガイド本体, W_SENSOR_GUIDE_PAGE のページを SensorGuide で出す
Scr_SensorGuide() {
	switch (W_SENSOR_GUIDE_STATE) {
		case 0: {
			W_SENSOR_GUIDE_STATE = 1;
			BIT(scratch + 0x14, 6) = 0;
			BIT(scratch + 0x14, 7) = 0;
			W_CURRENT_BGM = 0;
			S_UNK_202 = 0;
			Scr_0x0F51();
		}
		case 1: {
			W_SENSOR_GUIDE_STATE = 2;
			Chara(MoverList_Create, (u16)0xB8B9);
			if (W_SENSOR_GUIDE_MODE == 2 && W_SENSOR_GUIDE_STEP % 5 == 0) {} else {
				Chara(Cmd_Delay, (u16)0x4775, .t = 1, .e = {
					if (S_UNK_202 == 0 && { Command(Cmd_GetInputKeys); } & 9) {
						S_UNK_202 = 1;
						Scr_0x0F53();
						return 1;
					}
				});
			}
			if (W_SENSOR_GUIDE_MODE > 0 && W_SENSOR_GUIDE_STEP % 5 == 0) {
				if (W_SENSOR_GUIDE_MODE == 2) {
					v1 = 30;
				} else {
					v1 = (u8)90;
				}
			} else {
				v1 = 60;
			}
			Chara(Cmd_Delay, (u16)0xF8DF, .t = v1, .e = {
				if (S_UNK_202 == 0) {
					Scr_0x0F51();
				}
			});
		}
		case 2: {
			W_SENSOR_GUIDE_STATE = 1;
			if (W_SENSOR_GUIDE_MODE > 0 && W_SENSOR_GUIDE_STEP % 5 == 0) {
