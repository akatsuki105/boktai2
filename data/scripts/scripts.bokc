// 0x08D1DA62
Scr_0x0124() {
	if (p0 & 32768) {} else if (p0 & (s16)16384) {} else {}
	if (p1 & 32768) {} else if (p1 & (s16)16384) {} else {}
	S_ROLLED_DROP = 0;
	v1 = 0;
	v2 = 0;
	if (BIT(world + 0xC, 5) == 0) {
		v1 = W_NORMAL_DROP_RATE;
		if ({ Command(Cmd_TestEquipBuff, .f = 32768); } != 0) {
			v1 = v1 + 20;
		}
		v2 = W_RARE_DROP_RATE;
		if ({ Command(Cmd_TestEquipBuff, .f = 65536); } != 0) {
			v2 = v2 + 20;
		}
	}
	Command(Cmd_Random, .p = (u8)100);
	if (result < v2) {
		S_ROLLED_DROP = p1;
	} else if (result < v1 + v2) {
		S_ROLLED_DROP = p0;
	} else {
		S_ROLLED_DROP = -1;
	}
	if ((S_ROLLED_DROP & (u8)255) < (u8)78 && (S_ROLLED_DROP & (u8)255) >= 0) {
		return 1;
	} else {
		return 0;
	}
}

