// 0x08D2478E
Scr_0x022F() {
	v1 = p0 - PLAYER_X;
	v2 = p1 - PLAYER_Z;
	if (v1 < 0) {
		v1 = v1 * -1;
	}
	if (v2 < 0) {
		v2 = v2 * -1;
	}
	if (PLAYER_DIR == 1) {
		if (v1 < v2 && p1 < PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 2) {
		if (p0 > PLAYER_X && p1 < PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 3) {
		if (v1 > v2 && p0 > PLAYER_X) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 4) {
		if (p0 > PLAYER_X && p1 > PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 5) {
		if (v1 < v2 && p1 > PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 6) {
		if (p0 < PLAYER_X && p1 > PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 7) {
		if (v1 > v2 && p0 < PLAYER_X) {
			return 1;
		} else {
			return 0;
		}
	} else if (PLAYER_DIR == 0) {
		if (p0 < PLAYER_X && p1 < PLAYER_Z) {
			return 1;
		} else {
			return 0;
		}
	} else {
		return 1;
	}
}

