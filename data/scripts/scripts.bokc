		case 2: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10A4));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		case 3: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10A8));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		case 4: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10AD));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		case 5: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10B2));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		case 6: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10B6));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
		default: {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10B9));
