// 0x08D6E8B7, 称号の本がまだ封印されている
Scr_LibraryTitleBookSealed() {
	Scr_BeginEventLockPlayer();
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LibraryBookUnlocked));
