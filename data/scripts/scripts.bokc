Scr_0x009F() {
	if (BIT(world + 0x40, 1)) {
		BIT(world + 0x40, 1) = 0;
		Command(Cmd_BackupState, BIT(world + 0x40, 1));
	}
	Scr_0x0022();
	Scr_0x009B();
}

// 0x08D1A0EB
Scr_0x00A0() {
	if (BIT(scratch + 0x14, 1) == 1) {
		LoadMap(p0, .n);
	} else {
		LoadMap(p0);
	}
}

// 0x08D1A110
Scr_0x00A1() {
	if (p0 == -1) {
		BIT(scratch + 0x14, 1) = 1;
	} else {
		SetZoneCallback(p0, (u16)62955, .m = (u16)3538, .e = {
			BIT(scratch + 0x14, 1) = 1;
		});
	}
}

// 0x08D1A149
Scr_0x1733() {
	BIT(world + 0xC, 4) = 1;
	W_PREV_PREV_ROOM = W_PREV_ROOM;
	W_PREV_ROOM = ROOM;
	W_UNK_186 = p1;
	ROOM = p2;
	BIT(world + 0x1FB, 4) = 1;
	BIT(world + 0x1FB, 5) = 1;
	LoadMap(p0);
}

// 0x08D1A190, p0=map, p1=entrance, p2=room フェードせずにマップ map の入口 entrance (部屋 room) へ移る
Scr_Warp() {
	BIT(world + 0xC, 4) = 1;
	Scr_0x009F();
	W_PREV_PREV_ROOM = W_PREV_ROOM;
	W_PREV_ROOM = ROOM;
	W_UNK_186 = p1;
	ROOM = p2;
	BIT(world + 0x1FB, 4) = 1;
	BIT(world + 0x1FB, 5) = 1;
	Scr_0x00A0(p0);
}

// 0x08D1A1DA, p0=map, p1=entrance, p2=room 16 フレームで暗転してマップ map の入口 entrance (部屋 room) へ移る
Scr_FadeWarp() {
	Scr_FadeWarpEx(p0, p1, p2, 0, 16);
}

// 0x08D1A1E5
Scr_0x00A4() {
	Scr_FadeWarpEx(p0, p1, p2, p3, 16);
}

// 0x08D1A1F0
Scr_0x00A5() {
	BIT(world + 0x40, 2) = 1;
}

// 0x08D1A1FA, Scr_FadeWarp の全引数版, p3: 移る直前に呼ぶスクリプト, p4: フェード時間
Scr_FadeWarpEx() {
	Scr_BeginEvent(0);
	if (BIT(world + 0xC, 5) == 0) {
		Command(Cmd_LockPlayer);
	}
	Scr_FadeScreen(5, 0, p4);
	BIT(world + 0xC, 4) = 1;
	BIT(world + 0x1FB, 4) = 1;
	BIT(world + 0x1FB, 5) = 1;
	Scr_0x009F();
	W_PREV_PREV_ROOM = W_PREV_ROOM;
	W_PREV_ROOM = ROOM;
	W_UNK_186 = p1;
	ROOM = p2;
	Chara(Cmd_Delay, (u16)0x5F25, .t = p4, .a = [p0, p3], .e = {
		Scr_EndEvent();
		if (p1 != 0) {
			ScriptCall(p1, 0);
		}
		if (BIT(world + 0xC, 5) == 0) {
			Command(Cmd_UnlockPlayer);
		}
		Scr_0x00A0(p0);
	});
}

// 0x08D1A2B1, ゾーン p0 にプレイヤーが高さ p4 (タイル) でいる間, p1 のマップの入口 p2 (部屋 p3) へ歩かずに移る
Scr_AddExitAtHeight() {
	SetZoneCallback(p0, (u16)62955, .m = (u16)5399, .w = [p4, p5, p2, p3], .s = p1, .e = {
		S_TMP_POS_Y = (p6 << 8) - PLAYER_Y;
		if (S_TMP_POS_Y < 0) {
			S_TMP_POS_Y = S_TMP_POS_Y * -1;
		}
		if (BIT(world + 0xC, 4) == 0 && BIT(world + 0x4C, 6) == 0 && { Command(Cmd_IsPlayerDead); } == 0 && S_TMP_POS_Y < (s16)256) {
			W_PREV_PREV_ROOM = W_PREV_ROOM;
			W_PREV_ROOM = ROOM;
			W_UNK_186 = p8;
			ROOM = p9;
			BIT(world + 0x4C, 6) = 1;
			Scr_0x009D(p1, 0, p10, 3);
		} else if (S_TMP_POS_Y >= (s16)256) {
			BIT(world + 0x4C, 6) = 0;
		}
	});
}

// 0x08D1A37C
Scr_0x00A8() {
	if (W_UNK_186 == p2 || BIT(scratch + 0x17, 5) == 1) {
		BIT(scratch + 0x17, 5) = 1;
	} else {
		BIT(scratch + 0x17, 5) = 0;
	}
	SetZoneCallback(p0, (u16)62955, .m = (u16)5321, .w = [p4, p2, p3], .s = p1, .e = {
		if (BIT(world + 0xC, 4) == 0 && BIT(scratch + 0x17, 5) == 0 && p2 == (u16)3538) {
			Scr_BeginEventLockPlayer();
			W_PREV_PREV_ROOM = W_PREV_ROOM;
			W_PREV_ROOM = ROOM;
			W_UNK_186 = p7;
			ROOM = p8;
			Scr_0x009D(p1, 0, p10, 3);
		} else if (p2 == (u16)54732) {}
	});
}

// 0x08D1A424
Scr_0x00A9() {
	SetZoneCallback(p0, (u16)62955, .m = (u16)5321, .w = [p1, p2, p3, p4], .s = [p5, p6, p7], .e = {
		S_UNK_03C = p10;
		if (p2 == (u16)3538) {
			if (BIT(scratch + 0x17, 5) == 1 && BIT(world + 0x4C, 0) == 0) {
				S_UNK_03E = p7;
				S_UNK_03F = p8;
				Scr_0x00B4(p1);
				Chara(Cmd_Delay, (u16)0xA9A3, .t = 10, .a = [S_EXIT_DIR, p12, p10], .e = {
					Mesg(0xA9A3, (u16)65535);
					Scr_0x0150(p2, S_UNK_03E, S_UNK_03F);
					Scr_0x0160(p0, (s16)256, p1);
				});
			} else if (BIT(scratch + 0x17, 5) == 0 && BIT(world + 0x4C, 0) == 0) {
				S_UNK_03E = p8;
				S_UNK_03F = p6;
				Scr_GetZoneBounds(p1);
				Scr_0x00B4(p1);
				Command(Cmd_MovePlayerTo, .p = [S_ZONE_CENTER_X, PLAYER_Y, S_ZONE_CENTER_Z], .d = S_EXIT_DIR, .e = p11);
			}
		} else if (p2 == (u16)54732) {
			BIT(scratch + 0x17, 5) = 0;
		}
	});
}

// 0x08D1A533
Scr_0x00AA() {
	Command(Cmd_LockPlayer);
	Scr_0x0150(S_UNK_03C, S_UNK_03E, S_UNK_03F);
}

// 0x08D1A54F
Scr_0x00AB() {
	Scr_EndEventUnlockPlayer();
	Scr_0x0150(S_UNK_03C, S_UNK_03E, S_UNK_03F);
}

// 0x08D1A567
Scr_0x00AC() {
	Scr_0x00AD(p0, p1, 0, 0);
}

// 0x08D1A571
Scr_0x00AD() {
	Scr_SpawnExitArrow(p0);
	Scr_SpawnExitArrow(p1);
	SetZoneCallback(p0, (u16)62955, .m = (u16)5321, .s = [p0, p1, p2], .e = {
		if (p2 == (u16)3538 && BIT(scratch + 0x17, 6) == 0) {
			Scr_0x00B4(p1);
			Scr_0x00AE(p10, p11, S_EXIT_DIR, 0, p3, p4, p5, p12);
		} else if (p2 == (u16)54732) {
			BIT(scratch + 0x17, 6) = 0;
		}
	});
	SetZoneCallback(p1, (u16)62955, .m = (u16)5321, .s = [p0, p1, p3], .e = {
		if (p2 == (u16)3538 && BIT(scratch + 0x17, 6) == 0) {
			Scr_0x00B4(p1);
			Scr_0x00AE(p11, p10, S_EXIT_DIR, 0, p3, p4, p5, p12);
		} else if (p2 == (u16)54732) {
			BIT(scratch + 0x17, 6) = 0;
		}
	});
}

// 0x08D1A634
Scr_0x00AE() {
	BIT(scratch + 0x17, 6) = 1;
	Scr_BeginEvent(0);
	if (PLAYER_ACTION == 6) {
		Command(Cmd_PullCoffinTo, .p = [PLAYER_X, PLAYER_Y, PLAYER_Z]);
	} else {
		Command(Cmd_LockPlayer);
	}
	Scr_0x0103();
	Scr_FadeScreen(5, 0, 16);
	Scr_GetZoneBounds(p0);
	S_ZONE_OFFSET_X = p4 - S_ZONE_MIN_X;
	S_ZONE_OFFSET_Z = p6 - S_ZONE_MIN_Z;
	Command(Cmd_A39F, PLAYER_X, PLAYER_Z, S_TILE_STAIRS);
	v1 = p2;
	if (S_TILE_STAIRS == 1) {
		if (PLAYER_Z - S_ZONE_MIN_Z < (u8)128) {
			v1 = 5;
		} else {
			v1 = 1;
		}
	} else if (S_TILE_STAIRS == 2) {
		if (PLAYER_X - S_ZONE_MIN_X < (u8)128) {
			v1 = 3;
		} else {
			v1 = 7;
		}
	}
	Scr_GetZoneBounds(p1);
	if (p3 == 1) {
		Scr_0x00B0(v1, (u8)250);
		if (PLAYER_ACTION == 6) {
			Command(Cmd_PullCoffinTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z], .d = W_COFFIN_DIR);
		} else {
			Command(Cmd_MovePlayerTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z]);
		}
	}
	if (v1 == 1) {
		S_WALK_TARGET_X = S_ZONE_MIN_X + S_ZONE_OFFSET_X;
		S_WALK_TARGET_Z = S_ZONE_MIN_Z - 5;
	} else if (v1 == 3) {
		S_WALK_TARGET_X = S_ZONE_MAX_X + 5;
		S_WALK_TARGET_Z = S_ZONE_MIN_Z + S_ZONE_OFFSET_Z;
	} else if (v1 == 5) {
		S_WALK_TARGET_X = S_ZONE_MIN_X + S_ZONE_OFFSET_X;
		S_WALK_TARGET_Z = S_ZONE_MAX_Z + 5;
	} else {
		S_WALK_TARGET_X = S_ZONE_MIN_X - 5;
		S_WALK_TARGET_Z = S_ZONE_MIN_Z + S_ZONE_OFFSET_Z;
	}
	Mesg(0x3C77, (u16)2, 17, 6);
	Mesg(0x3C77, (u16)2, 23, 6);
	Chara(Cmd_Delay, (u16)0x5F25, .a = [v1, p3, p7], .t = 16, .e = {
		Command(Cmd_SetPlayerPos, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z]);
		if (PLAYER_ACTION == 6) {
			Command(Cmd_4561, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z]);
			Command(Cmd_PullCoffinTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z]);
		}
		Scr_FadeScreen(4, 0, 16);
		BIT(scratch + 0x17, 6) = 0;
		if (p1 == 1) {
			Scr_0x00B2(p0, (u8)250, S_WALK_TARGET_X, S_WALK_TARGET_Z);
			if (p2 != 0) {
				if (PLAYER_ACTION == 6) {
					Command(Cmd_PullCoffinTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z], .f = 1, .e = p2);
				} else {
					Command(Cmd_MovePlayerTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z], .e = p2);
				}
			} else {
				if (PLAYER_ACTION == 6) {
					Command(Cmd_PullCoffinTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z], .f = 1, .e = (u24)Scr_0x00AF);
				} else {
					Command(Cmd_MovePlayerTo, .p = [S_WALK_TARGET_X, (s16)256, S_WALK_TARGET_Z], .e = (u24)Scr_0x00AF);
				}
			}
		} else {
			if (p2 != 0) {
				ScriptCall(p2, 0);
			} else {
				Scr_0x00AF();
			}
		}
	});
}

// 0x08D1A9B6
Scr_0x00AF() {
	Scr_EndEvent();
	Command(Cmd_UnlockPlayer);
}

// 0x08D1A9C5
Scr_0x00B0() {
	if (p0 == 1) {
		S_WALK_TARGET_X = PLAYER_X;
		S_WALK_TARGET_Z = PLAYER_Z - p1;
	} else if (p0 == 3) {
		S_WALK_TARGET_X = PLAYER_X + p1;
		S_WALK_TARGET_Z = PLAYER_Z;
	} else if (p0 == 5) {
		S_WALK_TARGET_X = PLAYER_X;
		S_WALK_TARGET_Z = PLAYER_Z + p1;
	} else if (p0 == 7) {
		S_WALK_TARGET_X = PLAYER_X - p1;
		S_WALK_TARGET_Z = PLAYER_Z;
	}
}

// 0x08D1AA57
Scr_0x00B1() {
	Scr_GetZoneBounds(p0);
	if (p1 == 1 || p1 == 5) {
		v1 = (S_ZONE_MAX_X - S_ZONE_MIN_X >> 8) + 1;
		v3 = (PLAYER_X - S_ZONE_MIN_X >> 8) + 1;
		W_EXIT_POS_RATIO = (v3 << 8) / v1 - 1;
	} else if (p1 == 3 || p1 == 7) {
		v2 = (S_ZONE_MAX_Z - S_ZONE_MIN_Z >> 8) + 1;
		v3 = (PLAYER_Z - S_ZONE_MIN_Z >> 8) + 1;
		W_EXIT_POS_RATIO = (v3 << 8) / v2 - 1;
	}
}

// 0x08D1AAE6
Scr_0x00B2() {
	if (p0 == 1) {
		S_WALK_TARGET_X = p2;
		S_WALK_TARGET_Z = p3 - p1;
	} else if (p0 == 3) {
		S_WALK_TARGET_X = p2 + p1;
		S_WALK_TARGET_Z = p3;
	} else if (p0 == 5) {
		S_WALK_TARGET_X = p2;
		S_WALK_TARGET_Z = p3 + p1;
	} else if (p0 == 7) {
		S_WALK_TARGET_X = p2 - p1;
		S_WALK_TARGET_Z = p3;
	}
}

// 0x08D1AB60
Scr_0x00B3() {
	Scr_GetZoneBounds(p0);
	if (p2 == 1) {
		if (p1 == 1 || p1 == 5) {
			v1 = (S_ZONE_MAX_X - S_ZONE_MIN_X >> 8) + 1;
			v3 = v1 * W_EXIT_POS_RATIO >> 8;
			PLAYER_X = S_ZONE_MIN_X + (u8)128 + (v3 << 8);
			PLAYER_Z = S_ZONE_MIN_Z + (u8)128;
		} else if (p1 == 3 || p1 == 7) {
			v2 = (S_ZONE_MAX_Z - S_ZONE_MIN_Z >> 8) + 1;
			v3 = v2 * W_EXIT_POS_RATIO >> 8;
			PLAYER_X = S_ZONE_MIN_X + (u8)128;
			PLAYER_Z = S_ZONE_MIN_Z + (u8)128 + (v3 << 8);
		}
	} else if (p2 == 4) {
		if (p1 == 1) {
			PLAYER_X = S_ZONE_CENTER_X;
			PLAYER_Z = S_ZONE_MAX_Z - 1;
		} else if (p1 == 5) {
			PLAYER_X = S_ZONE_CENTER_X;
			PLAYER_Z = S_ZONE_MIN_Z + 1;
		} else if (p1 == 3) {
			PLAYER_X = S_ZONE_MIN_X + 1;
			PLAYER_Z = S_ZONE_CENTER_Z;
		} else if (p1 == 7) {
			PLAYER_X = S_ZONE_MAX_X - 1;
			PLAYER_Z = S_ZONE_CENTER_Z;
		}
	} else {
		PLAYER_X = S_ZONE_CENTER_X;
		PLAYER_Z = S_ZONE_CENTER_Z;
	}
	PLAYER_DIR = p1;
}

// 0x08D1ACD8
Scr_0x00B4() {
	S_EXIT_DIR = 1;
	Scr_GetZoneBounds(p0);
	v5 = S_ZONE_MAX_X - S_ZONE_MIN_X;
	v6 = S_ZONE_MAX_Z - S_ZONE_MIN_Z;
	v1 = PLAYER_X - S_ZONE_MIN_X;
	v2 = S_ZONE_MAX_X - PLAYER_X;
	v3 = PLAYER_Z - S_ZONE_MIN_Z;
	if (v5 > v6) {
		v4 = v5 / v6;
		v1 = v1 / v4;
		v2 = v2 / v4;
	} else if (v5 < v6) {
		v4 = v6 / v5;
		v3 = v3 / v4;
	}
	if (v1 >= v3 && v2 >= v3) {
		v7 = 2;
		S_EXIT_DIR = 5;
		if (PLAYER_ACTION != 4) {
			if (PLAYER_DIR == 3) {
				S_EXIT_DIR = 3;
			} else if (PLAYER_DIR == 2) {
				S_EXIT_DIR = 3;
			} else if (PLAYER_DIR == 0) {
				S_EXIT_DIR = 7;
			} else if (PLAYER_DIR == 7) {
				S_EXIT_DIR = 7;
			}
		}
	} else if (v1 <= v3 && v2 <= v3) {
		v7 = 6;
		S_EXIT_DIR = 1;
		if (PLAYER_ACTION != 4) {
			if (PLAYER_DIR == 3) {
				S_EXIT_DIR = 3;
			} else if (PLAYER_DIR == 4) {
				S_EXIT_DIR = 3;
			} else if (PLAYER_DIR == 6) {
				S_EXIT_DIR = 7;
			} else if (PLAYER_DIR == 7) {
				S_EXIT_DIR = 7;
			}
		}
	} else if (v1 <= v3 && v2 >= v3) {
		v7 = 4;
		S_EXIT_DIR = 3;
		if (PLAYER_ACTION != 4) {
			if (PLAYER_DIR == 1) {
				S_EXIT_DIR = 1;
			} else if (PLAYER_DIR == 0) {
				S_EXIT_DIR = 1;
			} else if (PLAYER_DIR == 6) {
				S_EXIT_DIR = 5;
			} else if (PLAYER_DIR == 5) {
				S_EXIT_DIR = 5;
			}
		}
	} else if (v1 >= v3 && v2 <= v3) {
		v7 = 8;
		S_EXIT_DIR = 7;
		if (PLAYER_ACTION != 4) {
			if (PLAYER_DIR == 1) {
				S_EXIT_DIR = 1;
			} else if (PLAYER_DIR == 2) {
				S_EXIT_DIR = 1;
			} else if (PLAYER_DIR == 4) {
				S_EXIT_DIR = 5;
			} else if (PLAYER_DIR == 5) {
				S_EXIT_DIR = 5;
			}
		}
	} else {
		if (PLAYER_DIR & 1) {
			S_EXIT_DIR = PLAYER_DIR;
		} else {
			S_EXIT_DIR = PLAYER_DIR + 1 & 7;
		}
	}
	if (PLAYER_ACTION == 24 || PLAYER_ACTION == 25) {
		Scr_0x00B5(v7);
	}
}

// 0x08D1AFCF
Scr_0x00B5() {
	v1 = p0 + PLAYER_DIR & 7;
	if (v1 == 7) {
		if (p0 == 6) {
			S_EXIT_DIR = 5;
		} else if (p0 == 2) {
			S_EXIT_DIR = 1;
		} else if (p0 == 8) {
			S_EXIT_DIR = 3;
		} else if (p0 == 4) {
			S_EXIT_DIR = 7;
		}
	} else if (v1 == 2 || v1 == 3 || v1 == 4) {} else if (v1 == 0 || v1 == 1) {
		if (p0 == 6) {
			S_EXIT_DIR = 7;
		} else if (p0 == 2) {
			S_EXIT_DIR = 3;
		} else if (p0 == 8) {
			S_EXIT_DIR = 5;
		} else if (p0 == 4) {
			S_EXIT_DIR = 1;
		}
	} else if (v1 == 5 || v1 == 6) {
		if (p0 == 6) {
			S_EXIT_DIR = 3;
		} else if (p0 == 2) {
			S_EXIT_DIR = 7;
		} else if (p0 == 8) {
			S_EXIT_DIR = 1;
		} else if (p0 == 4) {
			S_EXIT_DIR = 5;
		}
	}
}

// 0x08D1B0FF, ゾーン p0 の範囲と中心を scratch + 0x22..0x4A に入れる
Scr_GetZoneBounds() {
	Command(Cmd_GetZoneBounds, p0, S_ZONE_MIN_X, S_ZONE_MIN_Y, S_ZONE_MIN_Z, S_ZONE_MAX_X, S_ZONE_MAX_Y, S_ZONE_MAX_Z, S_ZONE_CENTER_X, S_ZONE_CENTER_Y, S_ZONE_CENTER_Z);
}

// 0x08D1B130, 当たり判定マップを読み BG 用フラグを既定にする, p0: 未使用, p1: ファイルID
Scr_LoadCollisionMap() {
	Scr_0x00B8(p0, p1, 3, 0);
}

// 0x08D1B13A
Scr_0x00B8() {
	Command(Cmd_LoadMap, .n = p0, .p = p1);
	Command(Cmd_SetCameraTilemapOffset, .v = p3);
	S_MAP_BG_FLAGS = p2;
}

// 0x08D1B15F, マップのタイルマップを BG にする, p0: タイルマップ, p1: 0 なら BG2, 1 なら BG3
Scr_CreateMapBG() {
	if (p1 == 0) {
		Chara(Cmd_CreateBG, (u16)0x1112, .f = S_MAP_BG_FLAGS, .i = 2, .d = p0, .s = [0, 0], .p = 3);
	} else {
		Chara(Cmd_CreateBG, (u16)0x1113, .f = S_MAP_BG_FLAGS, .i = 3, .d = p0, .s = [0, 0], .p = 3);
	}
}

// 0x08D1B1B4, BG を作る, p0: エンティティID, p1: タイルマップ, p2: 優先度, p3: BG 番号
Scr_CreateBG() {
	Chara(Cmd_CreateBG, p0, .f = S_MAP_BG_FLAGS, .i = p3, .d = p1, .s = [0, 0], .p = p2);
}

