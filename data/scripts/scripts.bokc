// 0x08D152DE
Scr_0x0021() {
	if ({ Scr_0x0025(); } == 1) {
		if (ROOM >= 5 && ROOM <= 11) {} else if (ROOM >= (u8)162 && ROOM <= (u8)167) {} else {}
		W_COFFIN_DEST_X = 0;
		W_COFFIN_DEST_Z = 0;
		if (BIT(world + 0x182, 5) == 1) {
			W_COFFIN_X = PLAYER_X;
			W_COFFIN_Z = PLAYER_Z;
			W_COFFIN_DIR = PLAYER_DIR;
		} else {}
		if (BIT(world + 0xC, 2) == 0) {
			if (BIT(world + 0x182, 5) == 1) {
				Scr_0x0031();
			}
			if ({ Command(Cmd_GetCoffinID); } == 5) {
				Scr_0x003D();
			} else {
				Scr_0x0028();
			}
			if (BIT(world + 0x182, 5) != 1 && BIT(world + 0x4C, 3) != 1 && BIT(world + 0xC, 6) != 1 && W_COFFIN_ROOM != (u8)255) {
				Scr_0x0030();
			}
			if (ROOM == W_COFFIN_ROOM || BIT(world + 0x182, 5) == 1 || W_COFFIN_ROOM == (u8)255) {
				Command(Cmd_4B41, W_COFFIN_X, W_COFFIN_Z, S_TILE_ATTR);
				if (S_TILE_ATTR & (u8)65) {
					Scr_0x0040();
				}
			}
		}
		if (W_COFFIN_HOLDS_DARK_DJANGO == 1 && W_PILE_DRIVER_STATE <= 2) {
			Chara(CoffinTimer_Create, (u16)0x58DF, .s = 20);
		}
		BIT(scratch + 0x17, 0) = 0;
		if (ROOM == W_COFFIN_ROOM || BIT(world + 0x51, 2) == 1 || BIT(world + 0x4C, 3) == 1 || BIT(world + 0x182, 5) == 1) {
			BIT(scratch + 0x17, 0) = 1;
			if (W_COFFIN_ROOM == (s16)256) {
				W_COFFIN_X = (s16)2304;
				W_COFFIN_Z = (s16)2000;
			}
			W_COFFIN_ROOM = ROOM;
			Command(Cmd_0CD4, (W_COFFIN_X), (W_COFFIN_Z), S_TMP_POS_Y);
