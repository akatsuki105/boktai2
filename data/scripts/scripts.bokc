// 0x08D96074, 闘技場のランク選択
Scr_ArenaRankSelect() {
	if (W_ARENA_RANK != 0) {
		Scr_ArenaRankAnnounce();
	} else {
		if (BIT(world + 0x155, 0)) {
			Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_Arena_0782));
		} else {
			Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_Arena_0783));
		}
		if (BIT(world + 0x155, 1)) {
			Command(Cmd_SetMessageWindowExtend, 1, StringRef(Str_Arena_0782));
		} else {
			Command(Cmd_SetMessageWindowExtend, 1, StringRef(Str_Arena_0783));
		}
		if (BIT(world + 0x155, 2)) {
			Command(Cmd_SetMessageWindowExtend, 2, StringRef(Str_Arena_0782));
		} else {
			Command(Cmd_SetMessageWindowExtend, 2, StringRef(Str_Arena_0783));
		}
		if (BIT(world + 0x155, 3)) {
			Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_Arena_0782));
		} else {
			Command(Cmd_SetMessageWindowExtend, 3, StringRef(Str_Arena_0783));
		}
		BIT(scratch + 0x14, 4) = 0;
		Scr_BeginEventLockPlayer();
		Scr_OpenChoiceCancelable((u16)61298, (u24)Scr_0x0F6A, 0, 0);
		if (BIT(world + 0x155, 2) == 1) {
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_ArenaRankSelectLv4));
		} else if (BIT(world + 0x155, 1) == 1 && W_CROSSOVER_PROGRESS >= 13) {
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_ArenaRankSelectLv3));
		} else if (BIT(world + 0x155, 0) == 1) {
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_ArenaRankSelectLv2));
		} else {
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_ArenaRankSelectLv1));
		}
	}
}

