			} else if (W_KURO_EVENT_STEP == 2) {
				S_ACTOR_POS_X = (s16)4352;
				S_ACTOR_POS_Y = (s16)768;
				S_ACTOR_POS_Z = (s16)1792;
				S_ACTOR_ANGLE = (u8)128;
				S_ACTOR_INIT_MODE = 0;
				v1 = 1;
			} else if (W_KURO_EVENT_STEP == 3) {
				S_ACTOR_POS_X = (s16)1536;
				S_ACTOR_POS_Y = (s16)768;
				S_ACTOR_POS_Z = (s16)1792;
				S_ACTOR_ANGLE = (u8)128;
				S_ACTOR_INIT_MODE = 0;
				v1 = 1;
			}
		} else {
			if (W_WAREHOUSE_LEVEL == 0) {
				S_ACTOR_POS_X = (s16)5824;
				S_ACTOR_POS_Y = (s16)256;
				S_ACTOR_POS_Z = (s16)2368;
				S_ACTOR_ANGLE = (u8)64;
				S_ACTOR_INIT_MODE = 2;
				v1 = 1;
			}
		}
	} else if (W_STORY_PROGRESS >= (u8)63) {
		if (W_WAREHOUSE_LEVEL == 0) {}
	}
	if (v1 == 1) {
		if (W_STORY_PROGRESS < 48) {
			Command(Cmd_D774, .n = (u16)20962, .p = [S_ACTOR_POS_X, S_ACTOR_POS_Y, S_ACTOR_POS_Z], .d = S_ACTOR_ANGLE, .w = [(s16)256, (s16)256, (s16)512], .H = [S_UNK_176, S_UNK_178], .i = S_ACTOR_INIT_MODE, .t = (u24)Scr_TalkKuroOutside);
