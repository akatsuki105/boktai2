	}
	if (W_TITLE_EARNED(11) == 1) {
		Command(Cmd_SetMessageWindowExtend, 11, StringRef(Str_LibraryTitleGrandMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 11, StringRef(Str_LibraryTitleUnlocked));
	}
	if ({ Scr_0x0259(); } == 12) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LibraryTitleCompleted));
	} else {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LibraryTitle));
	}
	Scr_OpenMsgWindow(3, (u24)Scr_0x0B0E, 0);
}

