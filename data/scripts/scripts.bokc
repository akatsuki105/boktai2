	DebugPrint("quality", p4);
	DebugPrint("special", p5);
	DebugPrint("great", p6);
	DebugPrint("good", p7);
	DebugPrint("bad", p8);
	DebugPrint("skill", p9);
	W_FORGE_SPECIAL = p5;
	W_FORGE_QUALITY = p4;
	W_FORGE_GREAT_COUNT = p6;
	W_FORGE_GOOD = p7;
	W_FORGE_BAD = p8;
	W_FORGE_TYPE = p1;
	W_FORGE_SKILL = p9;
	W_FORGE_RANK = p2;
	W_FORGE_NAME = p0;
	W_UNK_186 = (u8)195;
	Scr_BeginEventLockPlayer();
	Scr_PlayBgm(1, 0);
	Scr_FadeScreenEx(5, 0, 32, 65535, 0, (u24)Scr_0x0AD5);
}

