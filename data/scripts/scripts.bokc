		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
		Scr_SetMsgWindowScripts((u24)Scr_EndEventCloseMsg, (u24)Scr_0x0219);
	}
	S_RITA_TREE_TALK_COUNT = S_RITA_TREE_TALK_COUNT + 1;
}

