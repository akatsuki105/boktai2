// 0x08D27E23
Scr_0x0281() {
	S_UNK_10C = p9;
	if (p8 > 5) {
		v1 = 5;
	} else {
		v1 = p8;
	}
	Command(Cmd_ForEach, .a = 8, .r = v1, .d = [(p0), p7, p4, p5, p6, p1, p3, p2, (p0 + 10), p7, p4, p5, p6, p1, p3, p2, (p0 + 20), p7, p4, p5, p6, p1, p3, p2, (p0 + 30), p7, p4, p5, p6, p1, p3, p2, (p0 + 40), p7, p4, p5, p6, p1, p3, p2], .e = {
		if (p4 == 0) {
			S_TMP_POS_X = p5 + { Command(Cmd_Random, .p = (p2 * (s16)256)); };
			S_TMP_POS_Y = p7 + { Command(Cmd_Random, .p = (p3 * (s16)256 - (u8)128)); } + (u8)128;
			S_TMP_POS_Z = p6;
		} else {
			S_TMP_POS_X = p5;
			S_TMP_POS_Z = p6 + { Command(Cmd_Random, .p = (p2 * (s16)256)); };
			S_TMP_POS_Y = p7 + { Command(Cmd_Random, .p = (p3 * (s16)256 - (u8)128)); } + (u8)128;
		}
		Scr_0x0283(p0, S_UNK_10C, (S_TMP_POS_X), (S_TMP_POS_Y), (S_TMP_POS_Z), (1 - p4), p1);
	});
}

