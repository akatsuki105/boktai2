		BIT(scratch + 0x14, 4) = 0;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_LearnDash));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A2D, 0);
		Scr_SetMsgWindowScripts((u24)Scr_0x0A2D, (u24)Scr_0x0A2C);
	});
}

