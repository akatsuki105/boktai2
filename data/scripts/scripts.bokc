// 0x08D30D6A, 暗黒ローンのおしおきの進行, 発電部屋へ連行して操作説明をして発電を始める
Scr_DarkLoanPunishment() {
	switch (S_TORTURE_STEP) {
		case 0: {
			S_TORTURE_STEP = 1;
			Scr_BeginEvent(0);
			Scr_CreateMapPltt((u16)55676, 0, 0);
			Scr_FadeScreen(4, 0, 16);
			DebugPrint("$i:暗黒ローン残量", DARK_DEBTS);
			if (DARK_DEBTS < (s16)1000) {
				BIT(scratch + 0xB9, 6) = 1;
				BIT(scratch + 0xB9, 7) = 0;
				BIT(scratch + 0x12D, 0) = 0;
			} else if (DARK_DEBTS < (s16)2000) {
				BIT(scratch + 0xB9, 6) = 0;
				BIT(scratch + 0xB9, 7) = 1;
				BIT(scratch + 0x12D, 0) = 0;
			} else {
				BIT(scratch + 0xB9, 6) = 0;
				BIT(scratch + 0xB9, 7) = 0;
				BIT(scratch + 0x12D, 0) = 1;
			}
			Command(Cmd_E6F2, .f = 1);
			Scr_PlayBgm(1, 0);
			Scr_0x0368(0, (s16)-15);
			if (W_TORTURE_COUNT < (u8)100) {
				W_TORTURE_COUNT = W_TORTURE_COUNT + 1;
			}
			switch (TORTURE_COUNT) {
				case 1: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00DE));
				}
				case 2: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00EB));
				}
				case 3: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00F0));
				}
				case 4: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00F5));
				}
				case 5: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00FC));
				}
				default: {
					Command(Cmd_OpenMessageWindow, .r = StringRef(Str_00FC));
				}
			}
			Scr_OpenMsgWindow(3, (u24)Scr_DarkLoanPunishment, 0);
		}
		case 1: {
			S_TORTURE_STEP = 2;
			Scr_CreateMapBG((u16)49837, 0);
			Scr_FadeScreen(4, 0, (u8)64);
			Chara(Cmd_Delay, (u16)0xEC51, .t = 1, .p = (u24)Scr_DarkLoanPunishment);
		}
		case 2: {
			if (TORTURE_COUNT == 1) {
				S_TORTURE_STEP = 3;
			} else {
				S_TORTURE_STEP = 4;
			}
			Command(Cmd_CloseMessageWindow);
			Command(Cmd_SetHUDMode, .m = 7);
			Command(Cmd_HideEntity8AF6, .n = (u16)16637);
			Scr_PlayBgm(4, (u8)162);
