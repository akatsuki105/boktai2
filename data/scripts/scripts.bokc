		} else if (p1 == 8) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookH));
		} else if (p1 == 9) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_BookI));
		} else if (p1 == 10) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_02A2));
		}
		Scr_BeginEventLockPlayer();
		S_UNK_014_4 = 0;
		Scr_OpenMsgWindow(3, (u24)Scr_0x042E, 0);
	}
}

