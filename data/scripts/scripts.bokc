	if (p0 == (u8)65) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeyCircle));
	} else if (p0 == (u8)66) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeyTriangle));
	} else if (p0 == (u8)67) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeySquare));
	}
	BIT(scratch + 0x14, 4) = 0;
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_UseKey));
	Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
}

// 0x08D1D1E2, 鍵がかかっている
Scr_DoorLocked() {
	if (p0 == (u8)65) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeyCircle));
	} else if (p0 == (u8)66) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeyTriangle));
	} else if (p0 == (u8)67) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_KeySquare));
	}
	BIT(scratch + 0x14, 4) = 0;
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_KeyDoor));
	if (p1 == 11 && ROOM == 20) {
		BIT(scratch + 0x14, 4) = 1;
		Scr_OpenMsgWindow(3, (u24)Scr_0x039E, 0);
	} else {
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
	}
}

// 0x08D1D278, 開閉する扉をゾーン p1 の辺 p2 に置く, p0: 扉ID, p3: 開いた状態で置くか, p4: 高さ
Scr_AddShutter() {
	Scr_GetZoneBounds(p1);
	v3 = S_ZONE_MIN_Y;
	if (p2 == 4 || p2 == 0) {
		v1 = S_ZONE_MAX_X;
		v2 = S_ZONE_MIN_Z;
	} else if (p2 == 5 || p2 == 1) {
		v1 = S_ZONE_MIN_X;
		v2 = S_ZONE_MAX_Z;
	} else {
		v1 = S_ZONE_MIN_X;
		v2 = S_ZONE_MIN_Z;
	}
	Scr_0x0110(p0, v1, v3, v2, p2, p3, p4);
}

