// 0x08D1B291, Scr_TrackZone に加え, MapSpot を p1 にする (棺桶を連れていれば棺桶の場所も)
Scr_TrackZoneMapSpot() {
	SetZoneCallback(p0, (u16)62955, .m = (u16)3538, .w = p1, .e = {
		Command(Cmd_40F8, p1);
		Command(Cmd_SetMapSpot, .f = p6);
		Command(Cmd_BackupState, STAGE_ID);
		Command(Cmd_BackupState, *((s16 *)(stat + 0x256)));
		if (PLAYER_ACTION == 6 || BIT(world + 0x51, 2) == 1 || BIT(scratch + 0x17, 1) == 1) {
			Command(Cmd_SetCoffinMapSpot, .f = p6);
			Command(Cmd_SetCoffinStage, .s = STAGE_ID);
			Command(Cmd_BackupState, *((s16 *)(stat + 0x258)));
			Command(Cmd_BackupState, *((s16 *)(stat + 0x25A)));
		}
	});
}

