// 0x08D2B21E, レベルを p0 にしてステータス/HP/エナジー/経験値を計算し直す
Scr_SetPlayerLevel() {
	*((s16 *)(stat + 0x40)) = p0;
	v1 = (p0 - 1) * 3 >> 2;
	STATS(0) = 10 + v1;
	STATS(1) = 10 + v1;
	STATS(2) = 10 + v1;
	STATS(3) = 10 + v1;
	SAVED_MAX_HP = (STATS(0) + STAT_BONUS(0)) * 10;
	SAVED_MAX_ENE = (STATS(1) + STAT_BONUS(1)) * 5 + (u8)100;
	SAVED_HP = SAVED_MAX_HP;
	SAVED_ENE = SAVED_MAX_ENE;
	PLAYER_EXP = { Command(Cmd_ReadTable, .r = StringRef(gExpTable), .i = (*((s16 *)(stat + 0x40)) - 1), .s = 1); } * 10;
}

