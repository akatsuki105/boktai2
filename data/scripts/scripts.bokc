		if ({ Command(Cmd_GetSolarGauge); } < 1) {
			if (BIT(scratch + 0x4E, 0) == 1) {
				BIT(scratch + 0x4E, 0) = 0;
				Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
				if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME <= 2) {
					Command(Cmd_CA7D, .i = 0, .n = p11, .f = 1);
				} else if (S_SPAN_OF_TIME == 3) {
					Command(Cmd_CA7D, .i = 1, .n = p13, .f = 1);
				}
			}
		} else {
			if (BIT(scratch + 0x4E, 0) == 0) {
				BIT(scratch + 0x4E, 0) = 1;
				Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
				if (S_SPAN_OF_TIME >= 1 && S_SPAN_OF_TIME <= 2) {
					Command(Cmd_CA7D, .i = 0, .n = p10, .f = 1);
				} else if (S_SPAN_OF_TIME == 3) {
					Command(Cmd_CA7D, .i = 1, .n = p12, .f = 1);
				}
			}
		}
	});
	SetZoneCallback(p0, (u16)62955, .m = (u16)5399, .s = [p5, p6], .e = {
		if ({ Command(Cmd_GetSolarGauge); } < 1) {
			if (BIT(scratch + 0x4E, 1) == 1) {
				BIT(scratch + 0x4E, 1) = 0;
				if (S_SPAN_OF_TIME >= 4 && S_SPAN_OF_TIME <= 5 || S_SPAN_OF_TIME == 0) {
					Command(Cmd_CA7D, .i = 2, .n = p11, .f = 1);
				}
			}
		} else {
			if (BIT(scratch + 0x4E, 1) == 0) {
				BIT(scratch + 0x4E, 1) = 1;
				if (S_SPAN_OF_TIME >= 4 && S_SPAN_OF_TIME <= 5 || S_SPAN_OF_TIME == 0) {
					Command(Cmd_CA7D, .i = 2, .n = p10, .f = 1);
				}
			}
		}
	});
}

