// 0x08D63E76, 登録した都道府県の名前をメッセージの変数に入れる
Scr_SetPrefectureName() {
	S_PREFECTURE_NO = { Command(Cmd_GetPrefecture); };
	DebugPrint("ちいきばんごう", S_PREFECTURE_NO);
	Command(Cmd_2575, 0, StringRef(Str_18BD), .i = (S_PREFECTURE_NO));
}

