// 0x08D1B3D9, マップ入場時の特別な場面 (ダンジョンタイトルなど) を出しているかを返す
Scr_IsMapEntryScene() {
	if (BIT(scratch + 0x14, 0) == 0) {
		return 0;
	} else {
		return 1;
	}
}

// 0x08D1B3FC, マップフラグ (stat + 0x934, MPF_*) に p0 を立てる
Scr_SetMapFlags() {
	if ((MAP_FLAGS & 2) == 0) {
		BIT(scratch + 0x17, 7) = 1;
	}
	MAP_FLAGS = MAP_FLAGS | p0;
}

// 0x08D1B426, マップフラグから p0 を落とす
Scr_ClearMapFlags() {
	BIT(scratch + 0x17, 7) = 0;
	MAP_FLAGS = MAP_FLAGS & ~(p0);
}

// 0x08D1B441, マップのパレット管理を作る, p0: 基本の BG パレット, p1/p2: 時間帯で混ぜるパレット (0 なら p0 のみ)
Scr_CreateMapPltt() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
	v4 = 2;
	v5 = 2;
	if (S_SPAN_OF_TIME == 0) {
		v4 = 2;
		v5 = 2;
	} else if (S_SPAN_OF_TIME == 1) {
		v4 = 2;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 2) {
		v4 = 0;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 3) {
		v4 = 0;
		v5 = 0;
	} else if (S_SPAN_OF_TIME == 4) {
		v4 = 0;
		v5 = 1;
	} else if (S_SPAN_OF_TIME == 5) {
		v4 = 1;
		v5 = 2;
	}
	v6 = 1;
	if (p0 == 0) {
		v1 = (u16)32861;
	} else {
		v1 = p0;
	}
	if (p1 == 0) {
		v2 = p0;
		v6 = 0;
	} else {
		v2 = p1;
	}
	if (p2 == 0) {
		v3 = p0;
		v6 = 0;
	} else {
		v3 = p2;
	}
	Chara(Entity4AE5_Create, (u16)0xE231, .f = v6, .c = v4, .m = v5, .p = [v1, v2, v3]);
}

// 0x08D1B564
