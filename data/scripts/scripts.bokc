// 0x08D63D42, ザジの会話の入口 (宿屋の太陽ダケ, 星読み, 体調を気にして薬をくれる, 雑談)
Scr_TalkZaji() {
	Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME2);
	if (BIT(world + 0x7D, 5) == 0) {
		Scr_BeginEventLockPlayer();
		BIT(world + 0x7D, 5) = 1;
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Zaji_13E4));
		Scr_OpenMsgWindow(3, (u24)Scr_EndEventCloseMsg, 0);
	} else if (BIT(world + 0x7D, 6) == 0) {
		Scr_ZajiStarReadingIntro();
		BIT(world + 0x7D, 6) = 1;
	} else if ({ Command(Cmd_IsKaamos); } == 1 && { Command(Cmd_HasItem, .i = 12); } == 0 && BIT(world + 0x7D, 7) == 0) {
		Scr_ZajiGiftCurseCure();
	} else {
		if (S_SPAN_OF_TIME2 == 4 || S_SPAN_OF_TIME2 == 5 || S_SPAN_OF_TIME2 == 0) {
			if ({ Command(Cmd_HasItem, .i = 23); } == 0 && BIT(world + 0x7D, 7) == 0) {
				Scr_ZajiGiftEnergyItem();
			} else {
				Scr_ZajiSmallTalk();
			}
		} else {
			if ({ Command(Cmd_HasItem, .i = 22); } == 0 && BIT(world + 0x7D, 7) == 0) {
				Scr_ZajiGiftLifeItem();
			} else {
				Scr_ZajiSmallTalk();
			}
		}
	}
}

