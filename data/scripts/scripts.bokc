	} else if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Shaian_0F9D));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A3D, 0);
