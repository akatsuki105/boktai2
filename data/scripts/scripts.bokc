// 0x08D65686
Scr_0x09F9() {
	if (W_STORY_PROGRESS < 12) {
		SetZoneCallback((u16)0x4CA7, (u16)0xF5EB, .m = (u16)0x0DD2, .e = {
			if (W_STORY_PROGRESS < 12) {
				Scr_0x1091();
			}
		});
	} else if (W_STORY_PROGRESS >= 48 && W_STORY_PROGRESS < 51) {
		if (W_ENTRANCE == (u8)136 || W_ENTRANCE == 21) {
			if (W_KURO_EVENT_STEP == 2) {
				W_KURO_EVENT_STEP = 3;
			}
		} else if (W_ENTRANCE == (u8)140) {
			if (W_KURO_EVENT_STEP >= 1 && W_KURO_EVENT_STEP < 5) {
				W_KURO_EVENT_STEP = 4;
			}
		}
		SetZoneCallback((u16)0x4CA7, (u16)0xF5EB, .m = (u16)0x0DD2, .e = {
			if (W_KURO_EVENT_STEP == 2) {
				W_KURO_EVENT_STEP = 3;
				Scr_0x10C1();
			}
		});
		SetZoneCallback((u16)0x4CA8, (u16)0xF5EB, .m = (u16)0x0DD2, .e = {
			if (W_KURO_EVENT_STEP == 2) {
				W_KURO_EVENT_STEP = 3;
				Scr_0x10C1();
			}
		});
		SetZoneCallback((u16)0x4CA9, (u16)0xF5EB, .m = (u16)0x0DD2, .e = {
			if (W_KURO_EVENT_STEP == 3) {
				W_KURO_EVENT_STEP = 4;
				Scr_0x10C2();
			}
		});
	}
}

