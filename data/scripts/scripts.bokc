	Scr_OpenMsgWindow(3, (u24)Scr_0x0B0E, 0);
}

// 0x08D6E8DC, 称号一覧の本を表示する, 12個そろうと完成の表示
Scr_LibraryShowTitles() {
	Scr_BeginEventLockPlayer();
	Scr_0x0258();
	if (W_TITLE_EARNED(0) == 1) {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_LibraryTitleSwordMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 0, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(1) == 1) {
		Command(Cmd_SetMessageWindowExtend, 1, StringRef(Str_LibraryTitleSpearMaster));
	} else {
		Command(Cmd_SetMessageWindowExtend, 1, StringRef(Str_LibraryTitleUnlocked));
	}
	if (W_TITLE_EARNED(2) == 1) {
