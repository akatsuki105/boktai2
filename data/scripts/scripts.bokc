	}
}

// 0x08D684E5, シャイアンとの会話を最初から始める
Scr_TalkShaianFromStart() {
	DebugPrint("キッド会話直接開始");
	BIT(scratch + 0x18F, 0) = 0;
	Scr_TalkShaian();
}

// 0x08D6850F, 武器屋シャイアンの会話の入口
Scr_TalkShaian() {
	BIT(scratch + 0x18F, 1) = BIT(scratch + 0x18F, 1) ^ 1;
	Scr_BeginEventLockPlayer();
	if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62 && BIT(world + 0x74, 2) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Shaian_0FCD));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A3D, 0);
		BIT(world + 0x74, 2) = 1;
	} else if (W_STORY_PROGRESS >= 62 && BIT(world + 0x74, 3) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Shaian_0FE0));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0A3D, 0);
		BIT(world + 0x74, 3) = 1;
	} else {
		if (BIT(world + 0x74, 5) == 0 && W_STORY_PROGRESS >= 46) {
			Scr_ShaianDashIntro();
		} else {
			Scr_ShaianMenuPrompt();
		}
	}
}

// 0x08D685BF, 「渡しておきたいものがある」, ダッシュ伝授の前置き
Scr_ShaianDashIntro() {
	S_SAVED_PLAYER_DIR = 0;
	S_SAVED_PLAYER_DIR = PLAYER_DIR;
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Shaian_0F82));
	Scr_OpenMsgWindow(3, (u24)Scr_0x0A29, 0);
}

// 0x08D685EB
Scr_0x0A29() {
	S_EVENT_STEP = 0;
	Chara(Cmd_Delay, (u16)0x5F25, .a = 0, .t = 2, .e = {
		switch (S_EVENT_STEP) {
			case 0: {
				S_EVENT_STEP = S_EVENT_STEP + 1;
				Scr_CloseMsgWindow();
				Chara(Entity99CA_Create, (u16)0xC967, .p = [PLAYER_X, PLAYER_Y, PLAYER_Z], .d = (u8)128, .t = (u8)120, .T = 6);
				Command(Cmd_PlaySound, .i = (s16)668);
				return (u8)100;
			}
			case 1: {
				S_EVENT_STEP = S_EVENT_STEP + 1;
				Command(Cmd_Retry);
				return 26;
			}
			case 2: {
				S_EVENT_STEP = 0;
				Scr_ShaianWindBlessing();
			}
		}
	});
}

// 0x08D686A1, 「風の祝福を得た!」
Scr_ShaianWindBlessing() {
