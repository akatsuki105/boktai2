// 0x08D20B56, 太陽タケノコを最大5個ばらまく, p0: 精霊虫の種類 (3 なら時間帯で抽選), p1: 精霊虫の数, p2/p3: 中心, p4: ばらつき, p5: 個数
Scr_SpawnBambooShoots() {
	if (p5 > 5) {
		v1 = 5;
	} else {
		v1 = p5;
	}
	Command(Cmd_ForEach, .a = 5, .r = v1, .d = [p0, p1, p2, p3, p4, p0, p1, p2, p3, p4, p0, p1, p2, p3, p4, p0, p1, p2, p3, p4, p0, p1, p2, p3, p4], .e = {
		if (p0 == 3) {
			Command(Cmd_GetSpanOfTime, S_SPAN_OF_TIME);
			switch (S_SPAN_OF_TIME) {
				case 0: {
					S_SPIRIT_BUG_WEIGHT0 = 5;
					S_SPIRIT_BUG_WEIGHT1 = 2;
				}
				case 1: {
					S_SPIRIT_BUG_WEIGHT0 = 9;
					S_SPIRIT_BUG_WEIGHT1 = 0;
				}
				case 2: {
					if ({ Command(Cmd_GetSolarGauge); } > 4) {
						S_SPIRIT_BUG_WEIGHT0 = 1;
						S_SPIRIT_BUG_WEIGHT1 = 6;
					} else {
						S_SPIRIT_BUG_WEIGHT0 = 5;
						S_SPIRIT_BUG_WEIGHT1 = 2;
					}
				}
				case 4: {
					S_SPIRIT_BUG_WEIGHT0 = 9;
					S_SPIRIT_BUG_WEIGHT1 = 0;
				}
				default: {
					S_SPIRIT_BUG_WEIGHT0 = 5;
					S_SPIRIT_BUG_WEIGHT1 = 2;
				}
			}
			Command(Cmd_Random, .p = 10);
			if (result < S_SPIRIT_BUG_WEIGHT0) {
				S_SPIRIT_BUG_KIND = 0;
			} else if (result < S_SPIRIT_BUG_WEIGHT0 + S_SPIRIT_BUG_WEIGHT1) {
				S_SPIRIT_BUG_KIND = 2;
			} else {
				S_SPIRIT_BUG_KIND = 1;
			}
		} else {
			S_SPIRIT_BUG_KIND = p0;
		}
		Scr_0x018D((u16)59409, S_SPIRIT_BUG_KIND, p1, (p2 + { Command(Cmd_Random, .p = p4); }), (p3 + { Command(Cmd_Random, .p = p4); }), 5, (s16)600, 60);
	});
}

