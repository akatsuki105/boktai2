// 0x08D6D10C, スミスの雑談, 進行度で変わる
Scr_SmithSmallTalk() {
	if (W_STORY_PROGRESS >= 26 && W_STORY_PROGRESS < 32) {
		if (S_SMITH_SMALL_TALK_COUNT % 2 == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_112E));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1133));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else if (W_STORY_PROGRESS >= 32 && W_STORY_PROGRESS < 35) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_114D));
		Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
	} else if (W_STORY_PROGRESS >= 35 && W_STORY_PROGRESS < 46) {
		if (S_SMITH_SMALL_TALK_COUNT % 2 == 0) {
			if (W_STORY_PROGRESS < 40) {
				Command(Cmd_SetWorldMapFlag, .i = 2);
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1155));
				Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
			} else {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_115B));
				Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
			}
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1162));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else if (W_STORY_PROGRESS >= 46 && W_STORY_PROGRESS < 58) {
		if (S_SMITH_SMALL_TALK_COUNT % 2 == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1170));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1178));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else if (W_STORY_PROGRESS >= 58 && W_STORY_PROGRESS < 62) {
		if (S_SMITH_SMALL_TALK_COUNT % 2 == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1185));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_1189));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else if (W_STORY_PROGRESS >= 62) {
		if (S_SMITH_SMALL_TALK_COUNT % 2 == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_11A5));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_11A9));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	} else {
		Scr_0x0AE0();
	}
	S_SMITH_SMALL_TALK_COUNT = S_SMITH_SMALL_TALK_COUNT + 1;
}

