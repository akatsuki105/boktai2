// 0x08D8A19E
Scr_0x0DD7() {
	if (p0 < 0) {
		if (S_PIN_DIGIT_IDX > 0) {
			S_PIN_DIGIT_IDX = S_PIN_DIGIT_IDX - 1;
			Scr_TimeHousePinSetInput();
		} else {
			S_PIN_DIGIT_IDX = 0;
			Scr_EndInteractMsg();
		}
	} else {
		switch (S_PIN_DIGIT_IDX) {
			case 0: {
				*((u8 *)(scratch + 0x1F3)) = p0;
			}
			case 1: {
				*((u8 *)(scratch + 0x1F4)) = p0;
			}
			case 2: {
				*((u8 *)(scratch + 0x1F5)) = p0;
			}
			case 3: {
				*((u8 *)(scratch + 0x1F6)) = p0;
			}
		}
		S_PIN_DIGIT_IDX = S_PIN_DIGIT_IDX + 1;
		if (S_PIN_DIGIT_IDX < 4) {
			Scr_TimeHousePinSetInput();
		} else {
			Scr_TimeHousePinSetDone();
		}
	}
}

