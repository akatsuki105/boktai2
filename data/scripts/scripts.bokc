// 0x08D70C8D, レディの世間話
Scr_LadySmallTalk() {
	if (W_STORY_PROGRESS < 62) {
		if (S_LADY_SMALL_TALK_COUNT % 2 == 0) {
			Scr_LadyRumor();
			S_LADY_RUMOR_COUNT = S_LADY_RUMOR_COUNT + 1;
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10B9));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
	} else {
		if (S_LADY_SMALL_TALK_COUNT % 2 == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10BD));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		} else {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Lady_10C2));
			Scr_OpenMsgWindow(3, (u24)Scr_0x0B42, 0);
		}
	}
	S_LADY_SMALL_TALK_COUNT = S_LADY_SMALL_TALK_COUNT + 1;
}

