// 0x08D6CD2F, 鍛冶の出来ばえのコメント
Scr_SmithForgeResult() {
	Scr_BeginEventLockPlayer();
	Chara(Cmd_Delay, (u16)0xEA44, .t = 16, .e = {
		Command(Cmd_AddForgeExp, .t = W_FORGE_TYPE, .p = W_FORGE_SKILL);
		if (BIT(world + 0x5F, 3) == 0 && W_FORGE_SPECIAL != 0 && W_FORGE_GREAT_COUNT >= 16 && BIT(world + 0x5E, 3) == 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_111E));
			Command(Cmd_SetMessageWindowVar, 1, W_FORGE_GREAT_COUNT);
			Command(Cmd_SetMessageWindowVar, 2, W_FORGE_GOOD);
			Command(Cmd_SetMessageWindowVar, 3, W_FORGE_BAD);
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE1, 0);
		} else if (W_FORGE_RANK == 4 && W_FORGE_NAME != 5 && W_FORGE_NAME != 24 && W_FORGE_NAME != 43) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_Smith_111A));
			Command(Cmd_SetMessageWindowVar, 1, W_FORGE_GREAT_COUNT);
			Command(Cmd_SetMessageWindowVar, 2, W_FORGE_GOOD);
			Command(Cmd_SetMessageWindowVar, 3, W_FORGE_BAD);
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else if (W_FORGE_SPECIAL != 0) {
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithForgeGreat));
			Command(Cmd_SetMessageWindowVar, 1, W_FORGE_GREAT_COUNT);
			Command(Cmd_SetMessageWindowVar, 2, W_FORGE_GOOD);
			Command(Cmd_SetMessageWindowVar, 3, W_FORGE_BAD);
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		} else {
			if (W_FORGE_QUALITY == 0) {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithForgeAverage));
			} else if (W_FORGE_QUALITY > 0) {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithForgeGood));
			} else {
				Command(Cmd_OpenMessageWindow, .r = StringRef(Str_SmithForgePoor));
			}
			Command(Cmd_SetMessageWindowVar, 1, W_FORGE_GREAT_COUNT);
			Command(Cmd_SetMessageWindowVar, 2, W_FORGE_GOOD);
			Command(Cmd_SetMessageWindowVar, 3, W_FORGE_BAD);
			Scr_OpenMsgWindow(3, (u24)Scr_0x0AE0, 0);
		}
	});
}

