Scr_0x00CE() {
	Scr_0x00CF((u16)0x7E0E, p0);
}

// 0x08D1BAD8
Scr_0x00CF() {
	Scr_0x00D0();
	Scr_GetZoneBounds(p1);
	Command(Cmd_AddTileOverride, .n = p0, .t = 0, .f = 0, .e = (u8)64, .p = [(S_ZONE_MIN_X), (S_ZONE_MIN_Y), (S_ZONE_MIN_Z)]);
	Scr_AddScriptSprite((S_UNK_050), (u16)0xC459, 0, 0, 3, (S_ZONE_MIN_X + (u8)128), (S_ZONE_MIN_Y), (S_ZONE_MIN_Z + (u8)128));
	if (!(({ Command(Cmd_GetSolarGauge); } > 0 && { Command(Cmd_GetSolarGauge); } < 9))) {
		Command(Cmd_HideGenericObj, .n = S_UNK_050);
	}
	SetZoneCallback(p1, (u16)0x14C9, .m = (u16)0x1516, .w = (S_UNK_050), .e = {
		Scr_GetZoneBounds(p1);
		if (p2 == (u16)0x0DD2) {
			if ({ Command(Cmd_GetSolarGauge); } > 0 && { Command(Cmd_GetSolarGauge); } < 9) {
				Command(Cmd_PlayTrackedSound, .i = (s16)547);
				Command(Cmd_MoveGenericObj, .n = p6, .p = [(S_ZONE_MIN_X + (u8)128), (S_ZONE_MIN_Y - 32), (S_ZONE_MIN_Z + (u8)128)], .f = 10);
			}
		} else if (p2 == (u16)0xD5CC) {
			Command(Cmd_MoveGenericObj, .n = p6, .p = [(S_ZONE_MIN_X + (u8)128), (S_ZONE_MIN_Y), (S_ZONE_MIN_Z + (u8)128)], .f = 10);
		} else if (p2 == (u16)0xA5BF) {
			if ({ Command(Cmd_GetSolarGauge); } > 0 && { Command(Cmd_GetSolarGauge); } < 9) {} else {
				Command(Cmd_MoveGenericObj, .n = p6, .p = [(S_ZONE_MIN_X + (u8)128), (S_ZONE_MIN_Y), (S_ZONE_MIN_Z + (u8)128)], .f = 10);
			}
		}
	});
	S_UNK_04F = S_UNK_04F + 1;
}

