	}
	if ({ Scr_0x024E(34); } == 0 && S_ARMOR_CANDIDATE_COUNT < 6) {
		W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = 34;
		S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
	}
	if ({ Scr_0x024E(35); } == 0 && S_ARMOR_CANDIDATE_COUNT < 6) {
		W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = 35;
		S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
	}
	if ({ Scr_0x024E(36); } == 0 && S_ARMOR_CANDIDATE_COUNT < 6) {
		W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = 36;
		S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
	}
	if (W_STORY_PROGRESS < 30) {
		DebugPrint("キッド救出前アイテムセット");
		Command(Cmd_ForEach, .a = 0, .r = 6, .d = 0, .e = {
			if (S_ARMOR_CANDIDATE_COUNT < 6) {
				W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = { Command(Cmd_Random, .p = (s16)512); } >> 8;
				S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
			}
		});
	} else if (W_STORY_PROGRESS < 46) {
		DebugPrint("キッド救出後ｓｔ０３クリア前アイテムセット");
		Command(Cmd_ForEach, .a = 0, .r = 6, .d = 0, .e = {
			if (S_ARMOR_CANDIDATE_COUNT < 6) {
				W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = { Command(Cmd_Random, .p = (s16)768); } >> 8;
				S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
			}
		});
	} else if (W_STORY_PROGRESS < 58) {
		DebugPrint("ｓｔ０３クリア後ｓｔ０４クリア前アイテムセット");
		Command(Cmd_ForEach, .a = 0, .r = 6, .d = 0, .e = {
			if (S_ARMOR_CANDIDATE_COUNT < 6) {
				W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = { Command(Cmd_Random, .p = (s16)1280); } >> 8;
				S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
			}
		});
	} else if (W_STORY_PROGRESS < 62) {
		DebugPrint("ｓｔ０４クリア後ｓｔ０５クリア前アイテムセット");
		Command(Cmd_ForEach, .a = 0, .r = 6, .d = 0, .e = {
			if (S_ARMOR_CANDIDATE_COUNT < 6) {
				W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = { Command(Cmd_Random, .p = (s16)1792); } >> 8;
				S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
			}
		});
	} else if (LAP == 0) {
		DebugPrint("ｓｔ０５クリア後ｓｔ０６クリア前アイテムセット");
		Command(Cmd_ForEach, .a = 0, .r = 6, .d = 0, .e = {
			if (S_ARMOR_CANDIDATE_COUNT < 6) {
				W_CROSSOVER_ARMOR_CANDIDATES((S_ARMOR_CANDIDATE_COUNT)) = { Command(Cmd_Random, .p = (s16)2048); } >> 8;
				S_ARMOR_CANDIDATE_COUNT = S_ARMOR_CANDIDATE_COUNT + 1;
			}
		});
	} else {
		DebugPrint("本編クリア後アイテムセット");
		Scr_0x024F();
		DebugPrint("取得済みの防具の数", S_ARMOR_DEX_COUNT);
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
		S_OWNED_ARMOR_PICK = { Command(Cmd_Random, .p = (S_ARMOR_DEX_COUNT << 8)); } >> 8;
		Scr_0x0A0D(({ Scr_0x0A0E(); }));
	}
	S_ARMOR_CANDIDATE_PICK = 0;
	S_ARMOR_CANDIDATE_PICK = { Command(Cmd_Random, .p = (s16)1536); } >> 8;
