// 0x08D89F9B, 暗証番号を設定する装置, 設定するかの選択肢
Scr_TimeHousePinSetTerminal() {
	if (W_CURRENT_STAGE_EVENT_FLAGS(0) == 0) {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_071D));
		S_UNK_014_4 = 0;
		Scr_BeginEventLockPlayer();
		Scr_OpenMsgWindow(3, (u24)Scr_EndInteractMsg, 0);
	} else {
		Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_0720));
		S_UNK_014_4 = 0;
		Scr_BeginEventLockPlayer();
		Scr_OpenChoiceCancelable((u16)0x7A85, (u24)Scr_TimeHousePinSetAnswer, 0, 0);
		Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0720));
	}
}

// 0x08D8A00B, 設定するかの選択の結果, p0: 選択
Scr_TimeHousePinSetAnswer() {
	if (p0 < 0) {
		Scr_EndInteractMsg();
	} else {
		if (p0 == 0) {
			Command(Cmd_CloseMessageWindow);
			Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_0722));
			Scr_OpenMsgWindow(3, (u24)Scr_TimeHousePinSetInput, 0);
		} else {
			Scr_EndInteractMsg();
		}
	}
}

// 0x08D8A059, 設定する暗証番号を1桁ずつ選ぶ選択肢
Scr_TimeHousePinSetInput() {
	Command(Cmd_CloseMessageWindow);
	if (S_PIN_DIGIT_IDX == 0) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_OpenChoiceCancelable((u16)0x3071, (u24)Scr_0x0DD7, 0, 0);
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_070F));
		});
	} else if (S_PIN_DIGIT_IDX == 1) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)0x3072, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0710));
		});
	} else if (S_PIN_DIGIT_IDX == 2) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)0x3073, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F4)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0711));
		});
	} else if (S_PIN_DIGIT_IDX == 3) {
		Chara(Cmd_Delay, (u16)0x22FF, .t = 2, .e = {
			Scr_0x00FB((u16)0x3074, (u24)Scr_0x0DD7, 0, 0, *((u8 *)(scratch + 0x1F5)));
			Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
			Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
			Scr_SetPinDigitExtend(2, *((u8 *)(scratch + 0x1F5)));
			Command(Cmd_SetMessageChoiceText, .r = StringRef(Str_TimeHouse_0712));
		});
	}
}

// 0x08D8A19E
Scr_0x0DD7() {
	if (p0 < 0) {
		if (S_PIN_DIGIT_IDX > 0) {
			S_PIN_DIGIT_IDX = S_PIN_DIGIT_IDX - 1;
			Scr_TimeHousePinSetInput();
		} else {
			S_PIN_DIGIT_IDX = 0;
			Scr_EndInteractMsg();
		}
	} else {
		switch (S_PIN_DIGIT_IDX) {
			case 0: {
				*((u8 *)(scratch + 0x1F3)) = p0;
			}
			case 1: {
				*((u8 *)(scratch + 0x1F4)) = p0;
			}
			case 2: {
				*((u8 *)(scratch + 0x1F5)) = p0;
			}
			case 3: {
				*((u8 *)(scratch + 0x1F6)) = p0;
			}
		}
		S_PIN_DIGIT_IDX = S_PIN_DIGIT_IDX + 1;
		if (S_PIN_DIGIT_IDX < 4) {
			Scr_TimeHousePinSetInput();
		} else {
			Scr_TimeHousePinSetDone();
		}
	}
}

// 0x08D8A252, 「暗証番号を設定しました。」
Scr_TimeHousePinSetDone() {
	Command(Cmd_CloseMessageWindow);
	Scr_SetPinDigitExtend(0, *((u8 *)(scratch + 0x1F3)));
	Scr_SetPinDigitExtend(1, *((u8 *)(scratch + 0x1F4)));
	Scr_SetPinDigitExtend(2, *((u8 *)(scratch + 0x1F5)));
	Scr_SetPinDigitExtend(3, *((u8 *)(scratch + 0x1F6)));
	Command(Cmd_OpenMessageWindow, .r = StringRef(Str_TimeHouse_0724));
	S_UNK_014_4 = 0;
	Scr_OpenMsgWindow(3, (u24)Scr_0x0DD9, 0);
}

