// 0x08D6E09C, p0 を 0..p1 に丸めて返す
Scr_ClampValue() {
	S_CLAMP_RESULT = p0;
	if (S_CLAMP_RESULT < 0) {
		S_CLAMP_RESULT = 0;
		DebugPrint("0マージあたい", S_CLAMP_RESULT);
	}
	if (S_CLAMP_RESULT > p1) {
		S_CLAMP_RESULT = p1;
		DebugPrint("1マージあたい", S_CLAMP_RESULT);
	}
	return S_CLAMP_RESULT;
}

