// 0x08D4538F, 暗黒街 (ステージ3) の BGM をストーリー進行度で選んで設定する, p0: 1/2 なら固定の曲
Scr_SetDarkCityBgm() {
	if (p0 == 1) {
		S_DARK_CITY_BGM = 32;
	} else if (p0 == 2) {
		S_DARK_CITY_BGM = 33;
	} else {
		if (W_STORY_PROGRESS < 40) {
			S_DARK_CITY_BGM = 29;
		} else if (W_STORY_PROGRESS >= 42) {
			S_DARK_CITY_BGM = 31;
		} else {
			S_DARK_CITY_BGM = 30;
		}
	}
	Scr_SetMapStageBgm(3, S_DARK_CITY_BGM, 0, 0, -1);
}

