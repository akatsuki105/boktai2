        keyword 'r'
        ; 太陽鍛海(たいようかじ)とは、
        ; 太陽の力を利図した鍛海(照し た金居を行ちきたえて指を体る こと)である。
        ; <PROC=0> <END>
        string-ref 0x5a0
      end
