    else-if
    expr
      param 0x1
      i32 0x1
      eq
    end-expr
    block
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; 太陽鍛海(たいようかじ)では、
        ; 松識となる2つの武同から、新 しい武同を1つ体り用すことが できる。
        ; 烈識で何応でも倫なうことがで きるが、松識となる武同は面分 で図意しなければならない。
        ; <PROC=0> <END>
