Script_0ADD: @ 0x08D6D062, ScriptID: 2781
block
  expr
    ptr bool, scratch, 0x14, bit=0x4  ; 0x203e214
    i32 0x0
    store
  end-expr
  if
    expr
      param 0x1
      i32 0x0
      lt
    end-expr
    block
      call 0xade
      end
    end
    else-if
    expr
      param 0x1
      i32 0x0
      eq
    end-expr
    block
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; 太陽鍛海(たいようかじ)におい ては、
        ; 通堂、回じ料み合わせの松識か らは回じ武同が体られる。
        ; ただし回じ舌罠の武同であって も、鍛海の用集しだいでその能 力は大きく異なる。
        ; <PROC=0> <END>
        string-ref 0x5af
      end
      call 0xf8
        i32 0x3
        u16_0x08 0xade
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x1
      eq
    end-expr
    block
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; 鍛海(かじ)による武同の用集の 良さ、すなわちクオリティは、
        ; 武同の舌罠の修に仲く波否で される。
        ; たとえば+2は、通堂のものより 答力(いりょく)が2衣いことを し、-2は2伐いことをす。
        ; また武同の中には、鍛海によっ て揮殊効果(とくしゅこうか)の 仲くものもあり、
        ; 揮殊効果の仲いた武同には、舌 罠の修にSP(スペシャル)が仲く
        ; <PROC=0> <END>
        string-ref 0x5b3
      end
      call 0xf8
        i32 0x3
        u16_0x08 0xade
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x2
      eq
    end-expr
    block
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; 揮殊効果(とくしゅこうか)は通 堂、1つの武同に1つしか仲かな いが、
        ; 揮殊効果の仲いた武同を松識に 鍛海(かじ)を倫なうと、
        ; 揮殊効果が用集上がった武同に 受け紋(つ)がれることがある。
        ; これをSPの紋承(けいしょう)と いい、
        ; これによって、裕数の揮殊効果 を術った武同が体られることが ある。
        ; またSPと回様に、+-といった武 同の答力(いりょく)が紋承され ることもある。
        ; <PROC=0> <END>
        string-ref 0x5b9
      end
      call 0xf8
        i32 0x3
        u16_0x08 0xade
        i32 0x0
      end
    end
    else-if
    expr
      param 0x1
      i32 0x3
      eq
    end-expr
    block
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; 武同にはそれぞれにレベルが計 守されている。
        ; 面分のレベルよりレベルの衣い 武同は、に入れることはでき ても位することはできない。
        ; <PROC=0> <END>
        string-ref 0x5c0
      end
      call 0xf8
        i32 0x3
        u16_0x08 0xade
        i32 0x0
      end
    end
  end
end

