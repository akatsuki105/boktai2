Script_04DC: @ 0x08D3E292, ScriptID: 1244
block
  call 0x7b
  end
  if
    expr
      ptr u8, scratch, 0x146  ; 0x203e346
      i32 0x0
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x146  ; 0x203e346
        i32 0x1
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; <LABEL=SABATA>サバタ</LABEL> 「なぜ伊(おれ)がここにいるの か、不思証に思うか?
        ; 伊はおまえとは達(ちが)う。 この倒がどうなろうと噴ったこ とではない。
        ; この伊を映黒の戦平として裹て たクイーン・オブ・イモータル ・・・ヘル。
        ; もう、あのいつわりの母親を猿 (にく)んでいるわけでもない。 だが、
        ; 儀女(かのじょ)を、そして伊面 身をも操気(きょうき)へと光ら せた銀線意思ダーク、
        ; そしてその意思にう聞(やみ) の一施イモータル。ヤツらの思 い通りにさせるつもりはない。
        ; ただそれだけだ・・・」
        ; <PROC=0> <END>
        string-ref 0x312
      end
    end
    else-if
    expr
      ptr u8, scratch, 0x146  ; 0x203e346
      i32 0x1
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x146  ; 0x203e346
        i32 0x2
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; <LABEL=SABATA>サバタ</LABEL> 「ヤツは強い・・・
        ; 伊(おれ)の導(こうげき)もほ とんどがかわされ、
        ; レンズを1つ(うば)い取るの がやっとだった。
        ; ヤツから太陽鈴(たいようじゅ う)を取り層(もど)すなど雑 の準。
        ; あるいは硝城(はかい)してしま うべきかもしれん・・・」
        ; <PROC=0> <END>
        string-ref 0x31a
      end
    end
    else-if
    expr
      ptr u8, scratch, 0x146  ; 0x203e346
      i32 0x2
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x146  ; 0x203e346
        i32 0x3
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; <LABEL=SABATA>サバタ</LABEL> 「道真屋のキッド? あの燭軍顔か・・・
        ; そうだ。アイツの座(じゃま) がなければ、こんな烈様なこと にはならなかったのだ!!
        ; 何? 伊(おれ)がアイツを助けた? 伊がなぜそんなことをする!」
        ; <PROC=0> <END>
        string-ref 0x320
      end
    end
    else-if
    expr
      ptr u8, scratch, 0x146  ; 0x203e346
      i32 0x3
      eq
    end-expr
    block
      expr
        ptr u8, scratch, 0x146  ; 0x203e346
        i32 0x0
        store
      end-expr
      control 0xb745
        u16 0x1c64
        keyword 'r'
        ; <LABEL=SABATA>サバタ</LABEL> 「この遺路(いせき)に残された 伯承を噴っているか?
        ; そこには死凶の健江がうたわれ ている。
        ; アンデッドのように罠の姿や 波猟(きおく)を夫うのではなく
        ; 死ぬ罠の面分を価ったままの健 江・・・
        ; それはイモータルのことを街し ているのか、それとも人の身に 超こりうることなのか?
        ; だがそんな足のいい激があるわ けがない。過を変えることな ど、できはしないのだ・・・」
        ; <PROC=0> <END>
