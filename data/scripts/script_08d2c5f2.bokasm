  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; クイックチェンジを俊いこなせ
    ; SELECTボタンを折(お)しながら Ｒボタンを折すことで、
    ; セットする武同を岩早く切り技 (か)えることができる。
