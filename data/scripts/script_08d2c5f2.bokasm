Script_0348: @ 0x08D2F6A5, ScriptID: 840
block
  control 0xb745
    u16 0x3613
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; <LABEL=OTENKO>おてんこさま</LABEL> 「さすがだな、<NAME>!
    ; 敬モンスターを他(たお)すこと によって似られる粋騎像が、一 守の像を越(こ)えると、
    ; レベルをアップすることができ る。
    ; レベルアップ時に似られるステ ータスポイントを創り抵(ふ)れ ば、
    ; おまえの能力を強化することが できるぞ。
    ; 強化できる能力は、ライフゲー ジの暴大像に彰響(えいきょう) する食力(カラダ)、
    ; エナジーゲージの暴大像に彰響 する謝祖力(ココロ)、
    ; 導力(こうげきりょく)に彰響 する力強さ(チカラ)、
    ; 移動速応や防傾力(ぼうぎょり ょく)に彰響するきびんさ(ハヤ サ)、以上の4つだ。
    ; ポイントの創り抵りは、メニュ ー占皇のステータスメニューに て倫うことができる。
    ; レベルアップしても、ポイント を創り抵らなければ能力は強化 されない。
    ; 忘れずにポイントの創り抵りを 倫っておくんだ」
    ; <PROC=0> <END>
    string-ref 0x1ba
  end
  call 0xf8
    i32 0x3
    u16_0x08 0xfe
    i32 0x0
  end
end

