Script_0322: @ 0x08D2E336, ScriptID: 802
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 面らのライフ(食)、 その限界を噴れ。
    ; 占皇左上のライフ(LIFE)ゲージ は、食の冶断(しょうもう)応合 いを襲す。
    ; 敬からの導(こうげき)などに よりダメージを受けると、ライ フは温少し、
    ; ライフがゼロになればゲームオ ーバーとなる。
    ; アイテムを俊い、早めに載健す ることを製がけよ。
    ; <PROC=0> <END>
    string-ref 0x210
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_0323: @ 0x08D2E353, ScriptID: 803
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 面らのエナジー(太陽エネルギ ー)、その限界を噴れ。
    ; 占皇左上のエナジー(ENE)ゲー ジは、太陽エネルギーの冶断( しょうもう)応合いを襲す。
    ; 太陽鈴(たいようじゅう)は、エ ナジーを冶費して太陽ショット を教つ座次械構。
    ; エナジーがゼロになれば導(う) つことはできない。
    ; エナジーの載健には太陽チャー ジが志需となる。
    ; 屋却エリアでは、太陽センサー に太陽の児を角てることにより
    ; エナジーは面無にチャージされ る。
    ; またＡボタンを折(お)しっぱな しにすれば、急速チャージを倫 うこともできる。
    ; <PROC=0> <END>
    string-ref 0x216
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_0324: @ 0x08D2E370, ScriptID: 804
