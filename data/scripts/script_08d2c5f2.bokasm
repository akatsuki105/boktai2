block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 袋の武同を噴れ。
    ; に入れた武同は、メニュー占 皇にて前宮の砲許と位の変鬼 (へんこう)をする事ができる。
    ; アクション占皇では、在セッ トしている武同が占皇右下に 襲される。
    ; <PROC=0> <END>
    string-ref 0x241
  end
  call 0xf8
    i32 0x3
