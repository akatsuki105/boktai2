    i32 0x0
  end
end

Script_0340: @ 0x08D2F4FF, ScriptID: 832
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 史想を徒し用し、 有効に江図せよ。
    ; 太陽の児の届かない屋前エリア では、
    ; 太陽センサーが太陽の児をキャ ッチしていても、太陽チャージ をすることはできない。
    ; しかし史想エリアでは、太陽の 児があれば屋却エリア回様、太 陽チャージを倫うことができる
    ; また、太陽の児を芳とするア ンデッド(不死)タイプのモンス ターには、
    ; 史想の児でダメージをあたえる ことも向能だ。
    ; <PROC=0> <END>
    string-ref 0x235
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_0341: @ 0x08D2F51C, ScriptID: 833
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 吹(たた)け!!
    ; 聴賞(ちょうかく)を術つ敬は、 指交を闘くと交の鳴った境外を 記べに集る。
    ; 塗吹(かべたた)きを利図すれば 敬モンスターを話(さそ)い用す ことが向能だ。
    ; 塗を吹くには、塗弾りつき中に Ａボタンを折(お)せばいい。
    ; <PROC=0> <END>
    string-ref 0x23c
  end
  call 0xf8
    i32 0x3
    u16_0x08 0x192
    i32 0x0
  end
end

Script_0342: @ 0x08D2F539, ScriptID: 834
block
  call 0x7b
  end
  control 0xb745
    u16 0x1c64
