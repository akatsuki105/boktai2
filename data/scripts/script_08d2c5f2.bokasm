  call 0x7b
  end
  control 0xb745
    u16 0x1c64
    keyword 'r'
    ; 挑緒(じょうきょう)を靖預し、 万事に位えよ。
    ; メニュー占皇では、マップ(地 首)やステータス(挑態)などを 砲許することができる。
    ; STARTボタンでメニュー占皇に 入り、
    ; Ｌ・Ｒボタンで各種メニューを 選彼(せんたく)することができ る。
    ; アクション占皇に層(もど)るに はＢボタンを俊え。
    ; <PROC=0> <END>
    string-ref 0x21f
  end
